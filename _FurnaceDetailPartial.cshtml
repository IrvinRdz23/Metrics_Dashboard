@model Metrics_Dashboard.Models.FurnaceDetailSnapshot
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Plant Metrics · @Model.FurnaceName</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
    :root[data-theme="dark"] {
        --bg: #0b0f16;
        --card: #131a28;
        --card-hover: #182035;
        --border: #223049;
        --border-soft: rgba(255,255,255,0.06);
        --text: #e9eef7;
        --text-dim: #8394b3;
        --text-faint: #56668a;
        --accent: #4da3ff;
        --accent-soft: rgba(77,163,255,0.14);
        --good: #35d68f;
        --warn: #f2b84b;
        --bad: #ff5d6c;
        --neutral: #7d8aa8;
        --no-plan-bg: rgba(168,132,255,0.12);
        --no-plan-border: #a884ff;
        --no-plan-text: #c6b3ff;
        --grid-line: rgba(255,255,255,0.055);
        --shadow: 0 8px 22px -12px rgba(0,0,0,0.55);
        --flash: rgba(77,163,255,0.35);
    }
    :root[data-theme="light"] {
        --bg: #eef1f7;
        --card: #ffffff;
        --card-hover: #f2f5fa;
        --border: #dde3ee;
        --border-soft: rgba(0,0,0,0.05);
        --text: #101828;
        --text-dim: #5b6675;
        --text-faint: #8a94a6;
        --accent: #1f6feb;
        --accent-soft: rgba(31,111,235,0.10);
        --good: #12a463;
        --warn: #b57a09;
        --bad: #d43a4a;
        --neutral: #8a94a6;
        --no-plan-bg: rgba(124,58,237,0.08);
        --no-plan-border: #7c3aed;
        --no-plan-text: #6d28d9;
        --grid-line: rgba(0,0,0,0.06);
        --shadow: 0 8px 22px -14px rgba(20,30,50,0.16);
        --flash: rgba(31,111,235,0.18);
    }

    * { box-sizing: border-box; }
    html, body {
        margin: 0; padding: 0; height: 100%; overflow: hidden;
        background: var(--bg); color: var(--text);
        font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }

    .app {
        height: 100vh; width: 100vw; display: grid; grid-template-rows: auto 1fr; gap: 12px; padding: 14px;
        background: var(--bg);
    }

    /* ---------- HEADER ---------- */
    header {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 20px;
        border-top: 3px solid var(--furnace-color);
    }
    .app.presentation .controls-collapsible { display: none; }

    .brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .brand .logo-dot {
        width: 34px; height: 34px; border-radius: 10px; background: var(--furnace-color);
        display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .85rem; color: #06101f; flex-shrink: 0;
        box-shadow: 0 4px 12px -3px var(--furnace-color);
    }
    .brand-text h1 { font-size: 1.08rem; margin: 0; font-weight: 800; letter-spacing: .2px; }
    .brand-text .subtitle { color: var(--text-dim); font-size: .74rem; display: flex; align-items: center; gap: 8px; margin-top: 2px; }
    .shift-badge { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border); padding: 2px 9px; border-radius: 999px; font-size: .68rem; font-weight: 600; letter-spacing: .3px; }

    .plant-kpi { display: flex; align-items: center; gap: 22px; }
    .kpi-block { text-align: center; min-width: 54px; }
    .kpi-block .value { font-size: 1.45rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; font-family: 'JetBrains Mono', monospace; }
    .kpi-block .label { font-size: .59rem; text-transform: uppercase; letter-spacing: .6px; color: var(--text-faint); margin-top: 4px; font-weight: 700; }
    .kpi-divider { width: 1px; height: 28px; background: var(--border); }

    .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .btn {
        background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 8px;
        padding: 8px 12px; font-size: .78rem; font-weight: 600; cursor: pointer; text-decoration: none;
        display: flex; align-items: center; gap: 6px; transition: background .15s, border-color .15s;
    }
    .btn:hover { background: var(--card-hover); border-color: var(--furnace-color); }

    /* ---------- BODY ---------- */
    .body-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 12px; min-height: 0; }

    .card {
        background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px;
        box-shadow: var(--shadow); display: flex; flex-direction: column; min-height: 0;
        border-top: 3px solid var(--furnace-color);
    }
    .card h2 {
        font-size: .86rem; margin: 0 0 10px 0; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
        color: var(--text-dim); display: flex; align-items: center; justify-content: space-between;
    }
    .card h2 .count-chip { font-size: .64rem; font-weight: 700; color: var(--text-faint); background: var(--bg); border: 1px solid var(--border); padding: 2px 9px; border-radius: 999px; text-transform: none; letter-spacing: 0; }

    /* ---------- LISTA DE LÍNEAS ACTIVAS ---------- */
    .lines-list { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 7px; padding-right: 2px; }
    .line-row {
        display: grid; grid-template-columns: minmax(120px, 240px) 1fr 84px; align-items: center; gap: 14px;
        background: var(--bg); border: 1px solid var(--border-soft); border-radius: 10px; padding: 9px 12px;
        flex: 1 1 0; min-height: 34px; transition: background .8s ease;
    }
    .line-row.flash { background: var(--flash); }
    .line-row .line-name { font-size: .8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .line-row .line-plan { font-size: .68rem; color: var(--text-faint); text-align: right; font-family: 'JetBrains Mono', monospace; }
    .line-bar-area { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .line-bar-track { flex: 1; height: 20px; border-radius: 6px; background: var(--grid-line); overflow: hidden; position: relative; min-width: 0; }
    .line-bar-fill { height: 100%; border-radius: 6px; display: flex; align-items: center; padding-left: 6px; transition: width .5s ease; }
    .line-bar-fill span { font-size: .68rem; font-weight: 800; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.5); font-family: 'JetBrains Mono', monospace; white-space: nowrap; }
    .line-bar-detail { font-size: .68rem; color: var(--text-faint); font-family: 'JetBrains Mono', monospace; white-space: nowrap; min-width: 68px; }

    /* ---------- SECCIÓN DE LÍNEAS SIN PRODUCCIÓN (compacta, debajo de la lista) ---------- */
    .no-prod-section { flex: 0 0 auto; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--border); }
    .no-prod-title {
        font-size: .66rem; font-weight: 800; color: var(--no-plan-text); text-transform: uppercase;
        letter-spacing: .5px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
    }
    .no-prod-title .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--no-plan-border); }
    .no-prod-chips { display: flex; flex-wrap: wrap; gap: 6px; max-height: 78px; overflow-y: auto; }
    .no-prod-chip {
        background: var(--no-plan-bg); border: 1px solid var(--no-plan-border); color: var(--no-plan-text);
        padding: 4px 10px; border-radius: 999px; font-size: .68rem; font-weight: 600; white-space: nowrap;
    }

    /* ---------- PANEL DERECHO ---------- */
    .side-stack { display: flex; flex-direction: column; gap: 12px; min-height: 0; }
    .gauge-card { flex: 0 0 auto; }
    .gauge-wrap { position: relative; width: 100%; max-width: 190px; margin: 4px auto 0; aspect-ratio: 1.6 / 1; }
    .gauge-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 6px; }
    .gauge-center .val { font-size: 1.75rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1; }
    .gauge-center .lab { font-size: .62rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: .5px; font-weight: 700; margin-top: 2px; }

    .trend-mini { flex: 1; min-height: 0; }
    .trend-mini .chart-wrap { flex: 1; min-height: 0; }

    .chips-card { flex: 0 0 auto; }
    .chip-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-soft); font-size: .8rem; }
    .chip-row:last-child { border-bottom: none; }
    .chip-row .k { color: var(--text-dim); }
    .chip-row .v { font-weight: 800; font-family: 'JetBrains Mono', monospace; }

    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 0 rgba(53,214,143,.6); animation: pulse 1.8s infinite; }
    @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(53,214,143,.55); } 70% { box-shadow: 0 0 0 8px rgba(53,214,143,0); } 100% { box-shadow: 0 0 0 0 rgba(53,214,143,0); } }
</style>
</head>
<body>
<div class="app" id="app" style="--furnace-color: @FurnaceColor(Model.FurnaceId)">

    <header>
        <div class="brand">
            <div class="logo-dot">@(Model.FurnaceId == 6 ? "TM" : Model.FurnaceId.ToString())</div>
            <div class="brand-text">
                <h1>@Model.FurnaceName</h1>
                <div class="subtitle">
                    <span id="dateLabel"></span>
                    <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                </div>
            </div>
        </div>

        <div class="plant-kpi">
            <div class="kpi-block">
                <div class="value" id="oeeVal">@Model.Oee.ToString("P0")</div>
                <div class="label">OEE Turno</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="prodVal">@Model.TotalProduction.ToString("N0")</div>
                <div class="label">Producción</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="planVal">@Model.TotalPlanned.ToString("N0")</div>
                <div class="label">Plan Turno</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="remVal">@Model.RemainingToPlan.ToString("N0")</div>
                <div class="label">Faltan por Plan</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div style="display:flex;align-items:center;gap:6px;justify-content:center;">
                    <span class="live-dot"></span>
                    <span class="value" style="font-size:.82rem" id="lastUpdate">--:--</span>
                </div>
                <div class="label">Última Actualización</div>
            </div>
        </div>

        <div class="header-actions controls-collapsible">
            <a class="btn" href="/Dashboard" title="Volver al dashboard general">📊 General</a>
            <button class="btn" id="toggleTheme">🌗 Tema</button>
            <button class="btn" id="togglePresentation">🖥️ Presentación</button>
        </div>
    </header>

    <div class="body-grid">
        <div class="card">
            <h2>Líneas de Producción <span class="count-chip" id="linesCountChip"></span></h2>
            <div class="lines-list" id="linesList"></div>
            <div class="no-prod-section" id="noProdSection" style="display:none;">
                <div class="no-prod-title"><span class="dot"></span>Líneas sin producción en este turno <span id="noProdCount"></span></div>
                <div class="no-prod-chips" id="noProdChips"></div>
            </div>
        </div>

        <div class="side-stack">
            <div class="card gauge-card">
                <h2>OEE de Turno</h2>
                <div class="gauge-wrap">
                    <canvas id="gaugeChart"></canvas>
                    <div class="gauge-center">
                        <div class="val" id="gaugeVal">@Model.Oee.ToString("P0")</div>
                        <div class="lab">OEE horno</div>
                    </div>
                </div>
            </div>

            <div class="card trend-mini">
                <h2>Tendencia por Hora</h2>
                <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
            </div>

            <div class="card chips-card">
                <h2>Resumen</h2>
                <div class="chip-row"><span class="k">Líneas activas</span><span class="v" id="activeLinesVal">-</span></div>
                <div class="chip-row"><span class="k">Sin producción</span><span class="v" id="noProdVal">-</span></div>
                <div class="chip-row"><span class="k">Mejor línea</span><span class="v" id="bestLineVal">-</span></div>
                <div class="chip-row"><span class="k">Línea más baja</span><span class="v" id="worstLineVal">-</span></div>
                <div class="chip-row"><span class="k">SAP %</span><span class="v" id="sapVal">-</span></div>
            </div>
        </div>
    </div>
</div>

<script>
    let snapshot = @Html.Raw(Json.Serialize(Model));
    const FURNACE_ID = @Model.FurnaceId;
    const charts = {};

    function oeeColor(oee) {
        if (oee >= 0.85) return getCss('--good');
        if (oee >= 0.70) return getCss('--warn');
        return getCss('--bad');
    }
    function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
    function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
        const r = (bigint >> 16) & 255, g = (bigint >> 8) & 255, b = bigint & 255;
        return `rgba(${r},${g},${b},${alpha})`;
    }
    function pct(v) { return (v * 100).toFixed(0) + '%'; }

    document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

    function render(isLiveUpdate) {
        document.getElementById('oeeVal').textContent = pct(snapshot.oee);
        document.getElementById('oeeVal').style.color = oeeColor(snapshot.oee);
        document.getElementById('prodVal').textContent = snapshot.totalProduction.toLocaleString();
        document.getElementById('planVal').textContent = snapshot.totalPlanned.toLocaleString();
        document.getElementById('remVal').textContent = snapshot.remainingToPlan.toLocaleString();
        document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
        document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('linesCountChip').textContent = snapshot.lines.length + ' líneas';
        document.getElementById('activeLinesVal').textContent = snapshot.linesWithProduction + ' / ' + snapshot.lines.length;
        document.getElementById('noProdVal').textContent = snapshot.linesWithoutProduction;

        const bestEl = document.getElementById('bestLineVal');
        const worstEl = document.getElementById('worstLineVal');
        bestEl.textContent = snapshot.bestLine ? pct(snapshot.bestLine.oeeShift) : '—';
        bestEl.style.color = snapshot.bestLine ? oeeColor(snapshot.bestLine.oeeShift) : '';
        worstEl.textContent = snapshot.worstLine ? pct(snapshot.worstLine.oeeShift) : '—';
        worstEl.style.color = snapshot.worstLine ? oeeColor(snapshot.worstLine.oeeShift) : '';

        document.getElementById('sapVal').textContent = pct(snapshot.sapPercent);

        renderLinesList(isLiveUpdate);
        renderGauge();
        renderTrend();
    }

    // Líneas ACTIVAS (con producción > 0) van a la lista principal con barra.
    // Líneas SIN producción (incluidas las que ni siquiera tienen plan) van a la
    // sección compacta de abajo, en morado — nunca cuentan para las estadísticas.
    function renderLinesList(isLiveUpdate) {
        const active = snapshot.lines.filter(l => l.total > 0).sort((a, b) => a.productOrder - b.productOrder);
        const inactive = snapshot.lines.filter(l => l.total === 0).sort((a, b) => a.productOrder - b.productOrder);

        const container = document.getElementById('linesList');
        const prevTotalByDesc = {};
        container.querySelectorAll('.line-row').forEach(el => prevTotalByDesc[el.dataset.desc] = el.dataset.total);

        container.innerHTML = active.map(l => {
            const changed = isLiveUpdate && prevTotalByDesc[l.productDesc] !== undefined && prevTotalByDesc[l.productDesc] !== String(l.total);
            return `
                <div class="line-row ${changed ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
                    <div class="line-name" title="${l.productDesc}">${l.productDesc}</div>
                    <div class="line-bar-area">
                        <div class="line-bar-track">
                            <div class="line-bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}">
                                <span>${pct(l.oeeShift)}</span>
                            </div>
                        </div>
                        <span class="line-bar-detail">${l.total.toLocaleString()}/${l.accumulatedRate.toLocaleString()}</span>
                    </div>
                    <div class="line-plan">Plan ${l.plannedShift.toLocaleString()}</div>
                </div>`;
        }).join('');

        if (isLiveUpdate) {
            setTimeout(() => container.querySelectorAll('.line-row.flash').forEach(el => el.classList.remove('flash')), 900);
        }

        const section = document.getElementById('noProdSection');
        if (inactive.length === 0) {
            section.style.display = 'none';
        } else {
            section.style.display = '';
            document.getElementById('noProdCount').textContent = `(${inactive.length})`;
            document.getElementById('noProdChips').innerHTML = inactive
                .map(l => `<span class="no-prod-chip" title="SIN PRODUCCIÓN EN EL TURNO">${l.productDesc}</span>`)
                .join('');
        }
    }

    const gaugeCenterPlugin = {
        id: 'gaugeCenterColor',
        afterUpdate(chart) {
            const el = document.getElementById('gaugeVal');
            if (el) el.style.color = oeeColor(snapshot.oee);
        }
    };

    function renderGauge() {
        const val = Math.min(100, snapshot.oee * 100);
        const rest = Math.max(0, 100 - val);
        const color = oeeColor(snapshot.oee);
        document.getElementById('gaugeVal').textContent = pct(snapshot.oee);
        document.getElementById('gaugeVal').style.color = color;

        if (charts.gauge) {
            charts.gauge.data.datasets[0].data = [val, rest];
            charts.gauge.data.datasets[0].backgroundColor = [color, getCss('--grid-line')];
            charts.gauge.update('none');
            return;
        }
        charts.gauge = new Chart(document.getElementById('gaugeChart'), {
            type: 'doughnut',
            data: { datasets: [{ data: [val, rest], backgroundColor: [color, getCss('--grid-line')], borderWidth: 0 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                circumference: 180, rotation: 270, cutout: '78%',
                plugins: { legend: { display: false }, tooltip: { enabled: false } }
            },
            plugins: [gaugeCenterPlugin]
        });
    }

    function cumulativeSeries() {
        let running = 0;
        return snapshot.hourlyTrend.map(h => (running += h.production));
    }

    function renderTrend() {
        if (charts.trend) {
            charts.trend.data.labels = snapshot.hourlyTrend.map(h => h.hour);
            charts.trend.data.datasets[0].data = snapshot.hourlyTrend.map(h => h.production);
            charts.trend.data.datasets[1].data = cumulativeSeries();
            charts.trend.update('none');
            return;
        }
        charts.trend = new Chart(document.getElementById('trendChart'), {
            data: {
                labels: snapshot.hourlyTrend.map(h => h.hour),
                datasets: [
                    { type: 'bar', label: 'Producción / hora', data: snapshot.hourlyTrend.map(h => h.production), backgroundColor: hexToRgba(getCss('--accent'), .55), borderRadius: 5, maxBarThickness: 26, yAxisID: 'y', order: 2 },
                    { type: 'line', label: 'Acumulado', data: cumulativeSeries(), borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .12), fill: true, tension: .35, pointRadius: 2, yAxisID: 'y1', order: 1 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: getCss('--text-dim'), font: { size: 10 } } } },
                scales: {
                    x: { ticks: { color: getCss('--text-dim'), font: { size: 9 } }, grid: { color: getCss('--grid-line') } },
                    y: { position: 'left', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 9 } }, grid: { color: getCss('--grid-line') } },
                    y1: { position: 'right', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 9 } }, grid: { display: false } }
                }
            }
        });
    }

    document.getElementById('toggleTheme').onclick = () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('pm-theme', next);
        Object.values(charts).forEach(c => c && c.destroy());
        charts.gauge = null; charts.trend = null;
        render(false);
    };
    const savedTheme = localStorage.getItem('pm-theme');
    if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

    document.getElementById('togglePresentation').onclick = () => {
        document.getElementById('app').classList.toggle('presentation');
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
            document.exitFullscreen?.().catch(() => {});
        }
        setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 260);
    };

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/metrics')
        .withAutomaticReconnect()
        .build();

    connection.on('FurnaceSnapshotUpdated', (payload) => {
        if (payload.furnaceId !== FURNACE_ID) return;
        snapshot = payload;
        render(true);
    });

    connection.start()
        .then(() => connection.invoke('JoinFurnace', FURNACE_ID))
        .catch(err => console.error('SignalR error:', err));

    render(false);
</script>
</body>
</html>
@functions {
    // Un color distinto por horno para que el acento del header/cards combine con el
    // dashboard general (mismos colores que usa cada card ahí). Tube Mills usa gris-azulado.
    string FurnaceColor(int id) => id switch
    {
        1 => "#4da3ff",
        2 => "#35d68f",
        3 => "#f2b84b",
        4 => "#c084fc",
        5 => "#ff8a5c",
        6 => "#64748b",
        _ => "#4da3ff"
    };
}
