@model Metrics_Dashboard.Models.FurnaceDetailSnapshot
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Plant Metrics · @Model.FurnaceName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <style>
        /* ============================================================
           VISTA POR HORNO - DISEÑO PARA TV (legible a ~5 m, sin scroll)
           Todo escala con --u (1u = 1% del ancho, mínimo 14px => 19.2px en 1920).
           Mínimos: texto secundario >= 1rem (~19px), nombres de línea >= 1.3rem,
           cifras clave 3-4.5rem.
           ============================================================ */
        :root { --u: max(14px, 1vw); }

        :root[data-theme="dark"] {
            --bg: #070b12; --card: #111a28; --card-2: #0b121d; --card-hover: #192438;
            --border: #31415e; --border-soft: rgba(255,255,255,0.10);
            --text: #ffffff; --text-dim: #c3cde0; --text-faint: #8e9cb8;
            --accent: #55acff; --accent-soft: rgba(85,172,255,0.18);
            --good: #35e39a; --warn: #ffc557; --bad: #ff6472; --neutral: #9aa8c4;
            --no-plan-bg: rgba(172,138,255,0.18); --no-plan-border: #b799ff; --no-plan-text: #dccfff;
            --grid-line: rgba(255,255,255,0.10); --shadow: 0 12px 30px -12px rgba(0,0,0,0.65);
            --flash: rgba(85,172,255,0.50);
            --seg-cb: #ffc24e; --seg-be: #59b2ff; --seg-cs: #c894ff; --seg-all: #e8edf7;
            --bar-fill: rgba(89,178,255,0.78);
        }
        :root[data-theme="light"] {
            --bg: #dfe5ef; --card: #ffffff; --card-2: #f1f4f9; --card-hover: #edf2fa;
            --border: #adb9cd; --border-soft: rgba(16,24,40,0.13);
            --text: #0a1220; --text-dim: #2f3d56; --text-faint: #5b6882;
            --accent: #124faa; --accent-soft: rgba(18,79,170,0.13);
            --good: #087d4c; --warn: #8a5900; --bad: #bd2637; --neutral: #53617c;
            --no-plan-bg: rgba(109,40,217,0.11); --no-plan-border: #6d28d9; --no-plan-text: #521aa8;
            --grid-line: rgba(16,24,40,0.13); --shadow: 0 12px 28px -14px rgba(20,30,60,0.28);
            --flash: rgba(25,87,194,0.24);
            --seg-cb: #8a5900; --seg-be: #124faa; --seg-cs: #6d28d9; --seg-all: #0a1220;
            --bar-fill: rgba(18,79,170,0.80);
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0; height: 100%; overflow: hidden;
            background: var(--bg); color: var(--text);
            font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .app {
            height: 100vh; width: 100vw; display: grid;
            grid-template-rows: auto auto minmax(0, 1fr);
            gap: calc(var(--u) * .6); padding: calc(var(--u) * .7);
            background: var(--bg);
        }
        .app.presentation .controls-collapsible { display: none; }

        /* ---------- HEADER (compacto) ---------- */
        header {
            display: flex; align-items: center; justify-content: space-between; gap: calc(var(--u) * 1.2);
            background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--furnace-color);
            border-radius: 16px; padding: calc(var(--u) * .3) calc(var(--u) * 1.2); box-shadow: var(--shadow);
        }
        .brand { display: flex; align-items: center; gap: calc(var(--u) * 1); }
        .logo-dot {
            width: calc(var(--u) * 3); height: calc(var(--u) * 3); border-radius: 12px; background: var(--furnace-color);
            display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: calc(var(--u) * 1.8);
            color: #06101f; box-shadow: 0 6px 16px -4px var(--furnace-color); flex-shrink: 0;
        }
        .brand-text h1 { margin: 0; font-size: calc(var(--u) * 2.8); font-weight: 900; line-height: 1.05; letter-spacing: .2px; }
        .hdr-right { display: flex; align-items: center; gap: calc(var(--u) * 1.2); }
        .hdr-info { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; line-height: 1.1; }
        .hdr-date { color: var(--text-dim); font-weight: 700; font-size: calc(var(--u) * 1.25); text-transform: capitalize; }
        .hdr-line { display: flex; align-items: center; gap: calc(var(--u) * .8); }
        .shift-badge, .historical-badge {
            background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border);
            padding: 0 calc(var(--u) * .8); border-radius: 999px; font-weight: 900; font-size: calc(var(--u) * 1.7);
        }
        .hdr-time { display: flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: calc(var(--u) * 2.1); font-variant-numeric: tabular-nums; }
        .app.presentation .hdr-date { font-size: calc(var(--u) * 1.5); }
        .app.presentation .shift-badge, .app.presentation .historical-badge { font-size: calc(var(--u) * 2.2); }
        .app.presentation .hdr-time { font-size: calc(var(--u) * 2.7); }
        .live-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--good); animation: pulse 1.8s infinite; }
        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(53,227,154,.55); } 70% { box-shadow: 0 0 0 10px rgba(53,227,154,0); } 100% { box-shadow: 0 0 0 0 rgba(53,227,154,0); } }

        .header-actions { display: flex; align-items: center; gap: calc(var(--u) * .5); }
        .btn {
            background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 10px;
            padding: calc(var(--u) * .5) calc(var(--u) * .9); font-size: max(1rem, calc(var(--u) * 1)); font-weight: 700;
            cursor: pointer; text-decoration: none; display: flex; align-items: center; gap: 6px;
        }
        .btn:hover { background: var(--card-hover); border-color: var(--furnace-color); }
        .historical-picker { display: flex; align-items: center; gap: 6px; margin: 0; }
        .historical-picker input, .historical-picker select {
            background: var(--card-2); color: var(--text); border: 1px solid var(--border); border-radius: 8px;
            padding: 6px 8px; font-size: max(1rem, calc(var(--u) * .95)); font-family: inherit;
        }

        /* ---------- FRANJA DE SEGMENTOS (KPIs grandes) ---------- */
        .seg-strip { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: calc(var(--u) * .6); }
        .seg-card {
            background: var(--card); border: 1px solid var(--border); border-left: 8px solid var(--seg-color);
            border-radius: 14px; padding: calc(var(--u) * .45) calc(var(--u) * .8); box-shadow: var(--shadow);
            display: grid; grid-template-columns: auto 1fr; grid-template-areas: "t o" "n n"; align-items: center;
            column-gap: calc(var(--u) * .6); row-gap: calc(var(--u) * .2); min-width: 0;
        }
        .seg-card.main { background: linear-gradient(90deg, var(--accent-soft), var(--card) 70%); border-color: var(--seg-color); }
        .seg-title { grid-area: t; font-size: max(1.1rem, calc(var(--u) * 1.4)); font-weight: 900; text-transform: uppercase; letter-spacing: .5px; color: var(--seg-color); line-height: 1.1; }
        .seg-title small { display: block; font-size: max(.8rem, calc(var(--u) * .75)); color: var(--text-faint); font-weight: 700; letter-spacing: .2px; text-transform: none; margin-top: 2px; }
        .seg-oee { grid-area: o; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 900; line-height: 1; font-size: calc(var(--u) * 4.4); font-variant-numeric: tabular-nums; }
        .seg-nums { grid-area: n; display: flex; justify-content: space-between; gap: calc(var(--u) * .5); border-top: 1px solid var(--border-soft); padding-top: calc(var(--u) * .25); }
        .seg-num { text-align: center; flex: 1; }
        .seg-num .v { font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: calc(var(--u) * 2.3); line-height: 1.05; font-variant-numeric: tabular-nums; }
        .seg-card.n4 .seg-num .v { font-size: calc(var(--u) * 1.75); }
        .seg-num .l { font-size: max(.9rem, calc(var(--u) * .85)); color: var(--text-faint); text-transform: uppercase; font-weight: 800; letter-spacing: .3px; white-space: nowrap; }

        /* ---------- CUERPO ---------- */
        .body-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: calc(var(--u) * .6); min-height: 0; }
        .card {
            background: var(--card); border: 1px solid var(--border); border-top: 5px solid var(--furnace-color);
            border-radius: 16px; padding: calc(var(--u) * .7) calc(var(--u) * .9); box-shadow: var(--shadow);
            display: flex; flex-direction: column; min-height: 0;
        }
        .card h2 {
            margin: 0 0 calc(var(--u) * .4) 0; font-size: max(1.05rem, calc(var(--u) * 1.15)); font-weight: 900;
            text-transform: uppercase; letter-spacing: .5px; color: var(--text-dim);
            display: flex; align-items: center; justify-content: space-between; gap: 10px;
        }
        .count-chip { font-size: max(.9rem, calc(var(--u) * .85)); font-weight: 800; color: var(--text-faint); background: var(--bg); border: 1px solid var(--border); padding: 2px 12px; border-radius: 999px; text-transform: none; letter-spacing: 0; }

        /* ---------- LÍNEAS (la altura de fila y la fuente las ajusta JS para que SIEMPRE quepan) ---------- */
        .lines-list { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 6px; --row-font: 1.4rem; }
        .line-row {
            flex: 1 1 0; min-height: 0; display: grid; grid-template-columns: minmax(0, .62fr) minmax(0, 1.9fr) auto;
            align-items: center; gap: calc(var(--u) * .7); background: var(--card-2); border: 1px solid var(--border-soft);
            border-radius: 11px; padding: 0 calc(var(--u) * .8); transition: background .8s ease; font-size: var(--row-font);
        }
        .line-row.flash { background: var(--flash); }
        .line-name { font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 1em; }
        .line-link { color: inherit; text-decoration: none; border-bottom: 2px dashed var(--border); }
        .line-link:hover { color: var(--furnace-color); border-bottom-color: var(--furnace-color); }
        .line-bar-track { height: 78%; max-height: 2.1em; border-radius: 8px; background: var(--grid-line); overflow: hidden; position: relative; }
        .target-marker { position: absolute; top: 0; bottom: 0; width: 0; border-left: 3px dashed rgba(255,255,255,.85); z-index: 2; mix-blend-mode: difference; }
        .line-bar-fill { height: 100%; border-radius: 8px; display: flex; align-items: center; padding-left: 10px; transition: width .5s ease; min-width: 3.4em; }
        .line-bar-fill span { font-family: 'JetBrains Mono', monospace; font-weight: 900; color: #fff; font-size: .95em; text-shadow: 0 1px 3px rgba(0,0,0,.6); white-space: nowrap; }
        .line-qty { text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: .88em; white-space: nowrap; line-height: 1.1; font-variant-numeric: tabular-nums; }
        .line-qty small { display: block; font-size: .62em; color: var(--text-faint); font-weight: 700; }
        .line-row.unplanned-line-row { border-color: var(--bad); background: rgba(255,100,114,0.09); }
        .unplanned-badge { height: 78%; max-height: 2.1em; border-radius: 8px; display: flex; align-items: center; padding-left: 12px; background: rgba(255,100,114,0.16); border: 2px dashed var(--bad); color: var(--bad); font-weight: 900; font-size: .72em; letter-spacing: .3px; white-space: nowrap; }

        .no-prod-section { flex: 0 0 auto; margin-top: 8px; padding-top: 8px; border-top: 2px dashed var(--border); }
        .no-prod-title { font-size: max(.95rem, calc(var(--u) * .85)); font-weight: 900; color: var(--no-plan-text); text-transform: uppercase; letter-spacing: .4px; margin-bottom: 6px; }
        .no-prod-chips { display: flex; flex-wrap: wrap; gap: 6px; max-height: calc(var(--u) * 4.4); overflow: hidden; }
        .no-prod-chip { background: var(--no-plan-bg); border: 1px solid var(--no-plan-border); color: var(--no-plan-text); padding: 3px 12px; border-radius: 999px; font-size: max(.95rem, calc(var(--u) * .85)); font-weight: 800; white-space: nowrap; text-decoration: none; }
        a.no-prod-chip:hover { background: var(--no-plan-border); color: #fff; }

        /* ---------- GRÁFICA DE TENDENCIA (protagonista) ---------- */
        .trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: calc(var(--u) * .8); margin-bottom: calc(var(--u) * .3); }
        .trend-title { font-size: max(1.2rem, calc(var(--u) * 1.5)); font-weight: 900; line-height: 1.1; }
        .trend-title .tag { display: inline-block; background: var(--seg-be); color: #06101f; border-radius: 8px; padding: 0 .45em; margin-right: .4em; letter-spacing: .5px; }
        .trend-title .sub { display: block; font-size: max(1rem, calc(var(--u) * .95)); color: var(--text-dim); font-weight: 600; margin-top: 4px; }
        .trend-kpis { display: flex; gap: calc(var(--u) * 1.1); flex-shrink: 0; }
        .trend-kpi { text-align: right; }
        .trend-kpi .v { font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: calc(var(--u) * 2.2); line-height: 1; font-variant-numeric: tabular-nums; }
        .trend-kpi .l { font-size: max(.85rem, calc(var(--u) * .75)); color: var(--text-faint); text-transform: uppercase; font-weight: 800; margin-top: 3px; }
        .chart-wrap { flex: 1; min-height: 0; position: relative; }
    </style>
</head>
<body>
    <div class="app" id="app" style="--furnace-color: @FurnaceColor(Model.FurnaceId)">

        <header>
            <div class="brand">
                <div class="logo-dot">@(Model.FurnaceId == 6 ? "TM" : Model.FurnaceId.ToString())</div>
                <div class="brand-text">
                    <h1>@Model.FurnaceName</h1>
                </div>
            </div>

            <div class="hdr-right">
                <div class="hdr-info">
                    <div class="hdr-date" id="dateLabel"></div>
                    <div class="hdr-line">
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                        @if (IsHistorical)
                        {
                            <span class="historical-badge">📅 Histórico</span>
                        }
                        else
                        {
                            <span class="hdr-time"><span class="live-dot"></span><span id="lastUpdate">--:--</span></span>
                        }
                    </div>
                </div>

            <div class="header-actions controls-collapsible">
                @if (IsHistorical)
                {
                    <form class="historical-picker" id="historicalPicker" method="get" action="@Context.Request.Path">
                        <input type="date" id="pickerDate" name="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <select id="pickerShift" name="shiftId">
                            <option value="1">Turno 1</option>
                            <option value="2">Turno 2</option>
                            <option value="3">Turno 3</option>
                        </select>
                        <button type="submit" class="btn">Ver</button>
                    </form>
                    <a class="btn" href="/Dashboard/Historical?date=@HistoricalDateStr&shiftId=@HistoricalShiftId" title="Volver al histórico general">📅 Volver</a>
                }
                else
                {
                    <a class="btn" href="/Dashboard" title="Volver al dashboard general">📊 General</a>
                }
                <button class="btn" id="toggleTheme">🌗</button>
                <button class="btn" id="togglePresentation">🖥️</button>
            </div>
            </div>
        </header>

        <div class="seg-strip" id="segStrip"></div>

        <div class="body-grid">
            <div class="card">
                <h2>Líneas de Producción <span class="count-chip" id="linesCountChip"></span></h2>
                <div class="lines-list" id="linesList"></div>
                <div class="no-prod-section" id="noProdSection" style="display:none;">
                    <div class="no-prod-title">Sin producción en este turno <span id="noProdCount"></span></div>
                    <div class="no-prod-chips" id="noProdChips"></div>
                </div>
            </div>

            <div class="card">
                <div class="trend-head">
                    <div class="trend-title">
                        <span><span class="tag" id="trendTag">BACK END</span><span id="trendTitleText">Producción por hora</span></span>
                        <span class="sub" id="trendSub"></span>
                    </div>
                    <div class="trend-kpis">
                        <div class="trend-kpi"><div class="v" id="kAcc" style="color:var(--good)">–</div><div class="l">Acumulado real</div></div>
                        <div class="trend-kpi"><div class="v" id="kExp" style="color:var(--warn)">–</div><div class="l" id="kExpL">Esperado 85%</div></div>
                        <div class="trend-kpi"><div class="v" id="kDiff">–</div><div class="l">Diferencia</div></div>
                    </div>
                </div>
                <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
            </div>
        </div>
    </div>

    <script>
        let snapshot = @Html.Raw(Json.Serialize(Model));
        const FURNACE_ID = @Model.FurnaceId;
        const IS_HISTORICAL = @(IsHistorical ? "true" : "false");
        const HIST_QS = IS_HISTORICAL ? `?date=@HistoricalDateStr&shiftId=@HistoricalShiftId` : '';
        const TARGET = 0.85;   // meta OEE: el "esperado" de la gráfica = Plan x tiempo transcurrido x 85%
        const charts = {};

        function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
        function oeeColor(oee) { return oee >= 0.85 ? getCss('--good') : oee >= 0.70 ? getCss('--warn') : getCss('--bad'); }
        function hexToRgba(hex, alpha) {
            const h = hex.replace('#', '');
            const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
            return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${alpha})`;
        }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }
        function fmt(n) { return Math.round(n).toLocaleString(); }

        document.getElementById('dateLabel').textContent = IS_HISTORICAL
            ? new Date(snapshot.generatedAt).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
            : new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

        if (IS_HISTORICAL) {
            const d = document.getElementById('pickerDate'), s = document.getElementById('pickerShift');
            if (d) d.value = '@HistoricalDateStr';
            if (s) s.value = '@HistoricalShiftId';
        }

        // ---------------- FRANJA DE SEGMENTOS ----------------
        function segCard(title, sub, color, oee, prod, plan, rem, sap, main) {
            return `
            <div class="seg-card ${main ? 'main' : ''} ${sap !== null && sap !== undefined ? 'n4' : ''}" style="--seg-color:${color}">
                <div class="seg-title">${title}${sub ? `<small>${sub}</small>` : ''}</div>
                <div class="seg-oee" style="color:${oeeColor(oee)}">${pct(oee)}</div>
                <div class="seg-nums">
                    <div class="seg-num"><div class="v">${fmt(prod)}</div><div class="l">Prod</div></div>
                    <div class="seg-num"><div class="v">${fmt(plan)}</div><div class="l">Plan</div></div>
                    <div class="seg-num"><div class="v">${fmt(rem)}</div><div class="l">Faltan</div></div>
                    ${sap !== null && sap !== undefined ? `<div class="seg-num"><div class="v">${pct(sap)}</div><div class="l">SAP</div></div>` : ''}
                </div>
            </div>`;
        }

        function renderSegments() {
            const el = document.getElementById('segStrip');
            if (FURNACE_ID === 6) {
                el.innerHTML = segCard('Tube Mills', 'OEE del turno', 'var(--furnace-color)', snapshot.oee, snapshot.totalProduction, snapshot.totalPlanned, snapshot.remainingToPlan, null, true);
                return;
            }
            let h = segCard('Horno', 'Total', 'var(--seg-all)', snapshot.oee, snapshot.totalProduction, snapshot.totalPlanned, snapshot.remainingToPlan, null, false);
            h += segCard('Core Builder', '', 'var(--seg-cb)', snapshot.coreBuilderOee, snapshot.coreBuilderProduction, snapshot.coreBuilderPlanned, snapshot.coreBuilderRemaining, null, false);
            h += segCard('Back End', 'con SAP', 'var(--seg-be)', snapshot.backEndOee, snapshot.backEndProduction, snapshot.backEndPlanned, snapshot.backEndRemaining, snapshot.backEndSapPercent, true);
            if (FURNACE_ID === 1) {
                h += segCard('Clam Shells', '', 'var(--seg-cs)', snapshot.clamShellOee, snapshot.clamShellProduction, snapshot.clamShellPlanned, snapshot.clamShellRemaining, null, false);
            }
            el.innerHTML = h;
        }

        function render(isLiveUpdate) {
            document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
            if (!IS_HISTORICAL) {
                document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
            }
            document.getElementById('linesCountChip').textContent = snapshot.lines.length + ' líneas';
            renderSegments();
            renderLinesList(isLiveUpdate);
            fitRows();
            renderTrend();
        }

        // ---------------- LÍNEAS ----------------
        // Todas las líneas empiezan con "PTC ": se quita para ganar espacio (el title conserva el nombre completo).
        function shortName(d) { return (d || '').replace(/^PTC[\s_-]+/i, ''); }
        function lineLink(l) {
            return l.productListId > 0
                ? `<a href="/Line/${l.productListId}${HIST_QS}" class="line-link" title="${l.productDesc}">${shortName(l.productDesc)}</a>`
                : shortName(l.productDesc);
        }

        function renderLinesList(isLiveUpdate) {
            const byOrder = (a, b) => a.productOrder - b.productOrder;
            const active = snapshot.lines.filter(l => l.total > 0 && !l.isUnplannedProduction).sort(byOrder);
            const unplanned = snapshot.lines.filter(l => l.isUnplannedProduction).sort(byOrder);
            const inactive = snapshot.lines.filter(l => l.total === 0 && !l.isUnplannedProduction).sort(byOrder);

            const container = document.getElementById('linesList');
            const prev = {};
            container.querySelectorAll('.line-row').forEach(el => prev[el.dataset.desc] = el.dataset.total);
            const changed = l => isLiveUpdate && prev[l.productDesc] !== undefined && prev[l.productDesc] !== String(l.total);

            const activeRows = active.map(l => `
                <div class="line-row ${changed(l) ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
                    <div class="line-name" title="${l.productDesc}">${lineLink(l)}</div>
                    <div class="line-bar-track">
                        <div class="target-marker" style="left:85%"></div>
                        <div class="line-bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}"><span>${pct(l.oeeShift)}</span></div>
                    </div>
                    <div class="line-qty">${fmt(l.total)} / ${fmt(l.accumulatedRate)}<small>Plan ${fmt(l.plannedShift)}</small></div>
                </div>`).join('');

            const unplannedRows = unplanned.map(l => `
                <div class="line-row unplanned-line-row ${changed(l) ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
                    <div class="line-name" title="${l.productDesc}">${lineLink(l)}</div>
                    <div class="unplanned-badge">⚠ PRODUCCIÓN NO PLANEADA</div>
                    <div class="line-qty">${fmt(l.total)}<small>piezas</small></div>
                </div>`).join('');

            container.innerHTML = activeRows + unplannedRows;
            if (isLiveUpdate) setTimeout(() => container.querySelectorAll('.line-row.flash').forEach(el => el.classList.remove('flash')), 900);

            const section = document.getElementById('noProdSection');
            if (inactive.length === 0) {
                section.style.display = 'none';
            } else {
                section.style.display = '';
                document.getElementById('noProdCount').textContent = `(${inactive.length})`;
                document.getElementById('noProdChips').innerHTML = inactive
                    .map(l => l.productListId > 0
                        ? `<a href="/Line/${l.productListId}${HIST_QS}" class="no-prod-chip" title="${l.productDesc}">${shortName(l.productDesc)}</a>`
                        : `<span class="no-prod-chip" title="${l.productDesc}">${shortName(l.productDesc)}</span>`).join('');
            }
        }

        // Ajusta la fuente de las filas según el espacio real: con pocas líneas se ve ENORME,
        // con muchas se reduce lo justo para que TODAS quepan sin scroll (mínimo 15px).
        function fitRows() {
            const list = document.getElementById('linesList');
            const n = list.children.length;
            if (!n) return;
            const rowH = (list.clientHeight - (n - 1) * 6) / n;
            const px = Math.max(15, Math.min(34, rowH * 0.46));
            list.style.setProperty('--row-font', px + 'px');
        }
        window.addEventListener('resize', () => { fitRows(); Object.values(charts).forEach(c => c && c.resize()); });

        // ---------------- TENDENCIA (SOLO BACK END) ----------------
        // Fuente: snapshot.backEndHourlyTrend (servidor, solo líneas Back End que cuentan).
        // Tube Mills no tiene split, usa su propia tendencia completa.
        // Esperado = expectedCumulative del servidor (Plan Back End x tiempo transcurrido) x 85%.
        function trendSource() {
            if (FURNACE_ID === 6) return { pts: snapshot.hourlyTrend, label: 'TUBE MILLS', plan: snapshot.totalPlanned, ok: true };
            if (snapshot.backEndHourlyTrend && snapshot.backEndHourlyTrend.length)
                return { pts: snapshot.backEndHourlyTrend, label: 'BACK END', plan: snapshot.backEndPlanned, ok: true };
            return { pts: snapshot.hourlyTrend, label: 'HORNO (falta parche servidor)', plan: snapshot.totalPlanned, ok: false };
        }
        function trendSeries(src) {
            let run = 0;
            return {
                labels: src.pts.map(h => h.hour),
                perHour: src.pts.map(h => h.production),
                acc: src.pts.map(h => (run += h.production)),
                exp: src.pts.map(h => h.expectedCumulative * TARGET)
            };
        }

        const barValuesPlugin = {
            id: 'barValues',
            afterDatasetsDraw(chart) {
                const ds = chart.data.datasets[0], meta = chart.getDatasetMeta(0), ctx = chart.ctx;
                ctx.save();
                ctx.font = '800 17px "JetBrains Mono", monospace';
                ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
                ctx.fillStyle = getCss('--text');
                meta.data.forEach((bar, i) => { const v = ds.data[i]; if (v > 0) ctx.fillText(fmt(v), bar.x, bar.y - 4); });
                ctx.restore();
            }
        };

        function renderTrend() {
            const src = trendSource();
            const s = trendSeries(src);

            document.getElementById('trendTag').textContent = src.label;
            document.getElementById('trendTag').style.background = src.ok ? '' : 'var(--warn)';
            document.getElementById('trendTitleText').textContent = 'Producción por hora';
            document.getElementById('trendSub').textContent = src.ok
                ? (FURNACE_ID === 6 ? 'Solo Tube Mills' : 'Solo líneas Back End · no incluye Core Builder ni Clam Shells')
                : 'Mostrando todo el horno: aplica el parche del servidor para ver solo Back End';

            const lastAcc = s.acc.length ? s.acc[s.acc.length - 1] : 0;
            const lastExp = s.exp.length ? s.exp[s.exp.length - 1] : 0;
            // En vivo se compara contra la última hora con producción; en histórico, contra el cierre del turno.
            let idx = s.exp.length - 1;
            if (!IS_HISTORICAL) { for (let i = s.exp.length - 1; i >= 0; i--) { if (src.pts[i].production > 0) { idx = i; break; } } }
            const nowAcc = s.acc[idx] ?? 0, nowExp = s.exp[idx] ?? 0, diff = nowAcc - nowExp;
            document.getElementById('kAcc').textContent = fmt(lastAcc);
            document.getElementById('kExp').textContent = fmt(nowExp);
            document.getElementById('kExpL').textContent = 'Esperado 85%';
            const kd = document.getElementById('kDiff');
            kd.textContent = (diff >= 0 ? '+' : '') + fmt(diff);
            kd.style.color = diff >= 0 ? getCss('--good') : getCss('--bad');

            if (charts.trend) {
                const c = charts.trend;
                c.data.labels = s.labels;
                c.data.datasets[0].data = s.perHour;
                c.data.datasets[1].data = s.acc;
                c.data.datasets[2].data = s.exp;
                c.options.scales.y.title.text = `Piezas por hora (${src.label === 'BACK END' ? 'Back End' : src.label})`;
                c.options.scales.y1.title.text = 'Acumulado del turno (piezas)';
                c.update('none');
                return;
            }

            const tick = { color: getCss('--text-dim'), font: { size: 17, weight: '700' } };
            const axisTitle = (text, color) => ({ display: true, text, color: color || getCss('--text'), font: { size: 18, weight: '800' }, padding: 8 });
            charts.trend = new Chart(document.getElementById('trendChart'), {
                data: {
                    labels: s.labels,
                    datasets: [
                        { type: 'bar', label: 'Producción por hora (barras, eje izq.)', data: s.perHour, backgroundColor: getCss('--bar-fill'), borderRadius: 6, maxBarThickness: 70, yAxisID: 'y', order: 3 },
                        { type: 'line', label: 'Acumulado real (eje der.)', data: s.acc, borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .14), fill: true, borderWidth: 4, tension: .3, pointRadius: 5, yAxisID: 'y1', order: 2 },
                        { type: 'line', label: 'Esperado al 85% del plan (eje der.)', data: s.exp, borderColor: getCss('--warn'), backgroundColor: 'transparent', borderDash: [10, 6], borderWidth: 4, tension: .3, pointRadius: 5, pointBackgroundColor: getCss('--warn'), fill: false, yAxisID: 'y1', order: 1 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { top: 6, right: 4 } },
                    plugins: {
                        legend: { position: 'bottom', labels: { color: getCss('--text'), font: { size: 17, weight: '700' }, boxWidth: 26, boxHeight: 6, padding: 16 } },
                        tooltip: { titleFont: { size: 16 }, bodyFont: { size: 16 } }
                    },
                    scales: {
                        x: { title: axisTitle('Hora del turno'), ticks: tick, grid: { color: getCss('--grid-line') } },
                        y: { position: 'left', beginAtZero: true, title: axisTitle(`Piezas por hora (${src.label === 'BACK END' ? 'Back End' : src.label})`, getCss('--accent')), ticks: tick, grid: { color: getCss('--grid-line') } },
                        y1: { position: 'right', beginAtZero: true, title: axisTitle('Acumulado del turno (piezas)', getCss('--good')), ticks: tick, grid: { display: false } }
                    }
                },
                plugins: [barValuesPlugin]
            });
        }

        // ---------------- CONTROLES ----------------
        document.getElementById('toggleTheme').onclick = () => {
            const html = document.documentElement;
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            try { localStorage.setItem('pm-theme', next); } catch (e) { }
            Object.values(charts).forEach(c => c && c.destroy());
            charts.trend = null;
            render(false);
        };
        try { const t = localStorage.getItem('pm-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }

        document.getElementById('togglePresentation').onclick = () => {
            document.getElementById('app').classList.toggle('presentation');
            if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => { });
            else document.exitFullscreen?.().catch(() => { });
            setTimeout(() => { fitRows(); Object.values(charts).forEach(c => c && c.resize()); }, 300);
        };

        if (!IS_HISTORICAL) {
            const connection = new signalR.HubConnectionBuilder().withUrl('/hubs/metrics').withAutomaticReconnect().build();
            connection.on('FurnaceSnapshotUpdated', (payload) => {
                if (payload.furnaceId !== FURNACE_ID) return;
                snapshot = payload;
                render(true);
            });
            connection.start().then(() => connection.invoke('JoinFurnace', FURNACE_ID)).catch(err => console.error('SignalR error:', err));
        }

        render(false);
        document.fonts && document.fonts.ready.then(fitRows);
    </script>
</body>
</html>
@functions {
    string FurnaceColor(int id) => id switch
    {
        1 => "#4da3ff",
        2 => "#35d68f",
        3 => "#f2b84b",
        4 => "#c084fc",
        5 => "#ff8a5c",
        6 => "#64748b",
        _ => "#4da3ff"
    };

    bool IsHistorical => ViewData["IsHistorical"] as bool? ?? false;
    string HistoricalDateStr => ViewData["HistoricalDate"] as string ?? "";
    int HistoricalShiftId => ViewData["HistoricalShiftId"] as int? ?? 1;
}
