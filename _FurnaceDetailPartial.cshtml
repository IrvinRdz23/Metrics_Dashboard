@model Metrics_Dashboard.Models.FurnaceDetailSnapshot
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Plant Metrics · @Model.FurnaceName</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
    :root[data-theme="dark"] {
        --bg: #0a0e15;
        --card: #131a28;
        --card-hover: #1a2338;
        --border: #263652;
        --border-soft: rgba(255,255,255,0.07);
        --text: #f2f5fb;
        --text-dim: #93a4c2;
        --text-faint: #62729a;
        --accent: #55acff;
        --accent-soft: rgba(85,172,255,0.16);
        --good: #3ddb98;
        --warn: #f5c15c;
        --bad: #ff6b78;
        --neutral: #8a99ba;
        --no-plan-bg: rgba(172,138,255,0.14);
        --no-plan-border: #ac8aff;
        --no-plan-text: #d1bfff;
        --grid-line: rgba(255,255,255,0.06);
        --shadow: 0 10px 26px -12px rgba(0,0,0,0.55);
        --flash: rgba(85,172,255,0.38);
        --pill-text: #061018;
    }
    :root[data-theme="light"] {
        --bg: #e7ebf3;
        --card: #ffffff;
        --card-hover: #eef2fa;
        --border: #c3ccdc;
        --border-soft: rgba(16,24,40,0.08);
        --text: #0c1526;
        --text-dim: #46536b;
        --text-faint: #707f9c;
        --accent: #1957c2;
        --accent-soft: rgba(25,87,194,0.11);
        --good: #0e8f57;
        --warn: #96650a;
        --bad: #c22e3e;
        --neutral: #5c6a86;
        --no-plan-bg: rgba(109,40,217,0.09);
        --no-plan-border: #6d28d9;
        --no-plan-text: #5b21b6;
        --grid-line: rgba(16,24,40,0.08);
        --shadow: 0 12px 28px -14px rgba(20,30,60,0.22);
        --flash: rgba(25,87,194,0.16);
        --pill-text: #ffffff;
    }

    * { box-sizing: border-box; }
    html, body {
        margin: 0; padding: 0; height: 100%; overflow: hidden;
        background: var(--bg); color: var(--text);
        font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }

    .app {
        height: 100vh; width: 100vw; display: grid; grid-template-rows: auto 1fr;
        gap: clamp(10px, 1.1vh, 16px); padding: clamp(12px, 1.2vh, 18px);
        background: var(--bg);
    }

    /* ---------- HEADER ---------- */
    header {
        display: flex; align-items: center; justify-content: space-between; gap: clamp(14px, 1.6vw, 26px);
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: clamp(12px, 1.5vh, 20px) clamp(20px, 2vw, 32px);
        border-top: 5px solid var(--furnace-color);
        box-shadow: var(--shadow);
    }
    .app.presentation .controls-collapsible { display: none; }

    .brand { display: flex; align-items: center; gap: clamp(12px, 1.2vw, 18px); flex-shrink: 0; }
    .brand .logo-dot {
        width: clamp(46px, 3.6vw, 60px); height: clamp(46px, 3.6vw, 60px); border-radius: 14px; background: var(--furnace-color);
        display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: clamp(1.15rem, 1.5vw, 1.5rem); color: #06101f; flex-shrink: 0;
        box-shadow: 0 6px 16px -4px var(--furnace-color);
    }
    .brand-text h1 { font-size: clamp(1.5rem, 2.1vw, 2.3rem); margin: 0; font-weight: 900; letter-spacing: .2px; }
    .brand-text .subtitle { color: var(--text-dim); font-size: clamp(.85rem, 1vw, 1.05rem); display: flex; align-items: center; gap: 10px; margin-top: 4px; font-weight: 600; }
    .shift-badge { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border); padding: 3px 12px; border-radius: 999px; font-size: clamp(.72rem, .85vw, .9rem); font-weight: 700; letter-spacing: .3px; }

    .plant-kpi { display: flex; align-items: center; gap: clamp(18px, 2.4vw, 40px); }
    .kpi-block { text-align: center; min-width: 60px; }
    .kpi-block .value { font-size: clamp(2.1rem, 3.1vw, 3.6rem); font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; font-family: 'JetBrains Mono', monospace; }
    .kpi-block .label { font-size: clamp(.62rem, .74vw, .8rem); text-transform: uppercase; letter-spacing: .6px; color: var(--text-faint); margin-top: 5px; font-weight: 700; }
    .kpi-divider { width: 1px; height: clamp(36px, 4.2vh, 54px); background: var(--border); }

    .header-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .btn {
        background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 10px;
        padding: 10px 16px; font-size: clamp(.8rem, .95vw, 1rem); font-weight: 700; cursor: pointer; text-decoration: none;
        display: flex; align-items: center; gap: 7px; transition: background .15s, border-color .15s;
    }
    .btn:hover { background: var(--card-hover); border-color: var(--furnace-color); }

    /* ---------- BODY ---------- */
    .body-grid { display: grid; grid-template-columns: 1.65fr 1fr; gap: clamp(10px, 1vw, 16px); min-height: 0; }

    .card {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: clamp(16px, 1.6vw, 24px) clamp(18px, 1.8vw, 26px);
        box-shadow: var(--shadow); display: flex; flex-direction: column; min-height: 0;
        border-top: 4px solid var(--furnace-color);
    }
    .card h2 {
        font-size: clamp(1rem, 1.15vw, 1.25rem); margin: 0 0 clamp(10px, 1.2vh, 16px) 0; font-weight: 800;
        text-transform: uppercase; letter-spacing: .5px; color: var(--text-dim);
        display: flex; align-items: center; justify-content: space-between;
    }
    .card h2 .count-chip {
        font-size: clamp(.68rem, .78vw, .85rem); font-weight: 800; color: var(--text-faint); background: var(--bg);
        border: 1px solid var(--border); padding: 3px 11px; border-radius: 999px; text-transform: none; letter-spacing: 0;
    }

    /* ---------- LISTA DE LÍNEAS ACTIVAS ---------- */
    .lines-list { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: clamp(8px, .9vh, 12px); padding-right: 3px; }
    .line-row {
        display: grid; grid-template-columns: minmax(160px, 300px) 1fr 130px; align-items: center; gap: clamp(14px, 1.6vw, 24px);
        background: var(--bg); border: 1px solid var(--border-soft); border-radius: 12px; padding: clamp(10px, 1.1vh, 15px) clamp(14px, 1.4vw, 20px);
        flex: 1 1 0; min-height: 46px; transition: background .8s ease;
    }
    .line-row.flash { background: var(--flash); }
    .line-row .line-name { font-size: clamp(.95rem, 1.15vw, 1.25rem); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .line-link { color: inherit; text-decoration: none; border-bottom: 1px dashed var(--border); }
    .line-link:hover { color: var(--furnace-color); border-bottom-color: var(--furnace-color); }
    a.no-prod-chip { text-decoration: none; cursor: pointer; }
    a.no-prod-chip:hover { background: var(--no-plan-border); color: #fff; }
    .line-row .line-plan { font-size: clamp(.78rem, .9vw, .98rem); color: var(--text-faint); text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 600; }
    .line-bar-area { display: flex; align-items: center; gap: clamp(10px, 1.1vw, 16px); min-width: 0; }
    .line-bar-track { flex: 1; height: clamp(26px, 3vh, 36px); border-radius: 8px; background: var(--grid-line); overflow: hidden; position: relative; min-width: 0; }
    .target-marker { position: absolute; top: -2px; bottom: -2px; width: 0; border-left: 2px dashed rgba(255,255,255,.55); z-index: 2; }
    .line-bar-fill { height: 100%; border-radius: 8px; display: flex; align-items: center; padding-left: 10px; transition: width .5s ease; }
    .line-bar-fill span { font-size: clamp(.85rem, 1vw, 1.1rem); font-weight: 800; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.5); font-family: 'JetBrains Mono', monospace; white-space: nowrap; }
    .line-bar-detail { font-size: clamp(.78rem, .9vw, .98rem); color: var(--text-dim); font-family: 'JetBrains Mono', monospace; font-weight: 700; white-space: nowrap; min-width: 96px; }

    /* ---------- SECCIÓN DE LÍNEAS SIN PRODUCCIÓN (compacta, debajo de la lista) ---------- */
    .no-prod-section { flex: 0 0 auto; margin-top: clamp(10px, 1.2vh, 14px); padding-top: clamp(10px, 1.2vh, 14px); border-top: 2px dashed var(--border); }
    .no-prod-title {
        font-size: clamp(.72rem, .85vw, .9rem); font-weight: 800; color: var(--no-plan-text); text-transform: uppercase;
        letter-spacing: .5px; margin-bottom: 9px; display: flex; align-items: center; gap: 7px;
    }
    .no-prod-title .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--no-plan-border); }
    .no-prod-chips { display: flex; flex-wrap: wrap; gap: 7px; max-height: 92px; overflow-y: auto; }
    .no-prod-chip {
        background: var(--no-plan-bg); border: 1px solid var(--no-plan-border); color: var(--no-plan-text);
        padding: 6px 13px; border-radius: 999px; font-size: clamp(.75rem, .85vw, .92rem); font-weight: 700; white-space: nowrap;
    }

    /* ---------- PANEL DERECHO ---------- */
    .side-stack { display: flex; flex-direction: column; gap: clamp(10px, 1vw, 16px); min-height: 0; }
    .gauge-card { flex: 0 0 auto; }
    .gauge-wrap { position: relative; width: 100%; max-width: 260px; margin: 4px auto 0; aspect-ratio: 1.55 / 1; }
    .gauge-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 4px; }
    .gauge-center .val { font-size: clamp(2.3rem, 3.2vw, 3.4rem); font-weight: 900; font-family: 'JetBrains Mono', monospace; line-height: 1; }
    .gauge-center .lab { font-size: clamp(.68rem, .78vw, .85rem); color: var(--text-faint); text-transform: uppercase; letter-spacing: .6px; font-weight: 800; margin-top: 4px; }

    .trend-mini { flex: 1; min-height: 0; }
    .trend-mini .chart-wrap { flex: 1; min-height: 0; }

    .chips-card { flex: 0 0 auto; }
    .chip-row { display: flex; justify-content: space-between; align-items: center; padding: clamp(9px, 1.1vh, 13px) 0; border-bottom: 1px solid var(--border-soft); font-size: clamp(.9rem, 1.05vw, 1.15rem); }
    .chip-row:last-child { border-bottom: none; }
    .chip-row .k { color: var(--text-dim); font-weight: 600; }
    .chip-row .v { font-weight: 800; font-family: 'JetBrains Mono', monospace; }

    .live-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 0 rgba(61,219,152,.6); animation: pulse 1.8s infinite; }
    @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(61,219,152,.55); } 70% { box-shadow: 0 0 0 10px rgba(61,219,152,0); } 100% { box-shadow: 0 0 0 0 rgba(61,219,152,0); } }
</style>
</head>
<body>
<div class="app" id="app" style="--furnace-color: @FurnaceColor(Model.FurnaceId)">

    <header>
        <div class="brand">
            <div class="logo-dot">@(Model.FurnaceId == 6 ? "TM" : Model.FurnaceId.ToString())</div>
            <div class="brand-text">
                <h1>@Model.FurnaceName</h1>
                <div class="subtitle">
                    <span id="dateLabel"></span>
                    <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                </div>
            </div>
        </div>

        <div class="plant-kpi">
            <div class="kpi-block">
                <div class="value" id="oeeVal">@Model.Oee.ToString("P0")</div>
                <div class="label">OEE Turno</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="prodVal">@Model.TotalProduction.ToString("N0")</div>
                <div class="label">Producción</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="planVal">@Model.TotalPlanned.ToString("N0")</div>
                <div class="label">Plan Turno</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="remVal">@Model.RemainingToPlan.ToString("N0")</div>
                <div class="label">Faltan por Plan</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div style="display:flex;align-items:center;gap:8px;justify-content:center;">
                    <span class="live-dot"></span>
                    <span class="value" style="font-size:clamp(1.1rem,1.4vw,1.5rem)" id="lastUpdate">--:--</span>
                </div>
                <div class="label">Última Actualización</div>
            </div>
        </div>

        <div class="header-actions controls-collapsible">
            <a class="btn" href="/Dashboard" title="Volver al dashboard general">📊 General</a>
            <button class="btn" id="toggleTheme">🌗 Tema</button>
            <button class="btn" id="togglePresentation">🖥️ Presentación</button>
        </div>
    </header>

    <div class="body-grid">
        <div class="card">
            <h2>Líneas de Producción <span class="count-chip" id="linesCountChip"></span></h2>
            <div class="lines-list" id="linesList"></div>
            <div class="no-prod-section" id="noProdSection" style="display:none;">
                <div class="no-prod-title"><span class="dot"></span>Líneas sin producción en este turno <span id="noProdCount"></span></div>
                <div class="no-prod-chips" id="noProdChips"></div>
            </div>
        </div>

        <div class="side-stack">
            <div class="card gauge-card">
                <h2>OEE de Turno</h2>
                <div class="gauge-wrap">
                    <canvas id="gaugeChart"></canvas>
                    <div class="gauge-center">
                        <div class="val" id="gaugeVal">@Model.Oee.ToString("P0")</div>
                        <div class="lab">OEE horno</div>
                    </div>
                </div>
            </div>

            <div class="card trend-mini">
                <h2>Tendencia por Hora</h2>
                <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
            </div>

            <div class="card chips-card">
                <h2>Resumen</h2>
                <div class="chip-row"><span class="k">Líneas activas</span><span class="v" id="activeLinesVal">-</span></div>
                <div class="chip-row"><span class="k">Sin producción</span><span class="v" id="noProdVal">-</span></div>
                <div class="chip-row"><span class="k">Mejor línea</span><span class="v" id="bestLineVal">-</span></div>
                <div class="chip-row"><span class="k">Línea más baja</span><span class="v" id="worstLineVal">-</span></div>
                <div class="chip-row"><span class="k">SAP %</span><span class="v" id="sapVal">-</span></div>
            </div>
        </div>
    </div>
</div>

<script>
    let snapshot = @Html.Raw(Json.Serialize(Model));
    const FURNACE_ID = @Model.FurnaceId;
    const charts = {};

    function oeeColor(oee) {
        if (oee >= 0.85) return getCss('--good');
        if (oee >= 0.70) return getCss('--warn');
        return getCss('--bad');
    }
    function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
    function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
        const r = (bigint >> 16) & 255, g = (bigint >> 8) & 255, b = bigint & 255;
        return `rgba(${r},${g},${b},${alpha})`;
    }
    function pct(v) { return (v * 100).toFixed(0) + '%'; }

    document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

    function render(isLiveUpdate) {
        document.getElementById('oeeVal').textContent = pct(snapshot.oee);
        document.getElementById('oeeVal').style.color = oeeColor(snapshot.oee);
        document.getElementById('prodVal').textContent = snapshot.totalProduction.toLocaleString();
        document.getElementById('planVal').textContent = snapshot.totalPlanned.toLocaleString();
        document.getElementById('remVal').textContent = snapshot.remainingToPlan.toLocaleString();
        document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
        document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('linesCountChip').textContent = snapshot.lines.length + ' líneas';
        document.getElementById('activeLinesVal').textContent = snapshot.linesWithProduction + ' / ' + snapshot.lines.length;
        document.getElementById('noProdVal').textContent = snapshot.linesWithoutProduction;

        const bestEl = document.getElementById('bestLineVal');
        const worstEl = document.getElementById('worstLineVal');
        bestEl.textContent = snapshot.bestLine ? pct(snapshot.bestLine.oeeShift) : '—';
        bestEl.style.color = snapshot.bestLine ? oeeColor(snapshot.bestLine.oeeShift) : '';
        worstEl.textContent = snapshot.worstLine ? pct(snapshot.worstLine.oeeShift) : '—';
        worstEl.style.color = snapshot.worstLine ? oeeColor(snapshot.worstLine.oeeShift) : '';

        document.getElementById('sapVal').textContent = pct(snapshot.sapPercent);

        renderLinesList(isLiveUpdate);
        renderGauge();
        renderTrend();
    }

    // Líneas ACTIVAS (con producción > 0) van a la lista principal con barra.
    // Líneas SIN producción (incluidas las que ni siquiera tienen plan) van a la
    // sección compacta de abajo, en morado — nunca cuentan para las estadísticas.
    function renderLinesList(isLiveUpdate) {
        const active = snapshot.lines.filter(l => l.total > 0).sort((a, b) => a.productOrder - b.productOrder);
        const inactive = snapshot.lines.filter(l => l.total === 0).sort((a, b) => a.productOrder - b.productOrder);

        const container = document.getElementById('linesList');
        const prevTotalByDesc = {};
        container.querySelectorAll('.line-row').forEach(el => prevTotalByDesc[el.dataset.desc] = el.dataset.total);

        container.innerHTML = active.map(l => {
            const changed = isLiveUpdate && prevTotalByDesc[l.productDesc] !== undefined && prevTotalByDesc[l.productDesc] !== String(l.total);
            return `
                <div class="line-row ${changed ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
                    <div class="line-name" title="${l.productDesc}">${l.productListId > 0 ? `<a href="/Line/${l.productListId}" class="line-link" title="Ver TV de esta línea">${l.productDesc}</a>` : l.productDesc}</div>
                    <div class="line-bar-area">
                        <div class="line-bar-track">
                            <div class="target-marker" style="left:85%"></div>
                            <div class="line-bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}">
                                <span>${pct(l.oeeShift)}</span>
                            </div>
                        </div>
                        <span class="line-bar-detail">${l.total.toLocaleString()}/${l.accumulatedRate.toLocaleString()}</span>
                    </div>
                    <div class="line-plan">Plan ${l.plannedShift.toLocaleString()}</div>
                </div>`;
        }).join('');

        if (isLiveUpdate) {
            setTimeout(() => container.querySelectorAll('.line-row.flash').forEach(el => el.classList.remove('flash')), 900);
        }

        const section = document.getElementById('noProdSection');
        if (inactive.length === 0) {
            section.style.display = 'none';
        } else {
            section.style.display = '';
            document.getElementById('noProdCount').textContent = `(${inactive.length})`;
            document.getElementById('noProdChips').innerHTML = inactive
                .map(l => l.productListId > 0
                    ? `<a href="/Line/${l.productListId}" class="no-prod-chip" title="Ver TV de esta línea">${l.productDesc}</a>`
                    : `<span class="no-prod-chip" title="SIN PRODUCCIÓN EN EL TURNO">${l.productDesc}</span>`)
                .join('');
        }
    }

    const gaugeCenterPlugin = {
        id: 'gaugeCenterColor',
        afterUpdate(chart) {
            const el = document.getElementById('gaugeVal');
            if (el) el.style.color = oeeColor(snapshot.oee);
        }
    };

    function renderGauge() {
        const val = Math.min(100, snapshot.oee * 100);
        const rest = Math.max(0, 100 - val);
        const color = oeeColor(snapshot.oee);
        document.getElementById('gaugeVal').textContent = pct(snapshot.oee);
        document.getElementById('gaugeVal').style.color = color;

        if (charts.gauge) {
            charts.gauge.data.datasets[0].data = [val, rest];
            charts.gauge.data.datasets[0].backgroundColor = [color, getCss('--grid-line')];
            charts.gauge.update('none');
            return;
        }
        charts.gauge = new Chart(document.getElementById('gaugeChart'), {
            type: 'doughnut',
            data: { datasets: [{ data: [val, rest], backgroundColor: [color, getCss('--grid-line')], borderWidth: 0 }] },
            options: {
                responsive: true, maintainAspectRatio: false,
                circumference: 180, rotation: 270, cutout: '76%',
                plugins: { legend: { display: false }, tooltip: { enabled: false } }
            },
            plugins: [gaugeCenterPlugin]
        });
    }

    function cumulativeSeries() {
        let running = 0;
        return snapshot.hourlyTrend.map(h => (running += h.production));
    }

    function idealHourlyRate() {
        const hours = snapshot.shiftDurationHours || 8;
        return hours > 0 ? snapshot.totalPlanned / hours : 0;
    }

    function renderTrend() {
        if (charts.trend) {
            charts.trend.data.labels = snapshot.hourlyTrend.map(h => h.hour);
            charts.trend.data.datasets[0].data = snapshot.hourlyTrend.map(h => h.production);
            charts.trend.data.datasets[1].data = cumulativeSeries();
            charts.trend.data.datasets[2].data = snapshot.hourlyTrend.map(() => idealHourlyRate());
            charts.trend.update('none');
            return;
        }
        charts.trend = new Chart(document.getElementById('trendChart'), {
            data: {
                labels: snapshot.hourlyTrend.map(h => h.hour),
                datasets: [
                    { type: 'bar', label: 'Producción / hora', data: snapshot.hourlyTrend.map(h => h.production), backgroundColor: hexToRgba(getCss('--accent'), .55), borderRadius: 6, maxBarThickness: 34, yAxisID: 'y', order: 2 },
                    { type: 'line', label: 'Acumulado', data: cumulativeSeries(), borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .12), fill: true, tension: .35, pointRadius: 3, yAxisID: 'y1', order: 1 },
                    { type: 'line', label: 'Meta de producción / hora', data: snapshot.hourlyTrend.map(() => idealHourlyRate()), borderColor: getCss('--text-faint'), borderDash: [7, 5], borderWidth: 2, pointRadius: 0, fill: false, yAxisID: 'y', order: 3 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: getCss('--text-dim'), font: { size: 13, weight: '600' }, boxWidth: 12 } } },
                scales: {
                    x: { ticks: { color: getCss('--text-dim'), font: { size: 12 } }, grid: { color: getCss('--grid-line') } },
                    y: { position: 'left', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 12 } }, grid: { color: getCss('--grid-line') } },
                    y1: { position: 'right', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 12 } }, grid: { display: false } }
                }
            }
        });
    }

    document.getElementById('toggleTheme').onclick = () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('pm-theme', next);
        Object.values(charts).forEach(c => c && c.destroy());
        charts.gauge = null; charts.trend = null;
        render(false);
    };
    const savedTheme = localStorage.getItem('pm-theme');
    if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

    document.getElementById('togglePresentation').onclick = () => {
        document.getElementById('app').classList.toggle('presentation');
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
            document.exitFullscreen?.().catch(() => {});
        }
        setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 260);
    };

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/metrics')
        .withAutomaticReconnect()
        .build();

    connection.on('FurnaceSnapshotUpdated', (payload) => {
        if (payload.furnaceId !== FURNACE_ID) return;
        snapshot = payload;
        render(true);
    });

    connection.start()
        .then(() => connection.invoke('JoinFurnace', FURNACE_ID))
        .catch(err => console.error('SignalR error:', err));

    render(false);
</script>
</body>
</html>
@functions {
    // Un color distinto por horno para que el acento del header/cards combine con el
    // dashboard general (mismos colores que usa cada card ahí). Tube Mills usa gris-azulado.
    string FurnaceColor(int id) => id switch
    {
        1 => "#4da3ff",
        2 => "#35d68f",
        3 => "#f2b84b",
        4 => "#c084fc",
        5 => "#ff8a5c",
        6 => "#64748b",
        _ => "#4da3ff"
    };
}
