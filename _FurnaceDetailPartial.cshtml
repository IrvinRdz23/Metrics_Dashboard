@model Metrics_Dashboard.Models.FurnaceDetailSnapshot
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Plant Metrics · @Model.FurnaceName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <style>
        :root[data-theme="dark"] {
        --bg: #0a0e15; --card: #131a28; --card-hover: #1a2338; --border: #263652; --border-soft: rgba(255,255,255,0.07);
        --text: #f2f5fb; --text-dim: #93a4c2; --text-faint: #62729a; --accent: #55acff; --accent-soft: rgba(85,172,255,0.16);
        --good: #3ddb98; --warn: #f5c15c; --bad: #ff6b78; --neutral: #8a99ba;
        --no-plan-bg: rgba(172,138,255,0.14); --no-plan-border: #ac8aff; --no-plan-text: #d1bfff;
        --grid-line: rgba(255,255,255,0.06); --shadow: 0 10px 26px -12px rgba(0,0,0,0.55); --flash: rgba(85,172,255,0.38); --pill-text: #061018;
        --seg-cb: #f2b84b; --seg-be: #55acff; --seg-cs: #c084fc;
        }

        :root[data-theme="light"] {
        --bg: #e7ebf3; --card: #ffffff; --card-hover: #eef2fa; --border: #c3ccdc; --border-soft: rgba(16,24,40,0.08);
        --text: #0c1526; --text-dim: #46536b; --text-faint: #707f9c; --accent: #1957c2; --accent-soft: rgba(25,87,194,0.11);
        --good: #0e8f57; --warn: #96650a; --bad: #c22e3e; --neutral: #5c6a86;
        --no-plan-bg: rgba(109,40,217,0.09); --no-plan-border: #6d28d9; --no-plan-text: #5b21b6;
        --grid-line: rgba(16,24,40,0.08); --shadow: 0 12px 28px -14px rgba(20,30,60,0.22); --flash: rgba(25,87,194,0.16); --pill-text: #ffffff;
        --seg-cb: #96650a; --seg-be: #1957c2; --seg-cs: #7c3aed;
        }

        * { box-sizing: border-box; }

        html, body {
        margin: 0; padding: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--text);
        font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased;
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }

        .app { height: 100vh; width: 100vw; display: grid; grid-template-rows: auto 1fr; gap: clamp(8px, 1vh, 12px); padding: clamp(10px, 1.1vh, 16px); background: var(--bg); }

        header {
        display: flex; align-items: center; justify-content: space-between; gap: clamp(12px, 1.4vw, 22px);
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: clamp(10px, 1.2vh, 16px) clamp(18px, 1.8vw, 28px); border-top: 5px solid var(--furnace-color); box-shadow: var(--shadow);
        }

        .app.presentation .controls-collapsible { display: none; }

        .brand { display: flex; align-items: center; gap: clamp(10px, 1vw, 16px); flex-shrink: 0; }
        .brand .logo-dot {
        width: clamp(40px, 3.2vw, 52px); height: clamp(40px, 3.2vw, 52px); border-radius: 13px; background: var(--furnace-color);
        display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: clamp(1rem, 1.3vw, 1.3rem);
        color: #06101f; flex-shrink: 0; box-shadow: 0 6px 16px -4px var(--furnace-color);
        }
        .brand-text h1 { font-size: clamp(1.25rem, 1.8vw, 1.9rem); margin: 0; font-weight: 900; letter-spacing: .2px; }
        .brand-text .subtitle { color: var(--text-dim); font-size: clamp(.78rem, .9vw, .95rem); display: flex; align-items: center; gap: 8px; margin-top: 3px; font-weight: 600; }

        .shift-badge { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border); padding: 3px 11px; border-radius: 999px; font-size: clamp(.68rem, .8vw, .85rem); font-weight: 700; letter-spacing: .3px; }

        /* ---------- SEGMENTOS DEL HEADER (item 6): Core Builder / Back End (+SAP) / Clam
        Shells (solo Furnace 1) / Tube Mills (solo su propia página, sin split ni SAP) ---------- */
        .segments-row { display: flex; align-items: stretch; gap: clamp(10px, 1.2vw, 18px); overflow-x: auto; }
        .segment {
        display: flex; flex-direction: column; gap: 2px; padding: 2px clamp(10px, 1vw, 16px);
        border-left: 3px solid var(--seg-color, var(--accent)); min-width: max-content;
        }
        .segment .seg-title { font-size: clamp(.62rem, .7vw, .76rem); font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: var(--seg-color, var(--text-faint)); margin-bottom: 2px; }
        .segment .seg-stats { display: flex; align-items: center; gap: clamp(10px, 1.1vw, 18px); }
        .segment .seg-stat { text-align: center; min-width: 46px; }
        .segment .seg-stat .v { font-size: clamp(1.1rem, 1.5vw, 1.7rem); font-weight: 800; font-family: 'JetBrains Mono', monospace; line-height: 1; }
        .segment .seg-stat .l { font-size: clamp(.56rem, .64vw, .7rem); color: var(--text-faint); text-transform: uppercase; letter-spacing: .3px; font-weight: 700; margin-top: 3px; white-space: nowrap; }

        .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
        .btn {
        background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 8px 14px;
        font-size: clamp(.76rem, .9vw, .95rem); font-weight: 700; cursor: pointer; text-decoration: none;
        display: flex; align-items: center; gap: 6px; transition: background .15s, border-color .15s;
        }
        .btn:hover { background: var(--card-hover); border-color: var(--furnace-color); }

        /* ---------- BODY ---------- */
        .body-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(10px, 1vw, 16px); min-height: 0; }

        .card {
        background: var(--card); border: 1px solid var(--border); border-radius: 16px;
        padding: clamp(14px, 1.4vw, 22px) clamp(16px, 1.6vw, 24px); box-shadow: var(--shadow);
        display: flex; flex-direction: column; min-height: 0; border-top: 4px solid var(--furnace-color);
        }

        .card h2 {
        font-size: clamp(.92rem, 1.05vw, 1.15rem); margin: 0 0 clamp(8px, 1vh, 12px) 0; font-weight: 800;
        text-transform: uppercase; letter-spacing: .5px; color: var(--text-dim); display: flex; align-items: center; justify-content: space-between;
        }
        .card h2 .count-chip {
        font-size: clamp(.66rem, .76vw, .82rem); font-weight: 800; color: var(--text-faint); background: var(--bg);
        border: 1px solid var(--border); padding: 3px 10px; border-radius: 999px; text-transform: none; letter-spacing: 0;
        }

        .lines-list { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: clamp(6px, .8vh, 10px); padding-right: 3px; }

        .line-row {
        display: grid; grid-template-columns: minmax(140px, 260px) 1fr 110px; align-items: center; gap: clamp(10px, 1.4vw, 20px);
        background: var(--bg); border: 1px solid var(--border-soft); border-radius: 11px; padding: clamp(8px, .9vh, 12px) clamp(12px, 1.2vw, 18px);
        flex: 1 1 0; min-height: 40px; transition: background .8s ease;
        }
        .line-row.flash { background: var(--flash); }
        .line-row .line-name { font-size: clamp(.85rem, 1.02vw, 1.1rem); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .line-link { color: inherit; text-decoration: none; border-bottom: 1px dashed var(--border); }
        .line-link:hover { color: var(--furnace-color); border-bottom-color: var(--furnace-color); }

        a.no-prod-chip { text-decoration: none; cursor: pointer; }
        a.no-prod-chip:hover { background: var(--no-plan-border); color: #fff; }

        .line-row .line-plan { font-size: clamp(.72rem, .82vw, .88rem); color: var(--text-faint); text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 600; }

        .line-bar-area { display: flex; align-items: center; gap: clamp(8px, 1vw, 14px); min-width: 0; }
        .line-bar-track { flex: 1; height: clamp(22px, 2.6vh, 32px); border-radius: 7px; background: var(--grid-line); overflow: hidden; position: relative; min-width: 0; }
        .target-marker { position: absolute; top: -2px; bottom: -2px; width: 0; border-left: 2px dashed rgba(255,255,255,.55); z-index: 2; }
        .line-bar-fill { height: 100%; border-radius: 7px; display: flex; align-items: center; padding-left: 9px; transition: width .5s ease; }
        .line-bar-fill span { font-size: clamp(.78rem, .92vw, 1rem); font-weight: 800; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.5); font-family: 'JetBrains Mono', monospace; white-space: nowrap; }
        .line-bar-detail { font-size: clamp(.72rem, .82vw, .88rem); color: var(--text-dim); font-family: 'JetBrains Mono', monospace; font-weight: 700; white-space: nowrap; min-width: 88px; }

        .line-row.unplanned-line-row { border-color: var(--bad); background: rgba(255,107,120,0.06); }
        .unplanned-badge {
        flex: 1; height: clamp(22px, 2.6vh, 32px); border-radius: 7px; display: flex; align-items: center; padding-left: 12px;
        background: rgba(255,107,120,0.14); border: 1px dashed var(--bad); color: var(--bad); font-size: clamp(.74rem, .88vw, .95rem); font-weight: 800; letter-spacing: .3px;
        }

        .no-prod-section { flex: 0 0 auto; margin-top: clamp(8px, 1vh, 12px); padding-top: clamp(8px, 1vh, 12px); border-top: 2px dashed var(--border); }
        .no-prod-title { font-size: clamp(.68rem, .8vw, .85rem); font-weight: 800; color: var(--no-plan-text); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px; display: flex; align-items: center; gap: 7px; }
        .no-prod-title .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--no-plan-border); }
        .no-prod-chips { display: flex; flex-wrap: wrap; gap: 6px; max-height: 72px; overflow-y: auto; }
        .no-prod-chip { background: var(--no-plan-bg); border: 1px solid var(--no-plan-border); color: var(--no-plan-text); padding: 5px 12px; border-radius: 999px; font-size: clamp(.7rem, .8vw, .86rem); font-weight: 700; white-space: nowrap; }

        /* ---------- PANEL DERECHO: la tendencia se lleva casi todo el espacio ---------- */
        .side-stack { display: flex; flex-direction: column; gap: clamp(8px, .9vw, 12px); min-height: 0; }

        .trend-mini { flex: 1; min-height: 0; }
        .trend-mini .chart-wrap { flex: 1; min-height: 0; }

        .mini-stats-card { flex: 0 0 auto; }
        .mini-stats-row { display: flex; gap: clamp(10px, 1.4vw, 20px); }
        .mini-stat { text-align: center; flex: 1; }
        .mini-stat .v { font-size: clamp(1.3rem, 1.8vw, 2rem); font-weight: 900; font-family: 'JetBrains Mono', monospace; line-height: 1; }
        .mini-stat .l { font-size: clamp(.6rem, .7vw, .76rem); color: var(--text-faint); text-transform: uppercase; letter-spacing: .4px; font-weight: 700; margin-top: 4px; }

        .chips-card { flex: 0 0 auto; }
        .chip-row { display: flex; justify-content: space-between; align-items: center; padding: clamp(5px, .7vh, 8px) 0; border-bottom: 1px solid var(--border-soft); font-size: clamp(.78rem, .92vw, 1rem); }
        .chip-row:last-child { border-bottom: none; }
        .chip-row .k { color: var(--text-dim); font-weight: 600; }
        .chip-row .v { font-weight: 800; font-family: 'JetBrains Mono', monospace; }

        .live-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--good); box-shadow: 0 0 0 0 rgba(61,219,152,.6); animation: pulse 1.8s infinite; }

        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(61,219,152,.55); } 70% { box-shadow: 0 0 0 9px rgba(61,219,152,0); } 100% { box-shadow: 0 0 0 0 rgba(61,219,152,0); } }
    </style>
</head>
<body>
    <div class="app" id="app" style="--furnace-color: @FurnaceColor(Model.FurnaceId)">

        <header>
            <div class="brand">
                <div class="logo-dot">@(Model.FurnaceId == 6 ? "TM" : Model.FurnaceId.ToString())</div>
                <div class="brand-text">
                    <h1>@Model.FurnaceName</h1>
                    <div class="subtitle">
                        <span id="dateLabel"></span>
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                        <span style="display:flex;align-items:center;gap:6px;">
                            <span class="live-dot"></span>
                            <span id="lastUpdate">--:--</span>
                        </span>
                    </div>
                </div>
            </div>

            <div class="segments-row" id="segmentsRow"></div>

            <div class="header-actions controls-collapsible">
                <a class="btn" href="/Dashboard" title="Volver al dashboard general">📊 General</a>
                <button class="btn" id="toggleTheme">🌗</button>
                <button class="btn" id="togglePresentation">🖥️</button>
            </div>
        </header>

        <div class="body-grid">
            <div class="card">
                <h2>Líneas de Producción <span class="count-chip" id="linesCountChip"></span></h2>
                <div class="lines-list" id="linesList"></div>
                <div class="no-prod-section" id="noProdSection" style="display:none;">
                    <div class="no-prod-title"><span class="dot"></span>Líneas sin producción en este turno <span id="noProdCount"></span></div>
                    <div class="no-prod-chips" id="noProdChips"></div>
                </div>
            </div>

            <div class="side-stack">
                <div class="card mini-stats-card">
                    <h2>Resumen del Horno</h2>
                    <div class="mini-stats-row">
                        <div class="mini-stat"><div class="v" id="oeeVal">@Model.Oee.ToString("P0")</div><div class="l">OEE Turno</div></div>
                        <div class="mini-stat"><div class="v" id="prodVal">@Model.TotalProduction.ToString("N0")</div><div class="l">Producción</div></div>
                        <div class="mini-stat"><div class="v" id="remVal">@Model.RemainingToPlan.ToString("N0")</div><div class="l">Faltan por Plan</div></div>
                    </div>
                </div>

                <div class="card trend-mini">
                    <h2>Tendencia por Hora</h2>
                    <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
                </div>

                <div class="card chips-card">
                    <div class="chip-row"><span class="k">Líneas activas</span><span class="v" id="activeLinesVal">-</span></div>
                    <div class="chip-row"><span class="k">Sin producción</span><span class="v" id="noProdVal">-</span></div>
                    <div class="chip-row"><span class="k">Mejor línea</span><span class="v" id="bestLineVal">-</span></div>
                    <div class="chip-row"><span class="k">Línea más baja</span><span class="v" id="worstLineVal">-</span></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let snapshot = @Html.Raw(Json.Serialize(Model));
        const FURNACE_ID = @Model.FurnaceId;
        const charts = {};

        function oeeColor(oee) {
        if (oee >= 0.85) return getCss('--good');
        if (oee >= 0.70) return getCss('--warn');
        return getCss('--bad');
        }
        function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
        function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
        const r = (bigint >> 16) & 255, g = (bigint >> 8) & 255, b = bigint & 255;
        return `rgba(${r},${g},${b},${alpha})`;
        }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }

        document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

        // ---------------------------------------------------------------
        // SEGMENTOS DEL HEADER (item 6): Tube Mills (furnaceId=6) solo se ve a sí mismo, sin
        // split ni SAP. El resto de hornos separan Core Builder / Back End (con SAP%), y
        // Furnace 1 además agrega el bloque de Clam Shells.
        // ---------------------------------------------------------------
        function renderSegments() {
        const el = document.getElementById('segmentsRow');
        if (FURNACE_ID === 6) {
        el.innerHTML = segmentHtml('Tube Mills', 'var(--furnace-color)', snapshot.oee, snapshot.totalProduction, snapshot.totalPlanned, snapshot.remainingToPlan, null);
        return;
        }

        let html = segmentHtml('Core Builder', 'var(--seg-cb)', snapshot.coreBuilderOee, snapshot.coreBuilderProduction, snapshot.coreBuilderPlanned, snapshot.coreBuilderRemaining, null);
        html += segmentHtml('Back End', 'var(--seg-be)', snapshot.backEndOee, snapshot.backEndProduction, snapshot.backEndPlanned, snapshot.backEndRemaining, snapshot.backEndSapPercent);
        if (FURNACE_ID === 1) {
        html += segmentHtml('Clam Shells', 'var(--seg-cs)', snapshot.clamShellOee, snapshot.clamShellProduction, snapshot.clamShellPlanned, snapshot.clamShellRemaining, null);
        }
        el.innerHTML = html;
        }

        function segmentHtml(title, color, oee, prod, plan, remaining, sapPct) {
        return `
        <div class="segment" style="--seg-color:${color}">
        <div class="seg-title">${title}</div>
        <div class="seg-stats">
        <div class="seg-stat"><div class="v" style="color:${oeeColor(oee)}">${pct(oee)}</div><div class="l">OEE</div></div>
        <div class="seg-stat"><div class="v">${prod.toLocaleString()}</div><div class="l">Prod</div></div>
        <div class="seg-stat"><div class="v">${plan.toLocaleString()}</div><div class="l">Plan</div></div>
        <div class="seg-stat"><div class="v">${remaining.toLocaleString()}</div><div class="l">Faltan</div></div>
        ${sapPct !== null ? `<div class="seg-stat"><div class="v">${pct(sapPct)}</div><div class="l">SAP %</div></div>` : ''}
        </div>
        </div>`;
        }

        function render(isLiveUpdate) {
        document.getElementById('oeeVal').textContent = pct(snapshot.oee);
        document.getElementById('oeeVal').style.color = oeeColor(snapshot.oee);
        document.getElementById('prodVal').textContent = snapshot.totalProduction.toLocaleString();
        document.getElementById('remVal').textContent = snapshot.remainingToPlan.toLocaleString();
        document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
        document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('linesCountChip').textContent = snapshot.lines.length + ' líneas';
        document.getElementById('activeLinesVal').textContent = snapshot.linesWithProduction + ' / ' + snapshot.lines.length;
        document.getElementById('noProdVal').textContent = snapshot.linesWithoutProduction;

        const bestEl = document.getElementById('bestLineVal');
        const worstEl = document.getElementById('worstLineVal');
        bestEl.textContent = snapshot.bestLine ? pct(snapshot.bestLine.oeeShift) : '—';
        bestEl.style.color = snapshot.bestLine ? oeeColor(snapshot.bestLine.oeeShift) : '';
        worstEl.textContent = snapshot.worstLine ? pct(snapshot.worstLine.oeeShift) : '—';
        worstEl.style.color = snapshot.worstLine ? oeeColor(snapshot.worstLine.oeeShift) : '';

        renderSegments();
        renderLinesList(isLiveUpdate);
        renderTrend();
        }

        function renderLinesList(isLiveUpdate) {
        const active = snapshot.lines.filter(l => l.total > 0 && !l.isUnplannedProduction).sort((a, b) => a.productOrder - b.productOrder);
        const unplanned = snapshot.lines.filter(l => l.isUnplannedProduction).sort((a, b) => a.productOrder - b.productOrder);
        const inactive = snapshot.lines.filter(l => l.total === 0 && !l.isUnplannedProduction).sort((a, b) => a.productOrder - b.productOrder);

        const container = document.getElementById('linesList');
        const prevTotalByDesc = {};
        container.querySelectorAll('.line-row').forEach(el => prevTotalByDesc[el.dataset.desc] = el.dataset.total);

        const activeRows = active.map(l => {
        const changed = isLiveUpdate && prevTotalByDesc[l.productDesc] !== undefined && prevTotalByDesc[l.productDesc] !== String(l.total);
        return `
        <div class="line-row ${changed ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
        <div class="line-name" title="${l.productDesc}">${l.productListId > 0 ? `<a href="/Line/${l.productListId}" class="line-link" title="Ver TV de esta línea">${l.productDesc}</a>` : l.productDesc}</div>
        <div class="line-bar-area">
        <div class="line-bar-track">
        <div class="target-marker" style="left:85%"></div>
        <div class="line-bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}">
        <span>${pct(l.oeeShift)}</span>
        </div>
        </div>
        <span class="line-bar-detail">${l.total.toLocaleString()}/${l.accumulatedRate.toLocaleString()}</span>
        </div>
        <div class="line-plan">Plan ${l.plannedShift.toLocaleString()}</div>
        </div>`;
        }).join('');

        const unplannedRows = unplanned.map(l => {
        const changed = isLiveUpdate && prevTotalByDesc[l.productDesc] !== undefined && prevTotalByDesc[l.productDesc] !== String(l.total);
        return `
        <div class="line-row unplanned-line-row ${changed ? 'flash' : ''}" data-desc="${l.productDesc}" data-total="${l.total}">
        <div class="line-name" title="${l.productDesc}">${l.productListId > 0 ? `<a href="/Line/${l.productListId}" class="line-link" title="Ver TV de esta línea">${l.productDesc}</a>` : l.productDesc}</div>
        <div class="line-bar-area">
        <div class="unplanned-badge">⚠ PRODUCCIÓN NO PLANEADA</div>
        <span class="line-bar-detail">${l.total.toLocaleString()} piezas</span>
        </div>
        <div class="line-plan">&nbsp;</div>
        </div>`;
        }).join('');

        container.innerHTML = activeRows + unplannedRows;

        if (isLiveUpdate) {
        setTimeout(() => container.querySelectorAll('.line-row.flash').forEach(el => el.classList.remove('flash')), 900);
        }

        const section = document.getElementById('noProdSection');
        if (inactive.length === 0) {
        section.style.display = 'none';
        } else {
        section.style.display = '';
        document.getElementById('noProdCount').textContent = `(${inactive.length})`;
        document.getElementById('noProdChips').innerHTML = inactive
        .map(l => l.productListId > 0
        ? `<a href="/Line/${l.productListId}" class="no-prod-chip" title="Ver TV de esta línea">${l.productDesc}</a>`
        : `<span class="no-prod-chip" title="SIN PRODUCCIÓN EN EL TURNO">${l.productDesc}</span>`)
        .join('');
        }
        }

        function cumulativeSeries() {
        let running = 0;
        return snapshot.hourlyTrend.map(h => (running += h.production));
        }

        function renderTrend() {
        if (charts.trend) {
        charts.trend.data.labels = snapshot.hourlyTrend.map(h => h.hour);
        charts.trend.data.datasets[0].data = snapshot.hourlyTrend.map(h => h.production);
        charts.trend.data.datasets[1].data = cumulativeSeries();
        charts.trend.data.datasets[2].data = snapshot.hourlyTrend.map(h => h.expectedCumulative);
        charts.trend.update('none');
        return;
        }
        charts.trend = new Chart(document.getElementById('trendChart'), {
        data: {
        labels: snapshot.hourlyTrend.map(h => h.hour),
        datasets: [
        { type: 'bar', label: 'Producción / hora', data: snapshot.hourlyTrend.map(h => h.production), backgroundColor: hexToRgba(getCss('--accent'), .55), borderRadius: 6, maxBarThickness: 40, yAxisID: 'y', order: 2 },
        { type: 'line', label: 'Acumulado', data: cumulativeSeries(), borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .12), fill: true, tension: .35, pointRadius: 4, yAxisID: 'y1', order: 1 },
        { type: 'line', label: 'Acumulado esperado', data: snapshot.hourlyTrend.map(h => h.expectedCumulative), borderColor: getCss('--warn'), backgroundColor: 'transparent', borderDash: [6, 4], tension: .35, pointRadius: 4, pointBackgroundColor: getCss('--warn'), fill: false, yAxisID: 'y1', order: 0 }
        ]
        },
        options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: { legend: { labels: { color: getCss('--text-dim'), font: { size: 14, weight: '600' }, boxWidth: 13 } } },
        scales: {
        x: { ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { color: getCss('--grid-line') } },
        y: { position: 'left', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { color: getCss('--grid-line') } },
        y1: { position: 'right', beginAtZero: true, ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { display: false } }
        }
        }
        });
        }

        document.getElementById('toggleTheme').onclick = () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('pm-theme', next);
        Object.values(charts).forEach(c => c && c.destroy());
        charts.trend = null;
        render(false);
        };
        const savedTheme = localStorage.getItem('pm-theme');
        if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

        document.getElementById('togglePresentation').onclick = () => {
        document.getElementById('app').classList.toggle('presentation');
        if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
        document.exitFullscreen?.().catch(() => {});
        }
        setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 260);
        };

        const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/metrics')
        .withAutomaticReconnect()
        .build();

        connection.on('FurnaceSnapshotUpdated', (payload) => {
        if (payload.furnaceId !== FURNACE_ID) return;
        snapshot = payload;
        render(true);
        });

        connection.start()
        .then(() => connection.invoke('JoinFurnace', FURNACE_ID))
        .catch(err => console.error('SignalR error:', err));

        render(false);
    </script>
</body>
</html>
@functions {
    string FurnaceColor(int id) => id switch
    {
        1 => "#4da3ff",
        2 => "#35d68f",
        3 => "#f2b84b",
        4 => "#c084fc",
        5 => "#ff8a5c",
        6 => "#64748b",
        _ => "#4da3ff"
    };
}
