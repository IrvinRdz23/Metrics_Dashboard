{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "M2SReportServices": "Server=YOUR_SQL_SERVER;Database=M2S_Report_Services;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "PlantMetrics": {
    "PlantListId": 1,
    "PollingIntervalSeconds": 60,
    "UseDemoData": true
  }
}
