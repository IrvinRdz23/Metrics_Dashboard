@model Metrics_Dashboard.Models.LineDetailSnapshot
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Plant Metrics · @Model.ProductDesc</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/tv-refresh.js"></script>
    <style>
        /* ============================================================
           LINE VIEW - TV DESIGN (readable from ~5 m, no scroll)
           Everything scales with --u (1u = 1% of width, min 14px => 19.2px at 1920).
           Same sizing system as the Furnace view.
           ============================================================ */
        :root { --u: max(14px, 1vw); }

        :root[data-theme="dark"] {
            --bg: #070b12; --card: #111a28; --card-2: #0b121d; --card-hover: #192438;
            --border: #31415e; --border-soft: rgba(255,255,255,0.10);
            --text: #ffffff; --text-dim: #c3cde0; --text-faint: #8e9cb8;
            --accent: #55acff; --accent-soft: rgba(85,172,255,0.18);
            --good: #35e39a; --warn: #ffc557; --bad: #ff6472;
            --no-plan-bg: rgba(172,138,255,0.18); --no-plan-border: #b799ff; --no-plan-text: #dccfff;
            --grid-line: rgba(255,255,255,0.10); --shadow: 0 12px 30px -12px rgba(0,0,0,0.65);
            --pill-text: #061018; --track-bg: rgba(255,255,255,0.08);
            --goal: #3aa0ff;            /* all GOAL lines: solid blue */
            --bar: rgba(167,139,250,0.85); /* hourly bars (purple, so they never mix with the blue goal) */
            --avg: #d08bff;             /* cycle-time average: its own color */
        }
        :root[data-theme="light"] {
            --bg: #dfe5ef; --card: #ffffff; --card-2: #f1f4f9; --card-hover: #edf2fa;
            --border: #adb9cd; --border-soft: rgba(16,24,40,0.13);
            --text: #0a1220; --text-dim: #2f3d56; --text-faint: #5b6882;
            --accent: #124faa; --accent-soft: rgba(18,79,170,0.13);
            --good: #087d4c; --warn: #8a5900; --bad: #bd2637;
            --no-plan-bg: rgba(109,40,217,0.11); --no-plan-border: #6d28d9; --no-plan-text: #521aa8;
            --grid-line: rgba(16,24,40,0.13); --shadow: 0 12px 28px -14px rgba(20,30,60,0.28);
            --pill-text: #ffffff; --track-bg: rgba(16,24,40,0.09);
            --goal: #0b5bd3;
            --bar: rgba(109,40,217,0.80);
            --avg: #9333ea;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--text);
            font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased;
        }

        .app {
            height: 100vh; width: 100vw; display: grid; grid-template-rows: auto minmax(0, 1fr);
            gap: calc(var(--u) * .6); padding: calc(var(--u) * .7); background: var(--bg);
        }
        .app.presentation .controls-collapsible { display: none; }

        /* ---------- HEADER ---------- */
        header {
            display: flex; align-items: center; justify-content: space-between; gap: calc(var(--u) * 1.2);
            background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--furnace-color);
            border-radius: 16px; padding: calc(var(--u) * .3) calc(var(--u) * 1.2); box-shadow: var(--shadow);
        }
        .brand { display: flex; align-items: center; gap: calc(var(--u) * 1); min-width: 0; }
        .furnace-tag.logo-tag {
            flex-shrink: 0; display: flex; align-items: center; justify-content: center; text-decoration: none;
            padding: calc(var(--u) * .25) calc(var(--u) * .6); border-radius: 12px; background: transparent;
        }
        .furnace-tag.logo-tag img { height: calc(var(--u) * 3.4); width: auto; object-fit: contain; display: block; }
        .brand-text { min-width: 0; }
        .brand-text h1 { margin: 0; font-size: calc(var(--u) * 2.8); font-weight: 900; line-height: 1.05; letter-spacing: .2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .brand-text .furnace-name { color: var(--text-dim); font-weight: 700; font-size: calc(var(--u) * 1.1); }

        .hdr-right { display: flex; align-items: center; gap: calc(var(--u) * 1.2); flex-shrink: 0; }
        .hdr-info { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; line-height: 1.1; }
        .hdr-date { color: var(--text-dim); font-weight: 700; font-size: calc(var(--u) * 1.25); }
        .hdr-line { display: flex; align-items: center; gap: calc(var(--u) * .8); }
        .shift-badge, .historical-badge {
            background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border);
            padding: 0 calc(var(--u) * .8); border-radius: 999px; font-weight: 900; font-size: calc(var(--u) * 1.7);
        }
        .historical-badge { background: var(--no-plan-bg); color: var(--no-plan-text); border-color: var(--no-plan-border); }
        .hdr-time { display: flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: calc(var(--u) * 2.1); font-variant-numeric: tabular-nums; }
        .app.presentation .hdr-date { font-size: calc(var(--u) * 1.5); }
        .app.presentation .shift-badge, .app.presentation .historical-badge { font-size: calc(var(--u) * 2.2); }
        .app.presentation .hdr-time { font-size: calc(var(--u) * 2.7); }
        .live-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--good); animation: pulse 1.8s infinite; }
        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(53,227,154,.55); } 70% { box-shadow: 0 0 0 10px rgba(53,227,154,0); } 100% { box-shadow: 0 0 0 0 rgba(53,227,154,0); } }

        .header-actions { display: flex; align-items: center; gap: calc(var(--u) * .5); }
        .btn {
            background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 10px;
            padding: calc(var(--u) * .5) calc(var(--u) * .9); font-size: max(1rem, calc(var(--u) * 1)); font-weight: 700;
            cursor: pointer; text-decoration: none; display: flex; align-items: center; gap: 6px;
        }
        .btn:hover { background: var(--card-hover); border-color: var(--furnace-color); }
        .historical-picker { display: flex; align-items: center; gap: 6px; margin: 0; }
        .historical-picker input, .historical-picker select {
            background: var(--card-2); color: var(--text); border: 1px solid var(--border); border-radius: 8px;
            padding: 6px 8px; font-size: max(1rem, calc(var(--u) * .95)); font-family: inherit;
        }

        /* ---------- BODY: metrics strip -> shift progress (compact) -> BIG charts ---------- */
        .body-grid { display: grid; grid-template-rows: auto auto minmax(0, 1fr); gap: calc(var(--u) * .6); min-height: 0; }

        .card { background: var(--card); border: 1px solid var(--border); border-top: 5px solid var(--furnace-color); border-radius: 16px; box-shadow: var(--shadow); }

        /* Metrics strip (4 cards, big numbers) */
        .metrics-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: calc(var(--u) * .6); }
        .metric-card { padding: calc(var(--u) * .45) calc(var(--u) * .8); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        .metric-card .mv { font-size: calc(var(--u) * 3.9); font-weight: 900; font-family: 'JetBrains Mono', monospace; line-height: 1; font-variant-numeric: tabular-nums; }
        .metric-card .ml { font-size: max(.95rem, calc(var(--u) * .95)); color: var(--text-dim); text-transform: uppercase; letter-spacing: .5px; font-weight: 800; margin-top: calc(var(--u) * .2); }

        /* Shift progress (compact) */
        .hero-panel { display: flex; flex-direction: column; gap: calc(var(--u) * .35); padding: calc(var(--u) * .5) calc(var(--u) * .9) calc(var(--u) * .6); }
        .hero-top { display: flex; align-items: center; justify-content: space-between; gap: calc(var(--u) * .8); }
        .hero-title { font-size: max(1.05rem, calc(var(--u) * 1.3)); font-weight: 900; text-transform: uppercase; letter-spacing: .6px; color: var(--text-dim); white-space: nowrap; }
        .hero-badges { display: flex; align-items: center; gap: calc(var(--u) * .8); }
        .metric-badge { display: flex; align-items: center; gap: calc(var(--u) * .45); }
        .badge-label { font-size: max(.9rem, calc(var(--u) * .85)); color: var(--text-faint); text-transform: uppercase; letter-spacing: .4px; font-weight: 800; line-height: 1.05; text-align: right; }
        .badge-pill { font-size: calc(var(--u) * 1.9); font-weight: 900; font-family: 'JetBrains Mono', monospace; padding: 0 calc(var(--u) * .7); border-radius: 999px; line-height: 1.25; }
        .badge-pill.solid { color: var(--pill-text); text-shadow: 0 1px 3px rgba(0,0,0,.25); }
        .badge-pill.outline { background: transparent; border: 3px solid var(--accent); color: var(--accent); }
        .pace-badge { padding: 0 calc(var(--u) * .9); border-radius: 999px; font-size: calc(var(--u) * 1.15); font-weight: 800; display: flex; align-items: center; gap: 8px; border: 2px solid transparent; line-height: 1.5; white-space: nowrap; }
        .pace-badge.ahead { background: rgba(53,227,154,.14); color: var(--good); border-color: var(--good); }
        .pace-badge.behind { background: rgba(255,100,114,.14); color: var(--bad); border-color: var(--bad); }

        .race-wrap { position: relative; padding-top: calc(var(--u) * 1.5); }
        .race-track { position: relative; height: calc(var(--u) * 2.9); border-radius: 14px; background: var(--track-bg); border: 2px solid var(--border-soft); overflow: hidden; }
        .race-fill { position: relative; height: 100%; border-radius: 12px 0 0 12px; transition: width .8s cubic-bezier(.22,1,.36,1); overflow: hidden; min-width: 2px; }
        .race-fill.full { border-radius: 12px; }
        .race-shine { position: absolute; top: 0; bottom: 0; width: 55%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.32), transparent); animation: shine 3.4s ease-in-out infinite; }
        @@keyframes shine { 0% { transform: translateX(-140%); } 100% { transform: translateX(240%); } }
        .race-fill-label { position: absolute; top: 50%; right: 14px; transform: translateY(-50%); font-size: calc(var(--u) * 1.9); font-weight: 900; color: #fff; text-shadow: 0 2px 6px rgba(0,0,0,.55); font-family: 'JetBrains Mono', monospace; white-space: nowrap; }
        .race-endcap { position: absolute; top: 50%; right: 14px; transform: translateY(-50%); text-align: right; font-size: calc(var(--u) * 1.1); color: var(--text-dim); font-weight: 800; z-index: 1; pointer-events: none; }

        /* GOAL marker: solid blue line + blue chip on top */
        .race-marker-line { position: absolute; top: calc(var(--u) * 1.3); bottom: -4px; width: 0; border-left: 5px solid var(--goal); z-index: 3; box-shadow: 0 0 10px var(--goal); transform: translateX(-50%); }
        .race-marker-chip {
            position: absolute; top: 0; z-index: 4; transform: translateX(-50%); background: var(--goal); color: #fff; font-weight: 900;
            font-size: calc(var(--u) * 1); padding: 0 calc(var(--u) * .6); border-radius: 8px; white-space: nowrap; line-height: 1.35;
        }

        /* Charts (the stars) */
        .lower-row { display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--u) * .6); min-height: 0; }
        .trend-card { padding: calc(var(--u) * .6) calc(var(--u) * .9); display: flex; flex-direction: column; min-height: 0; }
        .trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: calc(var(--u) * .8); margin-bottom: calc(var(--u) * .2); }
        .trend-card h2 { font-size: max(1.15rem, calc(var(--u) * 1.4)); margin: 0; font-weight: 900; text-transform: uppercase; letter-spacing: .4px; line-height: 1.1; }
        .trend-card .subtitle-note { font-size: max(.95rem, calc(var(--u) * .9)); color: var(--text-dim); font-weight: 600; margin-top: 3px; }
        .trend-kpis { display: flex; gap: calc(var(--u) * 1); flex-shrink: 0; }
        .trend-kpi { text-align: right; }
        .trend-kpi .v { font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: calc(var(--u) * 2.1); line-height: 1; font-variant-numeric: tabular-nums; }
        .trend-kpi .l { font-size: max(.85rem, calc(var(--u) * .75)); color: var(--text-faint); text-transform: uppercase; font-weight: 800; margin-top: 3px; }
        .chart-wrap { flex: 1; min-height: 0; position: relative; }

        /* No production / unplanned states */
        .no-plan-hero {
            grid-row: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: var(--no-plan-bg); border: 3px dashed var(--no-plan-border); border-radius: 22px; color: var(--no-plan-text);
            text-align: center; gap: 14px; height: 100%; padding: 0 calc(var(--u) * 3);
        }
        .no-plan-hero .big { font-size: calc(var(--u) * 4); font-weight: 900; letter-spacing: .5px; }
        .no-plan-hero .small { font-size: calc(var(--u) * 1.6); font-weight: 700; opacity: .9; }
        .no-plan-hero.unplanned-hero { background: rgba(255,100,114,0.1); border-color: var(--bad); color: var(--bad); }
    </style>
</head>
<body>
    <div class="app" id="app" style="--furnace-color: @FurnaceColor(Model.FurnaceId)">

        <header>
            <div class="brand">
                <a class="furnace-tag logo-tag" href="@FurnaceHref(Model.FurnaceId)" title="View full @Model.FurnaceName">
                    <img src="~/images/@(GetClientLogo(Model.ProductDesc).LogoFile)" alt="@(GetClientLogo(Model.ProductDesc).AltText)" />
                </a>
                <div class="brand-text">
                    <h1 id="lineTitle">@Model.ProductDesc</h1>
                    <div class="furnace-name">@Model.FurnaceName</div>
                </div>
            </div>

            <div class="hdr-right">
                <div class="hdr-info">
                    <div class="hdr-date" id="dateLabel"></div>
                    <div class="hdr-line">
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                        @if (IsHistorical)
                        {
                            <span class="historical-badge">📅 Historical</span>
                        }
                        else
                        {
                            <span class="hdr-time"><span class="live-dot"></span><span id="lastUpdate">--:--</span></span>
                        }
                    </div>
                </div>

                <div class="header-actions controls-collapsible">
                    @if (IsHistorical)
                    {
                        <form class="historical-picker" id="historicalPicker" method="get" action="@Context.Request.Path">
                            <input type="date" id="pickerDate" name="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@HistoricalDateStr" />
                            <select id="pickerShift" name="shiftId">
                                <option value="1">Shift 1</option>
                                <option value="2">Shift 2</option>
                                <option value="3">Shift 3</option>
                            </select>
                            <button type="submit" class="btn">Go</button>
                        </form>
                    }
                    <a class="btn" href="@FurnaceHref(Model.FurnaceId)@(IsHistorical ? $"?date={HistoricalDateStr}&shiftId={HistoricalShiftId}" : "")" title="Back to furnace">📊 @Model.FurnaceName</a>
                    <button class="btn" id="toggleTheme">🌗</button>
                    <button class="btn" id="togglePresentation">🖥️</button>
                </div>
            </div>
        </header>

        <div class="body-grid" id="bodyGrid"></div>
    </div>

    <script>
        let snapshot = @Html.Raw(Json.Serialize(Model));
        const LINE_ID = @Model.ProductListId;
        const IS_HISTORICAL = @(IsHistorical ? "true" : "false");
        const TARGET = 0.85;   // OEE goal: the trend GOAL line = expected cumulative x 85%
        const charts = {};

        function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
        function oeeColor(oee) { return oee >= 0.85 ? getCss('--good') : oee >= 0.70 ? getCss('--warn') : getCss('--bad'); }
        function hexToRgba(hex, alpha) {
            const h = hex.replace('#', '');
            const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
            return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${alpha})`;
        }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }
        function fmt(n) { return Math.round(n).toLocaleString('en-US'); }

        function formatEnglishDate(date) {
            const d = new Date(date);
            const day = d.getDate();
            const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
            return `${d.toLocaleDateString('en-US', { weekday: 'long' })} ${d.toLocaleDateString('en-US', { month: 'long' })} ${day}${suffix}`;
        }
        document.getElementById('dateLabel').textContent = formatEnglishDate(IS_HISTORICAL ? snapshot.generatedAt : new Date());

        function render() {
            document.getElementById('lineTitle').textContent = snapshot.productDesc;
            document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
            if (!IS_HISTORICAL) {
                document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            }

            const grid = document.getElementById('bodyGrid');

            if (!snapshot.hasPlan) {
                if (snapshot.total > 0) {
                    grid.innerHTML = `
                    <div class="no-plan-hero unplanned-hero">
                        <div class="big">⚠ NON PLANNED PRODUCTION</div>
                        <div class="small">Heijunka shows this line had no plan this shift, but it produced ${snapshot.total.toLocaleString('en-US')} piece(s) — it does not count toward OEE.</div>
                    </div>`;
                    return;
                }
                grid.innerHTML = `
                <div class="no-plan-hero">
                    <div class="big">NO PRODUCTION THIS SHIFT</div>
                    <div class="small">This line has no plan assigned for the current shift</div>
                </div>`;
                return;
            }

            const wasEmpty = !document.getElementById('oeeBadge');
            if (wasEmpty) {
                grid.innerHTML = `
                <div class="metrics-row">
                    <div class="card metric-card"><div class="mv" id="prodVal">-</div><div class="ml">Production</div></div>
                    <div class="card metric-card"><div class="mv" id="expVal" style="color:var(--goal)">-</div><div class="ml">Expected by Now</div></div>
                    <div class="card metric-card"><div class="mv" id="remVal">-</div><div class="ml">Remaining to Plan</div></div>
                    <div class="card metric-card"><div class="mv" id="sapVal">-</div><div class="ml">SAP</div></div>
                </div>

                <div class="card hero-panel">
                    <div class="hero-top">
                        <div class="hero-title">Shift Progress</div>
                        <div class="hero-badges">
                            <div class="pace-badge" id="paceBadge"></div>
                            <div class="metric-badge"><div class="badge-label">Shift<br>OEE</div><div class="badge-pill solid" id="oeeBadge">-</div></div>
                            <div class="metric-badge"><div class="badge-label">Progress<br>vs Plan</div><div class="badge-pill outline" id="progressBadge">-</div></div>
                        </div>
                    </div>
                    <div class="race-wrap">
                        <div class="race-marker-chip" id="raceMarkerChip"></div>
                        <div class="race-marker-line" id="raceMarkerLine"></div>
                        <div class="race-track" id="raceTrack">
                            <div class="race-fill" id="raceFill">
                                <div class="race-shine"></div>
                                <div class="race-fill-label" id="raceFillLabel"></div>
                            </div>
                            <div class="race-endcap"><span id="racePlanVal"></span> plan</div>
                        </div>
                    </div>
                </div>

                <div class="lower-row">
                    <div class="card trend-card">
                        <div class="trend-head">
                            <div>
                                <h2>Hourly Trend</h2>
                                <div class="subtitle-note">Pieces produced per hour &amp; shift accumulated</div>
                            </div>
                            <div class="trend-kpis">
                                <div class="trend-kpi"><div class="v" id="kAcc" style="color:var(--good)">–</div><div class="l">Accumulated</div></div>
                                <div class="trend-kpi"><div class="v" id="kGoal" style="color:var(--goal)">–</div><div class="l">Goal 85%</div></div>
                                <div class="trend-kpi"><div class="v" id="kDiff">–</div><div class="l">Difference</div></div>
                            </div>
                        </div>
                        <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
                    </div>
                    <div class="card trend-card">
                        <div class="trend-head">
                            <div>
                                <h2>Cycle Time: Real vs. Theoretical</h2>
                                <div class="subtitle-note">Approx. per hour (sec / piece)</div>
                            </div>
                            <div class="trend-kpis">
                                <div class="trend-kpi"><div class="v" id="kAvg" style="color:var(--avg)">–</div><div class="l">Shift Avg</div></div>
                                <div class="trend-kpi"><div class="v" id="kTheo" style="color:var(--goal)">–</div><div class="l">Theoretical</div></div>
                            </div>
                        </div>
                        <div class="chart-wrap"><canvas id="cycleTimeChart"></canvas></div>
                    </div>
                </div>`;
            }

            const color = oeeColor(snapshot.oeeShift);
            const oeeBadge = document.getElementById('oeeBadge');
            oeeBadge.textContent = pct(snapshot.oeeShift);
            oeeBadge.style.background = color;

            const plan = snapshot.plannedShift;
            const actualPct = plan > 0 ? Math.min(100, (snapshot.total / plan) * 100) : 0;
            const expectedPct = plan > 0 ? Math.min(100, (snapshot.accumulatedRate / plan) * 100) : 0;
            document.getElementById('progressBadge').textContent = Math.round(actualPct) + '%';

            const fill = document.getElementById('raceFill');
            fill.style.width = actualPct + '%';
            fill.style.background = `linear-gradient(90deg, ${hexToRgba(color, .8)}, ${color})`;
            fill.classList.toggle('full', actualPct >= 99.5);
            document.getElementById('raceFillLabel').textContent = fmt(snapshot.total);

            // GOAL marker (solid blue). The chip is clamped so it never spills out of the card.
            document.getElementById('raceMarkerLine').style.left = expectedPct + '%';
            const chip = document.getElementById('raceMarkerChip');
            chip.style.left = `clamp(9%, ${expectedPct}%, 91%)`;
            chip.textContent = `Should be at ${fmt(snapshot.accumulatedRate)}`;
            document.getElementById('racePlanVal').textContent = fmt(plan);

            document.getElementById('prodVal').textContent = fmt(snapshot.total);
            document.getElementById('expVal').textContent = fmt(snapshot.accumulatedRate);
            document.getElementById('remVal').textContent = fmt(Math.max(0, plan - snapshot.total));
            document.getElementById('sapVal').textContent = snapshot.excludedFromSap ? '—' : fmt(snapshot.totalSap);

            const paceBadge = document.getElementById('paceBadge');
            const diff = snapshot.total - snapshot.accumulatedRate;
            if (plan > 0 && snapshot.total >= plan) {
                paceBadge.className = 'pace-badge ahead';
                paceBadge.innerHTML = `🏆 Plan complete! ${fmt(snapshot.total)} pcs`;
            } else if (diff >= 0) {
                paceBadge.className = 'pace-badge ahead';
                paceBadge.innerHTML = `🔥 Ahead of pace +${fmt(diff)} pcs`;
            } else {
                paceBadge.className = 'pace-badge behind';
                paceBadge.innerHTML = `⚠️ Behind pace ${fmt(Math.abs(diff))} pcs`;
            }

            renderTrend();
            renderCycleTimeChart();
        }

        // ---------------- shared chart helpers ----------------
        const tickStyle = () => ({ color: getCss('--text-dim'), font: { size: 17, weight: '700' } });
        const axisTitle = (text, color) => ({ display: true, text, color: color || getCss('--text'), font: { size: 18, weight: '800' }, padding: 8 });
        const legendStyle = () => ({ position: 'bottom', labels: { color: getCss('--text'), font: { size: 17, weight: '700' }, boxWidth: 26, boxHeight: 6, padding: 14 } });

        // Values above the first dataset's bars.
        function barValuesPlugin(decimals, suffix) {
            return {
                id: 'barValues',
                afterDatasetsDraw(chart) {
                    const ds = chart.data.datasets[0], meta = chart.getDatasetMeta(0), ctx = chart.ctx;
                    ctx.save();
                    ctx.font = '800 17px "JetBrains Mono", monospace';
                    ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
                    ctx.fillStyle = getCss('--text');
                    meta.data.forEach((bar, i) => {
                        const v = ds.data[i];
                        if (v != null && v > 0) ctx.fillText(Number(v).toFixed(decimals) + suffix, bar.x, bar.y - 4);
                    });
                    ctx.restore();
                }
            };
        }

        // Soft glow on every dataset flagged isGoal (blue solid GOAL lines).
        const goalGlowPlugin = {
            id: 'goalGlow',
            beforeDatasetDraw(chart, args) {
                if (!chart.data.datasets[args.index].isGoal) return;
                chart.ctx.save();
                chart.ctx.shadowColor = getCss('--goal');
                chart.ctx.shadowBlur = 12;
            },
            afterDatasetDraw(chart, args) {
                if (!chart.data.datasets[args.index].isGoal) return;
                chart.ctx.restore();
            }
        };

        // ---------------- HOURLY TREND ----------------
        function trendSeries() {
            const pts = snapshot.hourlyTrend || [];
            let run = 0;
            return {
                labels: pts.map(h => h.hour),
                perHour: pts.map(h => h.production),
                acc: pts.map(h => (run += h.production)),
                goal: pts.map(h => h.expectedCumulative * TARGET),
                pts
            };
        }

        function renderTrend() {
            const canvas = document.getElementById('trendChart');
            if (!canvas) return;
            const s = trendSeries();

            // KPIs: accumulated at close vs goal at the last hour with production (live) / end of shift (historical)
            let idx = s.goal.length - 1;
            if (!IS_HISTORICAL) { for (let i = s.pts.length - 1; i >= 0; i--) { if (s.pts[i].production > 0) { idx = i; break; } } }
            const accNow = s.acc[idx] ?? 0, goalNow = s.goal[idx] ?? 0, diff = accNow - goalNow;
            document.getElementById('kAcc').textContent = fmt(s.acc.length ? s.acc[s.acc.length - 1] : 0);
            document.getElementById('kGoal').textContent = fmt(goalNow);
            const kd = document.getElementById('kDiff');
            kd.textContent = (diff >= 0 ? '+' : '') + fmt(diff);
            kd.style.color = diff >= 0 ? getCss('--good') : getCss('--bad');

            if (charts.trend) {
                const c = charts.trend;
                c.data.labels = s.labels;
                c.data.datasets[0].data = s.perHour;
                c.data.datasets[1].data = s.acc;
                c.data.datasets[2].data = s.goal;
                c.update('none');
                return;
            }
            charts.trend = new Chart(canvas, {
                data: {
                    labels: s.labels,
                    datasets: [
                        { type: 'bar', label: 'Pieces / hour (bars, left axis)', data: s.perHour, backgroundColor: getCss('--bar'), borderRadius: 6, maxBarThickness: 70, yAxisID: 'y', order: 3 },
                        { type: 'line', label: 'Real accumulated (right axis)', data: s.acc, borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .14), fill: true, borderWidth: 4, tension: .3, pointRadius: 5, pointBackgroundColor: getCss('--good'), pointBorderColor: getCss('--card'), pointBorderWidth: 2, yAxisID: 'y1', order: 2 },
                        { type: 'line', label: 'GOAL 85% (right axis)', data: s.goal, isGoal: true, borderColor: getCss('--goal'), backgroundColor: 'transparent', borderWidth: 5, tension: .3, pointRadius: 6, pointBackgroundColor: getCss('--goal'), pointBorderColor: getCss('--card'), pointBorderWidth: 2, fill: false, yAxisID: 'y1', order: 1 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { top: 6, right: 4 } },
                    plugins: { legend: legendStyle(), tooltip: { titleFont: { size: 16 }, bodyFont: { size: 16 } } },
                    scales: {
                        x: { title: axisTitle('Shift hour'), ticks: tickStyle(), grid: { color: getCss('--grid-line') } },
                        y: { position: 'left', beginAtZero: true, grace: '12%', title: axisTitle('Pieces / hour', getCss('--bar')), ticks: tickStyle(), grid: { color: getCss('--grid-line') } },
                        y1: { position: 'right', beginAtZero: true, title: axisTitle('Shift accumulated (pieces)', getCss('--good')), ticks: tickStyle(), grid: { display: false } }
                    }
                },
                plugins: [barValuesPlugin(0, ''), goalGlowPlugin]
            });
        }

        // ---------------- CYCLE TIME ----------------
        function renderCycleTimeChart() {
            const canvas = document.getElementById('cycleTimeChart');
            if (!canvas) return;

            const points = snapshot.cycleTimeTrend || [];
            const labels = points.map(p => p.hour);
            const actual = points.map(p => p.actualCycleTimeSecs);
            const theoretical = labels.map(() => snapshot.cycleTimeSecs);
            const mean = snapshot.actualCycleTimeMean;
            const meanLine = labels.map(() => mean != null ? mean : null);

            document.getElementById('kAvg').textContent = mean != null ? Number(mean).toFixed(1) + 's' : '—';
            document.getElementById('kTheo').textContent = Number(snapshot.cycleTimeSecs).toFixed(1) + 's';

            const barColor = (v) => {
                if (v == null) return 'transparent';
                if (v <= snapshot.cycleTimeSecs * 1.05) return hexToRgba(getCss('--good'), .8);
                if (v <= snapshot.cycleTimeSecs * 1.2) return hexToRgba(getCss('--warn'), .8);
                return hexToRgba(getCss('--bad'), .8);
            };

            if (charts.cycleTime) {
                const ds = charts.cycleTime.data.datasets;
                charts.cycleTime.data.labels = labels;
                ds[0].data = actual; ds[0].backgroundColor = actual.map(barColor);
                ds[1].data = theoretical;
                ds[2].data = meanLine;
                charts.cycleTime.update('none');
                return;
            }

            charts.cycleTime = new Chart(canvas, {
                data: {
                    labels,
                    datasets: [
                        { type: 'bar', label: 'Real cycle time (sec)', data: actual, backgroundColor: actual.map(barColor), borderRadius: 6, maxBarThickness: 60, order: 2 },
                        { type: 'line', label: 'GOAL: theoretical cycle time (sec)', data: theoretical, isGoal: true, borderColor: getCss('--goal'), borderWidth: 5, pointRadius: 0, fill: false, order: 0 },
                        { type: 'line', label: 'Shift average (sec)', data: meanLine, borderColor: getCss('--avg'), borderWidth: 4, borderDash: [3, 6], borderCapStyle: 'round', pointRadius: 0, fill: false, order: 1, spanGaps: true }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { top: 6, right: 4 } },
                    plugins: {
                        legend: legendStyle(),
                        tooltip: {
                            titleFont: { size: 16 }, bodyFont: { size: 16 },
                            callbacks: {
                                label: (c) => c.raw == null ? `${c.dataset.label}: no production that hour` : `${c.dataset.label}: ${Number(c.raw).toFixed(1)}s`,
                                afterBody: (items) => {
                                    const p = points[items[0]?.dataIndex];
                                    if (!p) return [];
                                    const notes = [`Pieces that hour: ${p.production}`];
                                    if (p.availableSeconds) notes.push(`Available seconds used: ${p.availableSeconds}s`);
                                    if (p.isInProgress) notes.push('⏳ This hour is still in progress — the number is partial.');
                                    return notes;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { title: axisTitle('Shift hour'), ticks: tickStyle(), grid: { color: getCss('--grid-line') } },
                        y: { beginAtZero: true, grace: '12%', title: axisTitle('Seconds / piece'), ticks: tickStyle(), grid: { color: getCss('--grid-line') } }
                    }
                },
                plugins: [barValuesPlugin(1, 's'), goalGlowPlugin]
            });
        }

        // ---------------- CONTROLS ----------------
        document.getElementById('toggleTheme').onclick = () => {
            const html = document.documentElement;
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            try { localStorage.setItem('pm-theme', next); } catch (e) { }
            if (charts.trend) { charts.trend.destroy(); charts.trend = null; }
            if (charts.cycleTime) { charts.cycleTime.destroy(); charts.cycleTime = null; }
            document.getElementById('bodyGrid').innerHTML = '';
            render();
        };
        try { const t = localStorage.getItem('pm-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }

        document.getElementById('togglePresentation').onclick = () => {
            document.getElementById('app').classList.toggle('presentation');
            if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => { });
            else document.exitFullscreen?.().catch(() => { });
            setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 300);
        };
        window.addEventListener('resize', () => Object.values(charts).forEach(c => c && c.resize()));

        if (!IS_HISTORICAL) {
            PM.startHub({
                url: '/hubs/metrics',
                handlers: {
                    LineSnapshotUpdated: (payload) => {
                        if (payload.productListId !== LINE_ID) return;
                        snapshot = payload;
                        render();
                    }
                },
                onConnected: (conn) => conn.invoke('JoinLine', LINE_ID)   // re-runs after every reconnect
            });
            PM.scheduleRefresh();   // reload at 00:00 / 06:00 / 12:00 / 18:00
        }

        render();
    </script>
</body>
</html>
@functions {
    string FurnaceColor(int id) => id switch
    {
        1 => "#4da3ff",
        2 => "#35d68f",
        3 => "#f2b84b",
        4 => "#c084fc",
        5 => "#ff8a5c",
        6 => "#64748b",
        _ => "#4da3ff"
    };

    string FurnaceHref(int id) => id == 6 ? "/TubeMills" : $"/Furnace{id}";

    bool IsHistorical => ViewData["IsHistorical"] as bool? ?? false;
    string HistoricalDateStr => ViewData["HistoricalDate"] as string ?? "";
    int HistoricalShiftId => ViewData["HistoricalShiftId"] as int? ?? 1;

    static readonly (string Token, string LogoFile, string AltText)[] ClientLogoRules = new[]
    {
        ("PCM", "honda.png", "Honda"),
        ("WS", "chrysler.png", "Chrysler"),
        ("D2UX", "gm.png", "General Motors"),
        ("Lucid", "lucid.png", "Lucid"),
        ("Clam Shell", "default-car.png", "Cliente"),
        ("BMW", "bmw.png", "BMW"),
        ("Tesla", "tesla.png", "Tesla"),
        ("Toyota", "toyota.png", "Toyota"),
        ("GM", "gm.png", "General Motors"),
        ("Honda", "honda.png", "Honda"),
        ("RIVIAN", "rivian.png", "Rivian"),
        ("BEV3", "gm.png", "General Motors"),
    };

    (string LogoFile, string AltText) GetClientLogo(string productDesc)
    {
        var desc = productDesc ?? "";
        foreach (var rule in ClientLogoRules)
        {
            var pattern = @"\b" + System.Text.RegularExpressions.Regex.Escape(rule.Token) + @"\b";
            if (System.Text.RegularExpressions.Regex.IsMatch(desc, pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                return (rule.LogoFile, rule.AltText);
            }
        }
        return ("default-car.png", "Cliente");
    }
}
