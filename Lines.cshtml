@model Metrics_Dashboard.Models.LineDetailSnapshot
@{
    Layout = null;
    var shifts = (ViewData["Shifts"] as List<ShiftInfo>) ?? new List<ShiftInfo>();
    var histDate = Model.HistoricalDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
    var qs = Model.IsHistorical ? $"?date={histDate}&shiftId={Model.HistoricalShiftId}" : "";
    var backUrl = Model.GroupId > 0 ? $"/Group/{Model.GroupId}{qs}" : "/";
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.PlantName · @Model.ProductDesc</title>
    <script>
        try { var t = localStorage.getItem('pm-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="/css/site.css" />
    <script src="/lib/chart.umd.min.js"></script>
</head>
<body>
    <div class="app" id="app">

        <header>
            <div class="brand">
                <a class="back-link" href="@backUrl" title="Volver al grupo">‹</a>
                <img src="/images/m2s.png" alt="" onerror="this.style.display='none'" />
                <div class="brand-text">
                    <h1>
                        <span id="lname">@Model.ProductDesc</span>
                        @if (Model.IsHistorical)
                        {
                            <span class="hist-badge">HISTÓRICO</span>
                        }
                    </h1>
                    <div class="subtitle">
                        <span>@Model.GroupName · @Model.PlantName</span>
                        <span id="dateLabel"></span>
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                    </div>
                </div>
            </div>

            <div class="plant-kpi">
                @if (!Model.IsHistorical)
                {
                    <div class="kpi-block">
                        <div style="display:flex;align-items:center;gap:6px;justify-content:center;">
                            <span class="live-dot"></span>
                            <span class="value" style="font-size:.95rem" id="lastUpdate">--:--</span>
                        </div>
                        <div class="label">Última Actualización</div>
                    </div>
                }
            </div>

            <div class="header-actions controls-collapsible">
                @if (Model.IsHistorical)
                {
                    <div class="picker">
                        <input type="date" id="dateInput" value="@histDate" />
                        <select id="shiftSelect">
                            @foreach (var s in shifts)
                            {
                                <option value="@s.ShiftId" selected="@(s.ShiftId == Model.HistoricalShiftId)">@s.ShiftDesc</option>
                            }
                        </select>
                    </div>
                    <a class="btn" href="/Line/@Model.ProductListId">● En vivo</a>
                }
                else
                {
                    <a class="btn" href="/Historical" title="Ver turnos anteriores">🕘 Histórico</a>
                }
                <button class="btn" id="toggleTheme">🌗</button>
                <button class="btn" id="togglePresentation">🖥️</button>
            </div>
        </header>

        <div class="detail-body" id="body">
            <div class="big-kpis span2">
                <div class="big-kpi"><div class="v" id="kOee">—</div><div class="l">OEE de turno</div></div>
                <div class="big-kpi"><div class="v" id="kProd">0</div><div class="l">Producción</div></div>
                <div class="big-kpi"><div class="v" id="kExp">0</div><div class="l">Esperado a esta hora</div></div>
                <div class="big-kpi"><div class="v" id="kPlan">0</div><div class="l">Plan de turno</div></div>
                <div class="big-kpi"><div class="v" id="kSap">—</div><div class="l">SAP %</div></div>
            </div>

            <div class="card detail-card" id="prodCard">
                <h2><span>Producción por hora</span><span class="hint">Acumulado vs. esperado</span></h2>
                <div class="chart-wrap"><canvas id="prodChart"></canvas></div>
            </div>

            <div class="card detail-card" id="ctCard">
                <h2><span>Tiempo de ciclo real por hora</span><span class="hint" id="ctHint"></span></h2>
                <div class="chips" id="ctChips" style="margin-top:4px"></div>
                <div class="chart-wrap"><canvas id="ctChart"></canvas></div>
            </div>

            <div class="no-plan-box span2" id="noPlanBox" style="display:none;margin-top:0"></div>
        </div>
    </div>

    <script>
        let snap = @Html.Raw(Json.Serialize(Model));
        const IS_HIST = snap.isHistorical === true;
        const LINE_ID = snap.productListId;
        const GROUP_COLORS = ['#4da3ff', '#35d68f', '#f2b84b', '#c084fc'];
        let prodChart = null, ctChart = null;

        function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
        function oeeColor(o) { return o >= 0.85 ? getCss('--good') : (o >= 0.70 ? getCss('--warn') : getCss('--bad')); }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }
        function fmt(n) { return Number(n || 0).toLocaleString(); }
        function hexToRgba(hex, a) {
            const h = hex.replace('#', '');
            const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
            return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
        }
        const tick = () => ({ color: getCss('--text-dim'), font: { size: 13 } });

        // ---------- producción por hora ----------
        function prodData() {
            const t = snap.hourlyTrend || [];
            const color = GROUP_COLORS[snap.colorIndex % GROUP_COLORS.length];
            let run = 0;
            return {
                labels: t.map(h => h.hour),
                datasets: [
                    { type: 'bar', label: 'Producción / hora', data: t.map(h => h.production), backgroundColor: hexToRgba(color, .65), borderRadius: 6, maxBarThickness: 46, yAxisID: 'y', order: 3 },
                    { type: 'line', label: 'Acumulado', data: t.map(h => (run += h.production)), borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .1), fill: true, tension: .3, pointRadius: 3, borderWidth: 2, yAxisID: 'y1', order: 1 },
                    { type: 'line', label: 'Esperado acumulado', data: t.map(h => h.expectedCumulative), borderColor: getCss('--warn'), borderDash: [6, 5], pointRadius: 0, borderWidth: 2, spanGaps: false, yAxisID: 'y1', order: 2 }
                ]
            };
        }
        function buildProdChart() {
            prodChart = new Chart(document.getElementById('prodChart'), {
                type: 'bar',
                data: prodData(),
                options: {
                    responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, animation: { duration: 400 },
                    plugins: { legend: { position: 'bottom', labels: { color: getCss('--text-dim'), font: { size: 13, weight: '600' }, boxWidth: 12 } } },
                    scales: {
                        x: { ticks: tick(), grid: { color: getCss('--grid-line') } },
                        y: { position: 'left', beginAtZero: true, ticks: tick(), grid: { color: getCss('--grid-line') }, title: { display: true, text: 'Piezas / hora', color: getCss('--text-faint') } },
                        y1: { position: 'right', beginAtZero: true, ticks: tick(), grid: { display: false }, title: { display: true, text: 'Acumulado', color: getCss('--text-faint') } }
                    }
                }
            });
        }

        // ---------- tiempo de ciclo ----------
        // Verde = a tiempo o mejor que el teórico, ámbar = hasta 15% más lento, rojo = más lento que eso.
        function ctColor(v, theo) {
            if (!theo || theo <= 0) return getCss('--accent');
            if (v <= theo) return getCss('--good');
            return v <= theo * 1.15 ? getCss('--warn') : getCss('--bad');
        }
        const ctLabelsPlugin = {
            id: 'ctLabels',
            afterDatasetsDraw(chart) {
                const meta = chart.getDatasetMeta(0), ds = chart.data.datasets[0], pts = ds.pointsRef || [];
                const ctx = chart.ctx;
                ctx.save();
                ctx.font = '800 14px "Cascadia Mono", Consolas, monospace';
                ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
                ctx.fillStyle = getCss('--text');
                meta.data.forEach((bar, i) => {
                    const p = pts[i];
                    if (!p || p.actualCycleTimeSecs == null) return;
                    ctx.fillText(p.actualCycleTimeSecs.toFixed(1) + 's' + (p.isInProgress ? '*' : ''), bar.x, bar.y - 4);
                });
                ctx.restore();
            }
        };
        function ctData() {
            const t = snap.cycleTimeTrend || [];
            const theo = snap.cycleTimeSecs;
            return {
                labels: t.map(p => p.hour),
                datasets: [
                    {
                        type: 'bar', label: 'CT real (s/pieza)', data: t.map(p => p.actualCycleTimeSecs),
                        backgroundColor: t.map(p => hexToRgba(ctColor(p.actualCycleTimeSecs || 0, theo), p.isInProgress ? .45 : .9)),
                        borderRadius: 6, maxBarThickness: 46, pointsRef: t, order: 3
                    },
                    { type: 'line', label: 'CT teórico', data: t.map(() => theo), borderColor: getCss('--accent'), borderDash: [8, 5], pointRadius: 0, borderWidth: 2, order: 1 },
                    { type: 'line', label: 'CT real promedio', data: t.map(() => snap.actualCycleTimeMean), borderColor: getCss('--text-dim'), borderDash: [2, 4], pointRadius: 0, borderWidth: 2, order: 2 }
                ]
            };
        }
        function buildCtChart() {
            ctChart = new Chart(document.getElementById('ctChart'), {
                type: 'bar',
                data: ctData(),
                plugins: [ctLabelsPlugin],
                options: {
                    responsive: true, maintainAspectRatio: false, animation: { duration: 400 },
                    layout: { padding: { top: 22 } },
                    plugins: { legend: { position: 'bottom', labels: { color: getCss('--text-dim'), font: { size: 13, weight: '600' }, boxWidth: 12 } } },
                    scales: {
                        x: { ticks: tick(), grid: { color: getCss('--grid-line') } },
                        y: { beginAtZero: true, ticks: tick(), grid: { color: getCss('--grid-line') }, title: { display: true, text: 'Segundos por pieza', color: getCss('--text-faint') } }
                    }
                }
            });
        }

        // ---------- render ----------
        function render() {
            document.getElementById('shiftLabel').textContent = snap.shiftDesc || '—';
            document.getElementById('dateLabel').textContent = new Date(snap.eventDate).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
            const lu = document.getElementById('lastUpdate');
            if (lu) lu.textContent = new Date(snap.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

            const unplanned = snap.isUnplannedProduction === true;
            const hasPlan = snap.hasPlan === true;
            const body = document.getElementById('body');
            const box = document.getElementById('noPlanBox');
            const showCharts = hasPlan || unplanned || snap.total > 0;

            document.getElementById('prodCard').style.display = showCharts ? '' : 'none';
            document.getElementById('ctCard').style.display = showCharts ? '' : 'none';
            box.style.display = showCharts ? 'none' : 'flex';
            box.innerHTML = 'SIN PRODUCCIÓN PLANEADA<br>EN ESTE TURNO';

            const oee = document.getElementById('kOee');
            if (unplanned) {
                oee.textContent = 'NO PLANEADA';
                oee.style.fontSize = 'clamp(1.2rem, 2vw, 2.4rem)';
                oee.style.color = 'var(--bad)';
            } else {
                oee.style.fontSize = '';
                oee.textContent = hasPlan ? pct(snap.oeeShift) : '—';
                oee.style.color = hasPlan ? oeeColor(snap.oeeShift) : 'var(--neutral)';
            }
            const prod = document.getElementById('kProd');
            prod.textContent = fmt(snap.total);
            prod.style.color = unplanned ? 'var(--bad)' : '';
            document.getElementById('kExp').textContent = hasPlan ? fmt(snap.accumulatedRate) : '—';
            document.getElementById('kPlan').textContent = hasPlan ? fmt(snap.plannedShift) : '—';
            document.getElementById('kSap').textContent = snap.total > 0 ? pct(snap.sapPercent) : '—';

            const theo = snap.cycleTimeSecs, mean = snap.actualCycleTimeMean;
            document.getElementById('ctHint').textContent = 'Segundos disponibles ÷ piezas · * hora en curso';
            document.getElementById('ctChips').innerHTML =
                `<span class="chip">Teórico: ${theo ? theo.toFixed(1) + 's' : '—'}</span>` +
                `<span class="chip">Real promedio: ${mean != null ? mean.toFixed(1) + 's' : '—'}</span>`;

            if (showCharts) {
                if (!prodChart) buildProdChart(); else { prodChart.data = prodData(); prodChart.update('none'); }
                if (!ctChart) buildCtChart(); else { ctChart.data = ctData(); ctChart.update('none'); }
            }
        }

        document.getElementById('toggleTheme').onclick = () => {
            const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('pm-theme', next); } catch (e) { }
            if (prodChart) { prodChart.destroy(); prodChart = null; }
            if (ctChart) { ctChart.destroy(); ctChart = null; }
            render();
        };
        document.getElementById('togglePresentation').onclick = () => {
            document.getElementById('app').classList.toggle('presentation');
            if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => { });
            else document.exitFullscreen?.().catch(() => { });
            setTimeout(() => { prodChart && prodChart.resize(); ctChart && ctChart.resize(); }, 300);
        };
        const dateInput = document.getElementById('dateInput');
        const shiftSelect = document.getElementById('shiftSelect');
        if (dateInput) dateInput.onchange = () => { if (dateInput.value) location.href = `/Line/${LINE_ID}?date=${dateInput.value}`; };
        if (shiftSelect) shiftSelect.onchange = () => { location.href = `/Line/${LINE_ID}?date=${dateInput.value}&shiftId=${shiftSelect.value}`; };

        if (!IS_HIST) {
            setInterval(async () => {
                try {
                    const r = await fetch(`/Line/${LINE_ID}/Data`, { cache: 'no-store' });
                    if (r.ok) { snap = await r.json(); render(); }
                } catch (e) { console.error(e); }
            }, 10000);
        }

        render();
    </script>
</body>
</html>
