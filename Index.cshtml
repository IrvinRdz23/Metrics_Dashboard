@model PlantMetricsDashboard.Models.PlantDashboardSnapshot
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>Plant Metrics · Dashboard General</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
    :root[data-theme="dark"] {
        --bg: #0a0e16;
        --bg-elevated: #11172447;
        --header-bg: linear-gradient(180deg, #141c2c 0%, #10161f 100%);
        --card: linear-gradient(160deg, #151d2e 0%, #121826 100%);
        --card-hover: #1a2438;
        --border: #223049;
        --border-soft: rgba(255,255,255,0.06);
        --text: #eef2f9;
        --text-dim: #8394b3;
        --text-faint: #526180;
        --accent: #4da3ff;
        --accent-soft: rgba(77,163,255,0.15);
        --good: #35d68f;
        --warn: #f2b84b;
        --bad: #ff5d6c;
        --grid-line: rgba(255,255,255,0.055);
        --shadow: 0 10px 30px -12px rgba(0,0,0,0.55);
        --flash: rgba(77,163,255,0.35);
    }
    :root[data-theme="light"] {
        --bg: #eef1f7;
        --bg-elevated: #ffffff;
        --header-bg: linear-gradient(180deg, #ffffff 0%, #f6f8fc 100%);
        --card: linear-gradient(160deg, #ffffff 0%, #f9fbfd 100%);
        --card-hover: #f1f5fb;
        --border: #dee4ee;
        --border-soft: rgba(0,0,0,0.05);
        --text: #101828;
        --text-dim: #5b6675;
        --text-faint: #8a94a6;
        --accent: #1f6feb;
        --accent-soft: rgba(31,111,235,0.10);
        --good: #12a463;
        --warn: #b57a09;
        --bad: #d43a4a;
        --grid-line: rgba(0,0,0,0.06);
        --shadow: 0 10px 30px -14px rgba(20,30,50,0.18);
        --flash: rgba(31,111,235,0.18);
    }

    * { box-sizing: border-box; }
    html, body {
        margin: 0; padding: 0; height: 100%; overflow: hidden;
        background: var(--bg); color: var(--text);
        font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 8px; }

    .app {
        height: 100vh; width: 100vw;
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 12px;
        padding: 14px;
        background:
            radial-gradient(circle at 15% -10%, var(--accent-soft), transparent 40%),
            var(--bg);
    }

    /* ---------- HEADER ---------- */
    header {
        display: flex; align-items: center; justify-content: space-between;
        background: var(--header-bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 14px 22px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }
    header::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, var(--accent), var(--good), var(--warn), var(--accent));
        background-size: 300% 100%;
        animation: sheen 12s linear infinite;
        opacity: .8;
    }
    @@keyframes sheen { 0% { background-position: 0% 0; } 100% { background-position: 300% 0; } }

    .app.presentation header.controls-collapsible { display: none; }

    .brand { display: flex; align-items: center; gap: 14px; }
    .brand .logo-dot {
        width: 34px; height: 34px; border-radius: 10px;
        background: linear-gradient(135deg, var(--accent), #2450a6);
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: .85rem; color: #fff; flex-shrink: 0;
        box-shadow: 0 4px 14px -4px var(--accent);
    }
    .brand-text h1 { font-size: 1.1rem; margin: 0; font-weight: 700; letter-spacing: .2px; }
    .brand-text .subtitle {
        color: var(--text-dim); font-size: .74rem; display: flex; align-items: center; gap: 8px; margin-top: 2px;
    }
    .shift-badge {
        background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border);
        padding: 2px 9px; border-radius: 999px; font-size: .68rem; font-weight: 600; letter-spacing: .3px;
    }

    .plant-kpi { display: flex; align-items: center; gap: 30px; }
    .kpi-block { text-align: center; min-width: 64px; }
    .kpi-block .value {
        font-size: 1.7rem; font-weight: 800; line-height: 1;
        font-variant-numeric: tabular-nums; font-family: 'JetBrains Mono', monospace;
        transition: color .3s ease;
    }
    .kpi-block .label { font-size: .64rem; text-transform: uppercase; letter-spacing: .7px; color: var(--text-faint); margin-top: 4px; font-weight: 600; }
    .kpi-divider { width: 1px; height: 34px; background: var(--border); }

    .header-actions { display: flex; align-items: center; gap: 8px; }
    .btn {
        background: var(--card); border: 1px solid var(--border); color: var(--text);
        border-radius: 9px; padding: 9px 13px; font-size: .78rem; font-weight: 600; cursor: pointer;
        display: flex; align-items: center; gap: 6px; transition: background .15s, transform .1s, border-color .15s;
    }
    .btn:hover { background: var(--card-hover); border-color: var(--accent); transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }
    .date-picker { display: none; align-items: center; gap: 6px; }
    .date-picker.open { display: flex; }
    .date-picker input {
        background: var(--card); border: 1px solid var(--border); color: var(--text);
        border-radius: 8px; padding: 8px 10px; font-size: .8rem;
    }

    /* ---------- GRID DE HORNOS (proporcional siempre, también en presentación) ---------- */
    .grid-main {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 14px;
        min-height: 0;
    }

    .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        min-height: 0;
        cursor: pointer;
        box-shadow: var(--shadow);
        transition: transform .14s ease, border-color .14s ease, background .14s ease, box-shadow .14s ease;
        position: relative;
        overflow: hidden;
    }
    .card::after {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
        background: var(--furnace-color, var(--accent)); opacity: .85;
    }
    .card:hover { transform: translateY(-3px); border-color: var(--furnace-color, var(--accent)); }
    .card.selected { border-color: var(--furnace-color, var(--accent)); background: var(--card-hover); box-shadow: 0 0 0 1px var(--furnace-color, var(--accent)), var(--shadow); }
    .card.dimmed { opacity: .32; transform: scale(.985); }
    .card.flash { animation: flashUpdate 900ms ease; }
    @@keyframes flashUpdate { 0% { box-shadow: 0 0 0 2px var(--flash), var(--shadow); } 100% { box-shadow: var(--shadow); } }

    .furnace-card .card-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .furnace-card h2 { font-size: .98rem; margin: 0; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .furnace-card h2 .fnum {
        width: 22px; height: 22px; border-radius: 7px; background: var(--furnace-color, var(--accent));
        color: #06101f; font-size: .72rem; font-weight: 800; display: flex; align-items: center; justify-content: center;
    }
    .furnace-card .oee-pill {
        font-size: .78rem; font-weight: 800; padding: 4px 11px; border-radius: 999px;
        color: #05140c; font-family: 'JetBrains Mono', monospace;
    }
    .furnace-card .numbers { display: flex; gap: 20px; margin-top: 12px; }
    .furnace-card .numbers .n .v { font-size: 1.32rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
    .furnace-card .numbers .n .l { font-size: .62rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: .5px; font-weight: 600; margin-top: 2px; }

    .furnace-card .chart-wrap { flex: 1; min-height: 0; margin-top: 10px; position: relative; }
    .furnace-card .worst-line {
        margin-top: 10px; font-size: .72rem; color: var(--text-dim);
        display: flex; justify-content: space-between; border-top: 1px solid var(--border-soft); padding-top: 9px;
    }
    .furnace-card .worst-line b { color: var(--bad); font-family: 'JetBrains Mono', monospace; }

    .trend-card { display: flex; flex-direction: column; }
    .trend-card h2 { font-size: .98rem; margin: 0 0 8px 0; font-weight: 700; display: flex; align-items: center; justify-content: space-between; }
    .trend-card h2 .hint { font-size: .64rem; font-weight: 600; color: var(--text-faint); text-transform: none; letter-spacing: 0; }
    .trend-card .chart-wrap { flex: 1; min-height: 0; }

    /* ---------- PANEL DE DRILL-DOWN (cross-filter) ---------- */
    .drilldown-overlay {
        position: fixed; inset: 0; background: rgba(4,7,14,.6); backdrop-filter: blur(3px);
        display: none; align-items: center; justify-content: center; z-index: 50;
    }
    .drilldown-overlay.open { display: flex; }
    .drilldown-panel {
        width: min(960px, 92vw); max-height: 84vh; overflow: auto;
        background: var(--bg-elevated, var(--card)); background: var(--card);
        border: 1px solid var(--border); border-radius: 16px;
        padding: 22px 24px; box-shadow: var(--shadow);
    }
    .drilldown-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
    .drilldown-panel h3 { margin: 0 0 6px 0; font-size: 1.15rem; display: flex; align-items: center; gap: 10px; }
    .drilldown-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .chip {
        background: var(--accent-soft); border: 1px solid var(--border); color: var(--text);
        padding: 5px 11px; border-radius: 999px; font-size: .72rem; font-weight: 600;
        font-family: 'JetBrains Mono', monospace;
    }
    table.lines-table { width: 100%; border-collapse: collapse; font-size: .82rem; margin-top: 6px; }
    table.lines-table th, table.lines-table td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--border-soft); }
    table.lines-table th { color: var(--text-faint); font-weight: 700; font-size: .66rem; text-transform: uppercase; letter-spacing: .5px; }
    table.lines-table tbody tr:hover { background: var(--card-hover); }
    table.lines-table td.num { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
    .bar-cell { display: flex; align-items: center; gap: 8px; }
    .bar-track { flex: 1; height: 6px; border-radius: 4px; background: var(--grid-line); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 4px; transition: width .4s ease; }
    .close-btn { flex-shrink: 0; }

    .live-dot {
        width: 8px; height: 8px; border-radius: 50%; background: var(--good);
        box-shadow: 0 0 0 0 rgba(53,214,143,.6); animation: pulse 1.8s infinite;
    }
    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(53,214,143,.55); }
        70% { box-shadow: 0 0 0 8px rgba(53,214,143,0); }
        100% { box-shadow: 0 0 0 0 rgba(53,214,143,0); }
    }
</style>
</head>
<body>
<div class="app" id="app">

    <header>
        <div class="brand">
            <div class="logo-dot">PM</div>
            <div class="brand-text">
                <h1>Plant Metrics · Planta 1</h1>
                <div class="subtitle">
                    <span id="dateLabel"></span>
                    <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                </div>
            </div>
        </div>

        <div class="plant-kpi">
            <div class="kpi-block">
                <div class="value" id="plantOee">@Model.PlantOee.ToString("P0")</div>
                <div class="label">OEE Planta</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="plantProd">@Model.TotalProduction.ToString("N0")</div>
                <div class="label">Producción</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div class="value" id="plantPlanned">@Model.TotalPlanned.ToString("N0")</div>
                <div class="label">Plan de Turno</div>
            </div>
            <div class="kpi-divider"></div>
            <div class="kpi-block">
                <div style="display:flex;align-items:center;gap:6px;justify-content:center;">
                    <span class="live-dot"></span>
                    <span class="value" style="font-size:.9rem" id="lastUpdate">--:--</span>
                </div>
                <div class="label">Última Actualización</div>
            </div>
        </div>

        <div class="header-actions controls-collapsible">
            <div class="date-picker" id="datePicker">
                <input type="date" id="dateInput" />
            </div>
            <button class="btn" id="toggleDate">📅 Fecha</button>
            <button class="btn" id="toggleTheme">🌗 Tema</button>
            <button class="btn" id="togglePresentation">🖥️ Presentación</button>
        </div>
    </header>

    <div class="grid-main" id="grid"></div>
</div>

<div class="drilldown-overlay" id="drilldownOverlay">
    <div class="drilldown-panel">
        <div class="drilldown-head">
            <div>
                <h3 id="drilldownTitle">Horno</h3>
                <div class="drilldown-chips" id="drilldownChips"></div>
            </div>
            <button class="btn close-btn" id="closeDrilldown">Cerrar ✕</button>
        </div>
        <table class="lines-table">
            <thead>
                <tr><th>Línea</th><th>OEE Turno</th><th>Producción</th><th>Esperado a esta hora</th><th>Plan Turno</th><th>SAP</th></tr>
            </thead>
            <tbody id="drilldownBody"></tbody>
        </table>
    </div>
</div>

<script>
    // ---------------------------------------------------------------
    // Estado inicial servido por el servidor (primer render, sin esperar SignalR)
    // ---------------------------------------------------------------
    let snapshot = @Html.Raw(Json.Serialize(Model));
    let selectedFurnaceId = null;
    const charts = {}; // id -> Chart.js instance
    const FURNACE_COLORS = ['#4da3ff', '#35d68f', '#f2b84b', '#c084fc', '#ff8a5c'];

    function furnaceColor(id) { return FURNACE_COLORS[(id - 1) % FURNACE_COLORS.length]; }
    function oeeColor(oee) {
        if (oee >= 0.85) return getCss('--good');
        if (oee >= 0.70) return getCss('--warn');
        return getCss('--bad');
    }
    function getCss(varName) { return getComputedStyle(document.documentElement).getPropertyValue(varName).trim(); }
    function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
        const r = (bigint >> 16) & 255, g = (bigint >> 8) & 255, b = bigint & 255;
        return `rgba(${r},${g},${b},${alpha})`;
    }
    function pct(v) { return (v * 100).toFixed(0) + '%'; }

    document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

    // ---------------------------------------------------------------
    // RENDER
    // ---------------------------------------------------------------
    function render(isLiveUpdate) {
        setKpi('plantOee', pct(snapshot.plantOee));
        setKpi('plantProd', snapshot.totalProduction.toLocaleString());
        setKpi('plantPlanned', snapshot.totalPlanned.toLocaleString());
        document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
        document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

        const grid = document.getElementById('grid');
        const isFirstRender = grid.children.length === 0;

        if (isFirstRender) {
            grid.innerHTML = '';
            snapshot.furnaces.forEach(f => grid.appendChild(buildFurnaceCard(f)));
            grid.appendChild(buildTrendCard());
        } else {
            snapshot.furnaces.forEach(f => updateFurnaceCard(f, isLiveUpdate));
            updateTrendChart();
        }
        applySelection();
    }

    function setKpi(id, text) {
        const el = document.getElementById(id);
        if (el.textContent !== text) {
            el.textContent = text;
            el.style.color = getCss('--accent');
            setTimeout(() => { el.style.color = ''; }, 600);
        }
    }

    function buildFurnaceCard(f) {
        const div = document.createElement('div');
        div.className = 'card furnace-card';
        div.id = 'furnace-' + f.furnaceId;
        div.style.setProperty('--furnace-color', furnaceColor(f.furnaceId));
        div.onclick = () => selectFurnace(f.furnaceId);

        div.innerHTML = `
            <div class="card-top">
                <h2><span class="fnum">${f.furnaceId}</span>${f.furnaceName}</h2>
                <span class="oee-pill" id="pill-${f.furnaceId}" style="background:${oeeColor(f.oee)}">${pct(f.oee)}</span>
            </div>
            <div class="numbers">
                <div class="n"><div class="v" id="prod-${f.furnaceId}">${f.totalProduction.toLocaleString()}</div><div class="l">Producción</div></div>
                <div class="n"><div class="v" id="plan-${f.furnaceId}">${f.totalPlanned.toLocaleString()}</div><div class="l">Plan Turno</div></div>
                <div class="n"><div class="v" id="sap-${f.furnaceId}">${pct(f.sapPercent)}</div><div class="l">SAP %</div></div>
            </div>
            <div class="chart-wrap"><canvas id="chart-${f.furnaceId}"></canvas></div>
            <div class="worst-line" id="worst-${f.furnaceId}"></div>
        `;
        setTimeout(() => {
            charts['f' + f.furnaceId] = new Chart(document.getElementById('chart-' + f.furnaceId), lineBarConfig(f));
            renderWorstLine(f);
        }, 0);
        return div;
    }

    function lineBarConfig(f) {
        const top = [...f.lines].sort((a, b) => b.total - a.total).slice(0, 5);
        return {
            type: 'bar',
            data: {
                labels: top.map(l => l.productDesc.replace('PTC ', '')),
                datasets: [{
                    data: top.map(l => l.oeeShift * 100),
                    backgroundColor: top.map(l => oeeColor(l.oeeShift)),
                    borderRadius: 5,
                    maxBarThickness: 14
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                animation: { duration: 500 },
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.raw.toFixed(0) + '% OEE de turno' } } },
                scales: {
                    x: { min: 0, ticks: { display: false }, grid: { color: getCss('--grid-line') } },
                    y: { ticks: { color: getCss('--text-dim'), font: { size: 10 } }, grid: { display: false } }
                }
            }
        };
    }

    function renderWorstLine(f) {
        const el = document.getElementById('worst-' + f.furnaceId);
        if (!el) return;
        if (f.worstLine) {
            el.innerHTML = `<span>⚠ Línea más baja: ${f.worstLine.productDesc}</span><b>${pct(f.worstLine.oeeShift)}</b>`;
        } else {
            el.innerHTML = '';
        }
    }

    function updateFurnaceCard(f, isLiveUpdate) {
        const card = document.getElementById('furnace-' + f.furnaceId);
        const pill = document.getElementById('pill-' + f.furnaceId);
        if (!pill) return;

        const prodChanged = document.getElementById('prod-' + f.furnaceId).textContent !== f.totalProduction.toLocaleString();

        pill.textContent = pct(f.oee);
        pill.style.background = oeeColor(f.oee);
        document.getElementById('prod-' + f.furnaceId).textContent = f.totalProduction.toLocaleString();
        document.getElementById('plan-' + f.furnaceId).textContent = f.totalPlanned.toLocaleString();
        document.getElementById('sap-' + f.furnaceId).textContent = pct(f.sapPercent);
        renderWorstLine(f);

        if (isLiveUpdate && prodChanged && card) {
            card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash');
        }

        const chart = charts['f' + f.furnaceId];
        if (chart) {
            const cfg = lineBarConfig(f);
            chart.data = cfg.data;
            chart.update('none');
        }
        if (selectedFurnaceId === f.furnaceId) renderDrilldown(f);
    }

    function buildTrendCard() {
        const div = document.createElement('div');
        div.className = 'card trend-card';
        div.innerHTML = `<h2>Tendencia de Planta <span class="hint">Producción por hora + acumulado del turno</span></h2><div class="chart-wrap"><canvas id="chart-trend"></canvas></div>`;
        setTimeout(() => { charts['trend'] = new Chart(document.getElementById('chart-trend'), trendConfig()); }, 0);
        return div;
    }

    function cumulativeSeries() {
        let running = 0;
        return snapshot.hourlyTrend.map(h => (running += h.production));
    }

    function trendConfig() {
        return {
            data: {
                labels: snapshot.hourlyTrend.map(h => h.hour),
                datasets: [
                    {
                        type: 'bar', label: 'Producción / hora',
                        data: snapshot.hourlyTrend.map(h => h.production),
                        backgroundColor: hexToRgba(getCss('--accent'), .55),
                        borderRadius: 6, maxBarThickness: 40, yAxisID: 'y', order: 2
                    },
                    {
                        type: 'line', label: 'Acumulado del turno',
                        data: cumulativeSeries(),
                        borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .12),
                        fill: true, tension: .35, pointRadius: 3, pointBackgroundColor: getCss('--good'),
                        yAxisID: 'y1', order: 1
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                animation: { duration: 500 },
                plugins: { legend: { labels: { color: getCss('--text-dim'), font: { size: 11 } } } },
                scales: {
                    x: { ticks: { color: getCss('--text-dim') }, grid: { color: getCss('--grid-line') } },
                    y: {
                        position: 'left', beginAtZero: true,
                        ticks: { color: getCss('--text-dim') }, grid: { color: getCss('--grid-line') },
                        title: { display: true, text: 'Piezas / hora', color: getCss('--text-faint'), font: { size: 10 } }
                    },
                    y1: {
                        position: 'right', beginAtZero: true,
                        ticks: { color: getCss('--text-dim') }, grid: { display: false },
                        title: { display: true, text: 'Acumulado del turno', color: getCss('--text-faint'), font: { size: 10 } }
                    }
                }
            }
        };
    }

    function updateTrendChart() {
        const chart = charts['trend'];
        if (!chart) return;
        chart.data.labels = snapshot.hourlyTrend.map(h => h.hour);
        chart.data.datasets[0].data = snapshot.hourlyTrend.map(h => h.production);
        chart.data.datasets[1].data = cumulativeSeries();
        chart.update('none');
    }

    // ---------------------------------------------------------------
    // CROSS-FILTER: clic en un horno -> dimear los demás + abrir drill-down con TODAS sus líneas
    // ---------------------------------------------------------------
    function selectFurnace(id) {
        selectedFurnaceId = (selectedFurnaceId === id) ? null : id;
        applySelection();
        if (selectedFurnaceId) {
            const f = snapshot.furnaces.find(x => x.furnaceId === selectedFurnaceId);
            renderDrilldown(f);
            document.getElementById('drilldownOverlay').classList.add('open');
        } else {
            document.getElementById('drilldownOverlay').classList.remove('open');
        }
    }

    function applySelection() {
        snapshot.furnaces.forEach(f => {
            const card = document.getElementById('furnace-' + f.furnaceId);
            if (!card) return;
            card.classList.toggle('selected', selectedFurnaceId === f.furnaceId);
            card.classList.toggle('dimmed', selectedFurnaceId !== null && selectedFurnaceId !== f.furnaceId);
        });
    }

    function renderDrilldown(f) {
        if (!f) return;
        document.getElementById('drilldownTitle').innerHTML =
            `<span class="fnum" style="display:inline-flex;width:24px;height:24px;border-radius:8px;background:${furnaceColor(f.furnaceId)};color:#06101f;align-items:center;justify-content:center;font-size:.8rem;">${f.furnaceId}</span> ${f.furnaceName}`;
        document.getElementById('drilldownChips').innerHTML = `
            <span class="chip">Producción: ${f.totalProduction.toLocaleString()}</span>
            <span class="chip">Plan: ${f.totalPlanned.toLocaleString()}</span>
            <span class="chip">OEE: ${pct(f.oee)}</span>
            <span class="chip">SAP: ${pct(f.sapPercent)}</span>
            <span class="chip">${f.lines.length} líneas</span>
        `;
        const rows = [...f.lines].sort((a, b) => b.total - a.total).map(l => `
            <tr>
                <td>${l.productDesc}</td>
                <td>
                    <div class="bar-cell">
                        <div class="bar-track"><div class="bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}"></div></div>
                        <span style="font-family:'JetBrains Mono',monospace;">${pct(l.oeeShift)}</span>
                    </div>
                </td>
                <td class="num">${l.total.toLocaleString()}</td>
                <td class="num">${l.accumulatedRate.toLocaleString()}</td>
                <td class="num">${l.plannedShift.toLocaleString()}</td>
                <td class="num">${l.totalSap.toLocaleString()}</td>
            </tr>`).join('');
        document.getElementById('drilldownBody').innerHTML = rows;
    }

    document.getElementById('closeDrilldown').onclick = () => selectFurnace(selectedFurnaceId);
    document.getElementById('drilldownOverlay').onclick = (e) => {
        if (e.target.id === 'drilldownOverlay') selectFurnace(selectedFurnaceId);
    };

    // ---------------------------------------------------------------
    // TEMA / PRESENTACIÓN / SELECTOR DE FECHA
    // ---------------------------------------------------------------
    document.getElementById('toggleTheme').onclick = () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('pm-theme', next);
        Object.values(charts).forEach(c => c && c.destroy());
        for (const k in charts) delete charts[k];
        document.getElementById('grid').innerHTML = '';
        render(false);
    };
    const savedTheme = localStorage.getItem('pm-theme');
    if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

    document.getElementById('togglePresentation').onclick = () => {
        document.getElementById('app').classList.toggle('presentation');
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
            document.exitFullscreen?.().catch(() => {});
        }
        setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 260);
    };

    document.getElementById('toggleDate').onclick = () => {
        document.getElementById('datePicker').classList.toggle('open');
    };

    // ---------------------------------------------------------------
    // SIGNALR: conexión + recepción de actualizaciones en vivo
    // ---------------------------------------------------------------
    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/metrics')
        .withAutomaticReconnect()
        .build();

    connection.on('SnapshotUpdated', (newSnapshot) => {
        snapshot = newSnapshot;
        render(true);
    });

    connection.start().catch(err => console.error('SignalR error:', err));

    render(false);
</script>
</body>
</html>
