@model Metrics_Dashboard.Models.PlantDashboardSnapshot
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Plant Metrics · Dashboard General</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <style>
        :root[data-theme="dark"] {
        --bg: #0a0e15;
        --card: #131a28;
        --card-hover: #1a2338;
        --border: #263652;
        --border-soft: rgba(255,255,255,0.07);
        --text: #f2f5fb;
        --text-dim: #93a4c2;
        --text-faint: #62729a;
        --accent: #55acff;
        --accent-soft: rgba(85,172,255,0.16);
        --good: #3ddb98;
        --warn: #f5c15c;
        --bad: #ff6b78;
        --neutral: #8a99ba;
        --no-plan-bg: rgba(172,138,255,0.14);
        --no-plan-border: #ac8aff;
        --no-plan-text: #d1bfff;
        --grid-line: rgba(255,255,255,0.06);
        --shadow: 0 10px 26px -12px rgba(0,0,0,0.55);
        --flash: rgba(85,172,255,0.38);
        --pill-text: #061018;
        }

        :root[data-theme="light"] {
        --bg: #e7ebf3;
        --card: #ffffff;
        --card-hover: #eef2fa;
        --border: #c3ccdc;
        --border-soft: rgba(16,24,40,0.08);
        --text: #0c1526;
        --text-dim: #46536b;
        --text-faint: #707f9c;
        --accent: #1957c2;
        --accent-soft: rgba(25,87,194,0.11);
        --good: #0e8f57;
        --warn: #96650a;
        --bad: #c22e3e;
        --neutral: #5c6a86;
        --no-plan-bg: rgba(109,40,217,0.09);
        --no-plan-border: #6d28d9;
        --no-plan-text: #5b21b6;
        --grid-line: rgba(16,24,40,0.08);
        --shadow: 0 12px 28px -14px rgba(20,30,60,0.22);
        --flash: rgba(25,87,194,0.16);
        --pill-text: #ffffff;
        }

        * {
        box-sizing: border-box;
        }

        html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        }

        .app {
        height: 100vh;
        width: 100vw;
        display: grid;
        grid-template-rows: auto 1fr;
        gap: clamp(10px, 1vh, 16px);
        padding: clamp(12px, 1.2vh, 20px);
        }

        /* ---------- HEADER ---------- */
        header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: clamp(12px, 1.4vh, 20px) clamp(20px, 1.8vw, 32px);
        box-shadow: var(--shadow);
        }

        .app.presentation .controls-collapsible {
        display: none;
        }

        .brand {
        display: flex;
        align-items: center;
        gap: clamp(10px, 1vw, 16px);
        }

        .brand .logo-dot {
        width: clamp(38px, 3vw, 50px);
        height: clamp(38px, 3vw, 50px);
        border-radius: 12px;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: clamp(.95rem, 1vw, 1.15rem);
        color: #fff;
        flex-shrink: 0;
        }

        .brand-text h1 {
        font-size: clamp(1.35rem, 1.7vw, 1.85rem);
        margin: 0;
        font-weight: 800;
        letter-spacing: .2px;
        }

        .brand-text .subtitle {
        color: var(--text-dim);
        font-size: clamp(.85rem, .95vw, 1.05rem);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 4px;
        font-weight: 600;
        }

        .shift-badge {
        background: var(--accent-soft);
        color: var(--accent);
        border: 1px solid var(--border);
        padding: 3px 12px;
        border-radius: 999px;
        font-size: clamp(.72rem, .82vw, .88rem);
        font-weight: 700;
        letter-spacing: .3px;
        }

        .plant-kpi {
        display: flex;
        align-items: center;
        gap: clamp(20px, 2.6vw, 44px);
        }

        .kpi-block {
        text-align: center;
        min-width: 70px;
        }

        .kpi-block .value {
        font-size: clamp(2.5rem, 3.6vw, 4.1rem);
        font-weight: 800;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        font-family: 'JetBrains Mono', monospace;
        transition: color .3s ease;
        }

        .kpi-block .label {
        font-size: clamp(.68rem, .78vw, .82rem);
        text-transform: uppercase;
        letter-spacing: .7px;
        color: var(--text-faint);
        margin-top: 6px;
        font-weight: 700;
        }

        .kpi-divider {
        width: 1px;
        height: clamp(40px, 4.5vh, 60px);
        background: var(--border);
        }

        .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .btn {
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 10px;
        padding: 10px 16px;
        font-size: clamp(.82rem, .95vw, 1rem);
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: background .15s, border-color .15s;
        }

        .btn:hover {
        background: var(--card-hover);
        border-color: var(--accent);
        }

        .date-picker {
        display: none;
        align-items: center;
        gap: 6px;
        }

        .date-picker.open {
        display: flex;
        }

        .date-picker input {
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: .95rem;
        }

        /* ---------- GRID DE HORNOS (proporcional siempre, también en presentación) ---------- */
        .grid-main {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: clamp(10px, 1vw, 16px);
        min-height: 0;
        }

        .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: clamp(16px, 1.6vw, 24px) clamp(18px, 1.8vw, 26px);
        display: flex;
        flex-direction: column;
        min-height: 0;
        cursor: pointer;
        box-shadow: var(--shadow);
        transition: transform .12s ease, border-color .12s ease, background .12s ease;
        position: relative;
        overflow: hidden;
        }

        .card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: var(--furnace-color, var(--accent));
        }

        .card:hover {
        transform: translateY(-2px);
        border-color: var(--furnace-color, var(--accent));
        }

        .card.selected {
        border-color: var(--furnace-color, var(--accent));
        background: var(--card-hover);
        box-shadow: 0 0 0 2px var(--furnace-color, var(--accent));
        }

        .card.dimmed {
        opacity: .32;
        }

        .card.flash {
        animation: flashUpdate 900ms ease;
        }

        @@keyframes flashUpdate {
        0% {
        box-shadow: 0 0 0 3px var(--flash);
        }

        100% {
        box-shadow: var(--shadow);
        }
        }

        .furnace-card .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        }

        .furnace-card h2 {
        font-size: clamp(1.15rem, 1.4vw, 1.55rem);
        margin: 0;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        }

        .furnace-card h2 .fnum {
        width: clamp(26px, 2vw, 32px);
        height: clamp(26px, 2vw, 32px);
        border-radius: 8px;
        background: var(--furnace-color, var(--accent));
        color: #06101f;
        font-size: clamp(.82rem, .95vw, 1rem);
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        }

        .furnace-card h2 .fname {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        }

        .detail-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: clamp(26px, 2vw, 32px);
        height: clamp(26px, 2vw, 32px);
        border-radius: 8px;
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text-faint);
        text-decoration: none;
        transition: background .15s, color .15s, border-color .15s;
        }

        .detail-link svg {
        width: 60%;
        height: 60%;
        }

        .detail-link:hover {
        background: var(--furnace-color, var(--accent));
        color: #06101f;
        border-color: transparent;
        }

        .oee-block {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 3px;
        flex-shrink: 0;
        }

        .furnace-card .oee-pill {
        font-size: clamp(1.1rem, 1.4vw, 1.55rem);
        font-weight: 800;
        padding: 5px 16px;
        border-radius: 999px;
        color: var(--pill-text);
        font-family: 'JetBrains Mono', monospace;
        text-shadow: 0 1px 2px rgba(0,0,0,.2);
        }

        .oee-caption {
        font-size: clamp(.62rem, .72vw, .78rem);
        color: var(--text-faint);
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 700;
        }

        .furnace-card .numbers {
        display: flex;
        gap: clamp(16px, 2vw, 30px);
        margin-top: clamp(10px, 1.2vh, 16px);
        }

        .furnace-card .numbers .n .v {
        font-size: clamp(1.5rem, 2vw, 2.3rem);
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        font-variant-numeric: tabular-nums;
        }

        .furnace-card .numbers .n .l {
        font-size: clamp(.62rem, .72vw, .78rem);
        color: var(--text-faint);
        text-transform: uppercase;
        letter-spacing: .5px;
        font-weight: 700;
        margin-top: 3px;
        }

        .furnace-card .chart-wrap {
        flex: 1;
        min-height: 0;
        margin-top: clamp(8px, 1vh, 14px);
        position: relative;
        }

        .furnace-card .worst-line {
        margin-top: clamp(8px, 1vh, 12px);
        font-size: clamp(.78rem, .9vw, .95rem);
        color: var(--text-dim);
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--border-soft);
        padding-top: 10px;
        }

        .furnace-card .worst-line b {
        color: var(--bad);
        font-family: 'JetBrains Mono', monospace;
        }

        .no-plan-box {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: var(--no-plan-bg);
        border: 2px dashed var(--no-plan-border);
        border-radius: 12px;
        color: var(--no-plan-text);
        font-size: clamp(1rem, 1.2vw, 1.3rem);
        font-weight: 800;
        letter-spacing: .3px;
        padding: 10px;
        margin-top: 8px;
        line-height: 1.4;
        }

        .trend-card {
        display: flex;
        flex-direction: column;
        }

        .trend-card h2 {
        font-size: clamp(1.15rem, 1.4vw, 1.55rem);
        margin: 0 0 10px 0;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: space-between;
        }

        .trend-card h2 .hint {
        font-size: clamp(.68rem, .8vw, .85rem);
        font-weight: 600;
        color: var(--text-faint);
        }

        .trend-card .chart-wrap {
        flex: 1;
        min-height: 0;
        }

        /* ---------- PANEL DE DRILL-DOWN (cross-filter) ---------- */
        .drilldown-overlay {
        position: fixed;
        inset: 0;
        background: rgba(4,7,14,.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 50;
        }

        .drilldown-overlay.open {
        display: flex;
        }

        .drilldown-panel {
        width: min(1040px, 92vw);
        max-height: 84vh;
        overflow: auto;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 26px 28px;
        box-shadow: var(--shadow);
        }

        .drilldown-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        }

        .drilldown-panel h3 {
        margin: 0 0 8px 0;
        font-size: 1.35rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .drilldown-chips {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        }

        .chip {
        background: var(--accent-soft);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 6px 13px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        }

        table.lines-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .92rem;
        margin-top: 8px;
        }

        table.lines-table th, table.lines-table td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border-soft);
        }

        table.lines-table th {
        color: var(--text-faint);
        font-weight: 800;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        }

        table.lines-table tbody tr:hover {
        background: var(--card-hover);
        }

        table.lines-table td.num {
        font-family: 'JetBrains Mono', monospace;
        font-variant-numeric: tabular-nums;
        }

        .bar-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .bar-track {
        flex: 1;
        height: 8px;
        border-radius: 4px;
        background: var(--grid-line);
        overflow: hidden;
        }

        .bar-fill {
        height: 100%;
        border-radius: 4px;
        }

        .close-btn {
        flex-shrink: 0;
        }

        tr.no-prod-row td {
        color: var(--no-plan-text);
        }

        .no-prod-tag {
        background: var(--no-plan-bg);
        border: 1px solid var(--no-plan-border);
        color: var(--no-plan-text);
        padding: 4px 11px;
        border-radius: 6px;
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .3px;
        display: inline-block;
        }

        .sap-excluded {
        color: var(--text-faint);
        font-weight: 600;
        }

        .line-link {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dashed var(--border);
        }

        .line-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
        }

        .page-ring-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 8px;
        height: 18px;
        }

        .page-ring-svg {
        width: 18px;
        height: 18px;
        transform: rotate(-90deg);
        flex-shrink: 0;
        }

        .ring-bg {
        fill: none;
        stroke: var(--border);
        stroke-width: 2.5;
        }

        .ring-fill {
        fill: none;
        stroke: var(--furnace-color, var(--accent));
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-dasharray: 44;
        stroke-dashoffset: 44;
        }

        .ring-fill.animating {
        animation: ringFill 15s linear forwards;
        }

        @@keyframes ringFill {
        to {
        stroke-dashoffset: 0;
        }
        }

        .page-ring-label {
        font-size: .72rem;
        color: var(--text-faint);
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        }

        .live-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--good);
        box-shadow: 0 0 0 0 rgba(61,219,152,.6);
        animation: pulse 1.8s infinite;
        }

        @@keyframes pulse {
        0% {
        box-shadow: 0 0 0 0 rgba(61,219,152,.55);
        }

        70% {
        box-shadow: 0 0 0 9px rgba(61,219,152,0);
        }

        100% {
        box-shadow: 0 0 0 0 rgba(61,219,152,0);
        }
        }
    </style>
</head>
<body>
    <div class="app" id="app">

        <header>
            <div class="brand">
                <img src="~/images/m2s.png" style="width: 60px;" />
                <div class="brand-text">
                    <h1><img src="~/images/MAHLE-Logo.png" style="width: 80px; margin:20px,0,0,0" /> · Planta 1</h1>
                    <div class="subtitle">
                        <span id="dateLabel"></span>
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                    </div>
                </div>
            </div>

            <div class="plant-kpi">
                <div class="kpi-block">
                    <div class="value" id="plantOee">@Model.PlantOee.ToString("P0")</div>
                    <div class="label">OEE Planta (turno actual)</div>
                </div>
                <div class="kpi-divider"></div>
                <div class="kpi-block">
                    <div class="value" id="plantProd">@Model.TotalProduction.ToString("N0")</div>
                    <div class="label">Producción</div>
                </div>
                <div class="kpi-divider"></div>
                <div class="kpi-block">
                    <div class="value" id="plantPlanned">@Model.TotalPlanned.ToString("N0")</div>
                    <div class="label">Plan de Turno</div>
                </div>
                <div class="kpi-divider"></div>
                <div class="kpi-block">
                    <div style="display:flex;align-items:center;gap:6px;justify-content:center;">
                        <span class="live-dot"></span>
                        <span class="value" style="font-size:.88rem" id="lastUpdate">--:--</span>
                    </div>
                    <div class="label">Última Actualización</div>
                </div>
            </div>

            <div class="header-actions controls-collapsible">
                <div class="date-picker" id="datePicker">
                    <input type="date" id="dateInput" />
                </div>
                <button class="btn" id="toggleDate">📅</button>
                <button class="btn" id="toggleTheme">🌗</button>
                <button class="btn" id="togglePresentation">🖥️</button>
            </div>
        </header>

        <div class="grid-main" id="grid"></div>
    </div>

    <div class="drilldown-overlay" id="drilldownOverlay">
        <div class="drilldown-panel">
            <div class="drilldown-head">
                <div>
                    <h3 id="drilldownTitle">Horno</h3>
                    <div class="drilldown-chips" id="drilldownChips"></div>
                </div>
                <button class="btn close-btn" id="closeDrilldown">Cerrar ✕</button>
            </div>
            <table class="lines-table">
                <thead>
                    <tr><th>Línea</th><th>OEE Turno</th><th>Producción</th><th>Esperado a esta hora</th><th>Plan Turno</th><th>SAP</th></tr>
                </thead>
                <tbody id="drilldownBody"></tbody>
            </table>
        </div>
    </div>

    <script>
        // ---------------------------------------------------------------
        // Estado inicial servido por el servidor (primer render, sin esperar SignalR)
        // ---------------------------------------------------------------
        let snapshot = @Html.Raw(Json.Serialize(Model));
        let selectedFurnaceId = null;
        const charts = {};
        const furnacePage = {}; // furnaceId -> índice de página actual (carrusel de 5 en 5, cada 15s)
        const PAGE_SIZE = 5;
        const PAGE_ROTATE_MS = 15000;
        const FURNACE_COLORS = ['#4da3ff', '#35d68f', '#f2b84b', '#c084fc', '#ff8a5c'];

        // Semáforo de OEE: >=85% verde, 70-85% amarillo, <70% rojo. Aplica a plantas, hornos y líneas.
        function oeeColor(oee) {
        if (oee >= 0.85) return getCss('--good');
        if (oee >= 0.70) return getCss('--warn');
        return getCss('--bad');
        }
        function furnaceColor(id) { return FURNACE_COLORS[(id - 1) % FURNACE_COLORS.length]; }
        function getCss(varName) { return getComputedStyle(document.documentElement).getPropertyValue(varName).trim(); }
        function hexToRgba(hex, alpha) {
        const h = hex.replace('#', '');
        const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
        const r = (bigint >> 16) & 255, g = (bigint >> 8) & 255, b = bigint & 255;
        return `rgba(${r},${g},${b},${alpha})`;
        }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }

        // Solo las líneas CON plan cuentan para el mini-chart de cada card (las líneas sin
        // plan solo se muestran en el detalle/modal, no aquí — ver countedLines()).
        function countedLines(f) { return f.lines.filter(l => l.plannedShift > 0); }

        // Carrusel tipo pantalla de aeropuerto: pagina las líneas de 5 en 5, ordenadas por Product_Order.
        function furnaceLinesPage(f) {
        const sorted = [...countedLines(f)].sort((a, b) => a.productOrder - b.productOrder);
        const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
        const idx = (furnacePage[f.furnaceId] || 0) % totalPages;
        return { page: sorted.slice(idx * PAGE_SIZE, idx * PAGE_SIZE + PAGE_SIZE), totalPages, idx };
        }

        // Anillo de progreso: se llena en 15s y al completar la vuelta coincide con el cambio de página.
        function renderPageRing(f) {
        const container = document.getElementById('pagering-' + f.furnaceId);
        if (!container) return;
        const { totalPages, idx } = furnaceLinesPage(f);
        if (totalPages <= 1) { container.innerHTML = ''; return; }

        let ring = document.getElementById('ringfill-' + f.furnaceId);
        if (!ring) {
        container.innerHTML = `
        <svg class="page-ring-svg" viewBox="0 0 16 16">
        <circle class="ring-bg" cx="8" cy="8" r="7"></circle>
        <circle class="ring-fill" id="ringfill-${f.furnaceId}" cx="8" cy="8" r="7"></circle>
        </svg>
        <span class="page-ring-label" id="pagelabel-${f.furnaceId}"></span>
        `;
        ring = document.getElementById('ringfill-' + f.furnaceId);
        }
        document.getElementById('pagelabel-' + f.furnaceId).textContent = `${idx + 1}/${totalPages}`;
        restartRing(ring);
        }

        function restartRing(ring) {
        ring.classList.remove('animating');
        void ring.getBoundingClientRect(); // fuerza reflow para poder reiniciar la animación
        ring.classList.add('animating');
        }

        document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

        // ---------------------------------------------------------------
        // RENDER
        // ---------------------------------------------------------------
        function render(isLiveUpdate) {
        const plantOeeEl = document.getElementById('plantOee');
        plantOeeEl.textContent = pct(snapshot.plantOee);
        plantOeeEl.style.color = oeeColor(snapshot.plantOee);

        document.getElementById('plantProd').textContent = snapshot.totalProduction.toLocaleString();
        document.getElementById('plantPlanned').textContent = snapshot.totalPlanned.toLocaleString();
        document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
        document.getElementById('lastUpdate').textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

        const grid = document.getElementById('grid');
        const isFirstRender = grid.children.length === 0;

        if (isFirstRender) {
        grid.innerHTML = '';
        snapshot.furnaces.forEach(f => grid.appendChild(buildFurnaceCard(f)));
        grid.appendChild(buildTrendCard());
        } else {
        snapshot.furnaces.forEach(f => updateFurnaceCard(f, isLiveUpdate));
        updateTrendChart();
        }
        applySelection();
        }

        function buildFurnaceCard(f) {
        const div = document.createElement('div');
        div.className = 'card furnace-card';
        div.id = 'furnace-' + f.furnaceId;
        div.style.setProperty('--furnace-color', furnaceColor(f.furnaceId));
        div.onclick = () => selectFurnace(f.furnaceId);

        const hasProduction = countedLines(f).length > 0;

        div.innerHTML = `
        <div class="card-top">
        <h2>
        <span class="fnum">${f.furnaceId}</span><span class="fname">${f.furnaceName}</span>
        <a class="detail-link" href="/Furnace${f.furnaceId}" onclick="event.stopPropagation()" title="Ver detalle de ${f.furnaceName}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" width="11" height="11"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
        </a>
        </h2>
        <div class="oee-block">
        <span class="oee-pill ${hasProduction ? '' : 'neutral'}" id="pill-${f.furnaceId}"
        style="background:${hasProduction ? oeeColor(f.oee) : 'var(--neutral)'}">${hasProduction ? pct(f.oee) : '—'}</span>
        <span class="oee-caption">OEE de Turno</span>
        </div>
        </div>
        <div class="numbers">
        <div class="n"><div class="v" id="prod-${f.furnaceId}">${f.totalProduction.toLocaleString()}</div><div class="l">Producción</div></div>
        <div class="n"><div class="v" id="plan-${f.furnaceId}">${f.totalPlanned.toLocaleString()}</div><div class="l">Plan Turno</div></div>
        <div class="n"><div class="v" id="sap-${f.furnaceId}">${pct(f.sapPercent)}</div><div class="l">SAP %</div></div>
        </div>
        <div class="chart-wrap" id="chartwrap-${f.furnaceId}">
        ${hasProduction ? `<canvas id="chart-${f.furnaceId}"></canvas>` : `<div class="no-plan-box">SIN PRODUCCIÓN<br>EN EL TURNO ACTUAL</div>`}
        </div>
        <div class="page-ring-wrap" id="pagering-${f.furnaceId}"></div>
        <div class="worst-line" id="worst-${f.furnaceId}"></div>
        `;
        if (hasProduction) {
        setTimeout(() => {
        charts['f' + f.furnaceId] = new Chart(document.getElementById('chart-' + f.furnaceId), lineBarConfig(f));
        renderWorstLine(f);
        renderPageRing(f);
        }, 0);
        }
        return div;
        }

        // Plugin ligero (sin librerías extra) que dibuja, sobre cada barra:
        // - el % de OEE "dentro" de la barra (con contorno para leerse en cualquier color/tema)
        // - Producción/Esperado a esta hora pegado a la derecha de la barra
        const barLabelsPlugin = {
        id: 'lineBarLabels',
        afterDatasetsDraw(chart) {
        const dataset = chart.data.datasets[0];
        const lines = dataset && dataset.linesRef;
        if (!lines) return;
        const meta = chart.getDatasetMeta(0);
        const ctx = chart.ctx;
        ctx.save();
        meta.data.forEach((bar, i) => {
        const line = lines[i];
        if (!line || !bar) return;
        const barLeft = Math.min(bar.x, bar.base);
        const barRight = Math.max(bar.x, bar.base);
        const y = bar.y;

        const oeeLabel = Math.round(line.oeeShift * 100) + '%';
        ctx.font = '800 15px Inter, sans-serif';
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'left';
        ctx.lineWidth = 3.5;
        ctx.strokeStyle = 'rgba(0,0,0,0.55)';
        ctx.strokeText(oeeLabel, barLeft + 8, y);
        ctx.fillStyle = '#ffffff';
        ctx.fillText(oeeLabel, barLeft + 8, y);

        ctx.font = '700 13px "JetBrains Mono", monospace';
        ctx.fillStyle = getCss('--text-dim');
        ctx.fillText(`${line.total}/${line.accumulatedRate}`, barRight + 8, y);
        });
        ctx.restore();
        }
        };

        function lineBarConfig(f) {
        const top = furnaceLinesPage(f).page;
        return {
        type: 'bar',
        data: {
        labels: top.map(l => l.productDesc.replace('PTC ', '')),
        datasets: [{
        data: top.map(l => l.oeeShift * 100),
        backgroundColor: top.map(l => oeeColor(l.oeeShift)),
        borderRadius: 7,
        maxBarThickness: 26,
        linesRef: top
        }]
        },
        plugins: [barLabelsPlugin],
        options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 500 },
        layout: { padding: { right: 78 } },
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.raw.toFixed(0) + '% OEE de turno' } } },
        scales: {
        x: { min: 0, suggestedMax: 100, ticks: { display: false }, grid: { color: getCss('--grid-line') } },
        y: { ticks: { color: getCss('--text-dim'), font: { size: 15, weight: '600' } }, grid: { display: false } }
        }
        }
        };
        }

        function renderWorstLine(f) {
        const el = document.getElementById('worst-' + f.furnaceId);
        if (!el) return;
        if (f.worstLine) {
        el.innerHTML = `<span>⚠ Línea más baja: ${f.worstLine.productDesc}</span><b>${pct(f.worstLine.oeeShift)}</b>`;
        } else {
        el.innerHTML = '';
        }
        }

        function updateFurnaceCard(f, isLiveUpdate) {
        const card = document.getElementById('furnace-' + f.furnaceId);
        const pill = document.getElementById('pill-' + f.furnaceId);
        if (!card || !pill) return;

        const hasProduction = countedLines(f).length > 0;
        const prodChanged = document.getElementById('prod-' + f.furnaceId).textContent !== f.totalProduction.toLocaleString();

        pill.textContent = hasProduction ? pct(f.oee) : '—';
        pill.style.background = hasProduction ? oeeColor(f.oee) : 'var(--neutral)';
        pill.classList.toggle('neutral', !hasProduction);
        document.getElementById('prod-' + f.furnaceId).textContent = f.totalProduction.toLocaleString();
        document.getElementById('plan-' + f.furnaceId).textContent = f.totalPlanned.toLocaleString();
        document.getElementById('sap-' + f.furnaceId).textContent = pct(f.sapPercent);
        renderWorstLine(f);

        const wrap = document.getElementById('chartwrap-' + f.furnaceId);
        const hasCanvas = !!document.getElementById('chart-' + f.furnaceId);

        if (hasProduction && !hasCanvas) {
        wrap.innerHTML = `<canvas id="chart-${f.furnaceId}"></canvas>`;
        charts['f' + f.furnaceId] = new Chart(document.getElementById('chart-' + f.furnaceId), lineBarConfig(f));
        renderPageRing(f); // primera vez que aparece la gráfica -> arranca el anillo
        } else if (!hasProduction && hasCanvas) {
        charts['f' + f.furnaceId]?.destroy();
        delete charts['f' + f.furnaceId];
        wrap.innerHTML = `<div class="no-plan-box">SIN PRODUCCIÓN<br>EN EL TURNO ACTUAL</div>`;
        document.getElementById('pagering-' + f.furnaceId).innerHTML = '';
        } else if (hasProduction && hasCanvas) {
        // Solo se actualizan los datos de la barra; el anillo NO se reinicia aquí,
        // así el conteo de 15s sigue su curso normal aunque llegue un refresh de datos.
        const chart = charts['f' + f.furnaceId];
        const cfg = lineBarConfig(f);
        chart.data = cfg.data;
        chart.update('none');
        const label = document.getElementById('pagelabel-' + f.furnaceId);
        if (label) {
        const { totalPages, idx } = furnaceLinesPage(f);
        label.textContent = totalPages > 1 ? `${idx + 1}/${totalPages}` : '';
        }
        }

        if (isLiveUpdate && prodChanged) {
        card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash');
        }
        if (selectedFurnaceId === f.furnaceId) renderDrilldown(f);
        }

        function buildTrendCard() {
        const div = document.createElement('div');
        div.className = 'card trend-card';
        div.innerHTML = `<h2>Tendencia de Planta <span class="hint">Producción por hora + acumulado del turno</span></h2><div class="chart-wrap"><canvas id="chart-trend"></canvas></div>`;
        setTimeout(() => { charts['trend'] = new Chart(document.getElementById('chart-trend'), trendConfig()); }, 0);
        return div;
        }

        function cumulativeSeries() {
        let running = 0;
        return snapshot.hourlyTrend.map(h => (running += h.production));
        }

        function trendConfig() {
        return {
        data: {
        labels: snapshot.hourlyTrend.map(h => h.hour),
        datasets: [
        {
        type: 'bar', label: 'Producción / hora',
        data: snapshot.hourlyTrend.map(h => h.production),
        backgroundColor: hexToRgba(getCss('--accent'), .55),
        borderRadius: 6, maxBarThickness: 40, yAxisID: 'y', order: 2
        },
        {
        type: 'line', label: 'Acumulado del turno',
        data: cumulativeSeries(),
        borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .12),
        fill: true, tension: .35, pointRadius: 3, pointBackgroundColor: getCss('--good'),
        yAxisID: 'y1', order: 1
        }
        ]
        },
        options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        animation: { duration: 500 },
        plugins: { legend: { labels: { color: getCss('--text-dim'), font: { size: 14, weight: '600' }, boxWidth: 14 } } },
        scales: {
        x: { ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { color: getCss('--grid-line') } },
        y: {
        position: 'left', beginAtZero: true,
        ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { color: getCss('--grid-line') },
        title: { display: true, text: 'Piezas / hora', color: getCss('--text-faint'), font: { size: 13, weight: '600' } }
        },
        y1: {
        position: 'right', beginAtZero: true,
        ticks: { color: getCss('--text-dim'), font: { size: 13 } }, grid: { display: false },
        title: { display: true, text: 'Acumulado del turno', color: getCss('--text-faint'), font: { size: 13, weight: '600' } }
        }
        }
        }
        };
        }

        function updateTrendChart() {
        const chart = charts['trend'];
        if (!chart) return;
        chart.data.labels = snapshot.hourlyTrend.map(h => h.hour);
        chart.data.datasets[0].data = snapshot.hourlyTrend.map(h => h.production);
        chart.data.datasets[1].data = cumulativeSeries();
        chart.update('none');
        }

        // ---------------------------------------------------------------
        // CROSS-FILTER: clic en un horno -> dimear los demás + abrir drill-down con TODAS sus líneas
        // ---------------------------------------------------------------
        function selectFurnace(id) {
        selectedFurnaceId = (selectedFurnaceId === id) ? null : id;
        applySelection();
        if (selectedFurnaceId) {
        const f = snapshot.furnaces.find(x => x.furnaceId === selectedFurnaceId);
        renderDrilldown(f);
        document.getElementById('drilldownOverlay').classList.add('open');
        } else {
        document.getElementById('drilldownOverlay').classList.remove('open');
        }
        }

        function applySelection() {
        snapshot.furnaces.forEach(f => {
        const card = document.getElementById('furnace-' + f.furnaceId);
        if (!card) return;
        card.classList.toggle('selected', selectedFurnaceId === f.furnaceId);
        card.classList.toggle('dimmed', selectedFurnaceId !== null && selectedFurnaceId !== f.furnaceId);
        });
        }

        function renderDrilldown(f) {
        if (!f) return;
        document.getElementById('drilldownTitle').innerHTML =
        `<span class="fnum" style="display:inline-flex;width:22px;height:22px;border-radius:7px;background:${furnaceColor(f.furnaceId)};color:#06101f;align-items:center;justify-content:center;font-size:.75rem;">${f.furnaceId}</span> ${f.furnaceName}`;

        if (f.lines.length === 0) {
        document.getElementById('drilldownChips').innerHTML = `<span class="chip">Sin producción planeada en el turno actual</span>`;
        document.getElementById('drilldownBody').innerHTML = '';
        return;
        }

        document.getElementById('drilldownChips').innerHTML = `
        <span class="chip">Producción: ${f.totalProduction.toLocaleString()}</span>
        <span class="chip">Plan: ${f.totalPlanned.toLocaleString()}</span>
        <span class="chip">OEE: ${pct(f.oee)}</span>
        <span class="chip">SAP: ${pct(f.sapPercent)}</span>
        <span class="chip">${f.lines.length} líneas</span>
        `;
        const rows = [...f.lines].sort((a, b) => a.productOrder - b.productOrder).map(l => {
        const sapCell = l.excludedFromSap
        ? `<span class="sap-excluded">-</span>`
        : (l.total === 0 ? '0' : l.totalSap.toLocaleString());
        const nameCell = l.productListId > 0
        ? `<a href="/Line/${l.productListId}" class="line-link" title="Ver TV de esta línea">${l.productDesc}</a>`
        : l.productDesc;
        if (l.total === 0) {
        return `
        <tr class="no-prod-row">
        <td>${nameCell}</td>
        <td><span class="no-prod-tag">LÍNEA SIN PRODUCCIÓN</span></td>
        <td class="num">0</td>
        <td class="num">${l.accumulatedRate.toLocaleString()}</td>
        <td class="num">${l.plannedShift.toLocaleString()}</td>
        <td class="num">${sapCell}</td>
        </tr>`;
        }
        return `
        <tr>
        <td>${nameCell}</td>
        <td>
        <div class="bar-cell">
        <div class="bar-track"><div class="bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%; background:${oeeColor(l.oeeShift)}"></div></div>
        <span style="font-family:'JetBrains Mono',monospace;">${pct(l.oeeShift)}</span>
        </div>
        </td>
        <td class="num">${l.total.toLocaleString()}</td>
        <td class="num">${l.accumulatedRate.toLocaleString()}</td>
        <td class="num">${l.plannedShift.toLocaleString()}</td>
        <td class="num">${sapCell}</td>
        </tr>`;
        }).join('');
        document.getElementById('drilldownBody').innerHTML = rows;
        }

        document.getElementById('closeDrilldown').onclick = () => selectFurnace(selectedFurnaceId);
        document.getElementById('drilldownOverlay').onclick = (e) => {
        if (e.target.id === 'drilldownOverlay') selectFurnace(selectedFurnaceId);
        };

        // ---------------------------------------------------------------
        // TEMA / PRESENTACIÓN / SELECTOR DE FECHA
        // ---------------------------------------------------------------
        document.getElementById('toggleTheme').onclick = () => {
        const html = document.documentElement;
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('pm-theme', next);
        Object.values(charts).forEach(c => c && c.destroy());
        for (const k in charts) delete charts[k];
        document.getElementById('grid').innerHTML = '';
        render(false);
        };
        const savedTheme = localStorage.getItem('pm-theme');
        if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);

        document.getElementById('togglePresentation').onclick = () => {
        document.getElementById('app').classList.toggle('presentation');
        if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen?.().catch(() => {});
        } else {
        document.exitFullscreen?.().catch(() => {});
        }
        setTimeout(() => Object.values(charts).forEach(c => c && c.resize()), 260);
        };

        document.getElementById('toggleDate').onclick = () => {
        document.getElementById('datePicker').classList.toggle('open');
        };

        // ---------------------------------------------------------------
        // CARRUSEL: cada 15s avanza a la siguiente página de líneas por horno
        // (como los monitores de vuelos en un aeropuerto), sin esperar al refresh de datos.
        // ---------------------------------------------------------------
        setInterval(() => {
        snapshot.furnaces.forEach(f => {
        const { totalPages } = furnaceLinesPage(f);
        if (totalPages <= 1) return;
        furnacePage[f.furnaceId] = ((furnacePage[f.furnaceId] || 0) + 1) % totalPages;
        const chart = charts['f' + f.furnaceId];
        if (chart) {
        chart.data = lineBarConfig(f).data;
        // el anillo se reinicia justo aquí, en el mismo instante del cambio de página
        chart.update('none');
        }
        renderPageRing(f);
        });
        }, PAGE_ROTATE_MS);

        // ---------------------------------------------------------------
        // SIGNALR: conexión + recepción de actualizaciones en vivo
        // ---------------------------------------------------------------
        const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/metrics')
        .withAutomaticReconnect()
        .build();

        connection.on('SnapshotUpdated', (newSnapshot) => {
        snapshot = newSnapshot;
        render(true);
        });

        connection.start().catch(err => console.error('SignalR error:', err));

        render(false);
    </script>
</body>
</html>
