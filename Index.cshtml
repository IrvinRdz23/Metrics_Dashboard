@model Metrics_Dashboard.Models.PlantDashboardSnapshot
@{
    Layout = null;
    var shifts = (ViewData["Shifts"] as List<ShiftInfo>) ?? new List<ShiftInfo>();
    var histDate = Model.HistoricalDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.PlantName · Dashboard General</title>
    <script>
        try { var t = localStorage.getItem('pm-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="/css/site.css" />
    <script src="/lib/signalr.min.js"></script>
    <script src="/lib/chart.umd.min.js"></script>
</head>
<body>
    <div class="app" id="app">

        <header>
            <div class="brand">
                <img src="/images/m2s.png" alt="" onerror="this.style.display='none'" />
                <div class="brand-text">
                    <h1>
                        <img src="/images/MAHLE-Logo.png" alt="MAHLE" style="height:26px" onerror="this.style.display='none'" />
                        <span>· @Model.PlantName</span>
                        @if (Model.IsHistorical)
                        {
                            <span class="hist-badge">HISTÓRICO</span>
                        }
                    </h1>
                    <div class="subtitle">
                        <span id="dateLabel"></span>
                        <span class="shift-badge" id="shiftLabel">@Model.ShiftDesc</span>
                    </div>
                </div>
            </div>

            <div class="plant-kpi">
                <div class="kpi-block">
                    <div class="value" id="plantOee">@Model.PlantOee.ToString("P0")</div>
                    <div class="label">OEE Planta</div>
                </div>
                <div class="kpi-divider"></div>
                <div class="kpi-block">
                    <div class="value" id="plantProd">@Model.TotalProduction.ToString("N0")</div>
                    <div class="label">Producción</div>
                </div>
                <div class="kpi-divider"></div>
                <div class="kpi-block">
                    <div class="value" id="plantPlanned">@Model.TotalPlanned.ToString("N0")</div>
                    <div class="label">Plan de Turno</div>
                </div>
                @if (!Model.IsHistorical)
                {
                    <div class="kpi-divider"></div>
                    <div class="kpi-block">
                        <div style="display:flex;align-items:center;gap:6px;justify-content:center;">
                            <span class="live-dot"></span>
                            <span class="value" style="font-size:.95rem" id="lastUpdate">--:--</span>
                        </div>
                        <div class="label">Última Actualización</div>
                    </div>
                }
            </div>

            <div class="header-actions controls-collapsible">
                @if (Model.IsHistorical)
                {
                    <div class="picker">
                        <input type="date" id="dateInput" value="@histDate" />
                        <select id="shiftSelect">
                            @foreach (var s in shifts)
                            {
                                <option value="@s.ShiftId" selected="@(s.ShiftId == Model.HistoricalShiftId)">@s.ShiftDesc</option>
                            }
                        </select>
                    </div>
                    <a class="btn" href="/">● En vivo</a>
                }
                else
                {
                    <a class="btn" href="/Historical" title="Ver turnos anteriores">🕘 Histórico</a>
                }
                <button class="btn" id="toggleTheme" title="Tema claro / oscuro">🌗</button>
                <button class="btn" id="togglePresentation" title="Modo presentación">🖥️</button>
            </div>
        </header>

        <div class="viewport">
            <button class="ghost ghost-right show" id="goTrends" title="Ver tendencias">›</button>
            <button class="ghost ghost-left" id="goGrid" title="Volver a los grupos">‹</button>
            <div class="track" id="track">
                <section class="screen"><div class="grid-2x2" id="grid"></div></section>
                <section class="screen"><div class="grid-2x2" id="trendGrid"></div></section>
            </div>
        </div>
    </div>

    <div class="drilldown-overlay" id="drilldownOverlay">
        <div class="drilldown-panel">
            <div class="drilldown-head">
                <div>
                    <h3 id="drilldownTitle">Grupo</h3>
                    <div class="chips" id="drilldownChips"></div>
                </div>
                <button class="btn" id="closeDrilldown">Cerrar ✕</button>
            </div>
            <table class="lines-table">
                <thead>
                    <tr><th>Línea</th><th>OEE Turno</th><th>Producción</th><th>Esperado a esta hora</th><th>Plan Turno</th><th>SAP</th></tr>
                </thead>
                <tbody id="drilldownBody"></tbody>
            </table>
        </div>
    </div>

    <script>
        // ---------------------------------------------------------------
        // Estado inicial servido por el servidor (primer render, sin esperar SignalR)
        // ---------------------------------------------------------------
        let snapshot = @Html.Raw(Json.Serialize(Model));
        const IS_HIST = snapshot.isHistorical === true;
        // En histórico, todos los links a detalle conservan fecha + turno.
        const HIST_QS = IS_HIST ? `?date=${String(snapshot.historicalDate).slice(0, 10)}&shiftId=${snapshot.historicalShiftId}` : '';
        const GROUP_COLORS = ['#4da3ff', '#35d68f', '#f2b84b', '#c084fc'];
        const PAGE_SIZE = 5;
        const PAGE_ROTATE_MS = 15000;

        const charts = {};       // 'g<id>' -> barras de líneas dentro de la card
        const trendCharts = {};  // 'g<id>' -> tendencia hora por hora
        const groupPage = {};    // groupId -> página actual del carrusel de líneas
        let selectedGroupId = null;
        let currentScreen = 0;

        // ---------- helpers ----------
        function getCss(v) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
        function oeeColor(oee) { return oee >= 0.85 ? getCss('--good') : (oee >= 0.70 ? getCss('--warn') : getCss('--bad')); }
        function pct(v) { return (v * 100).toFixed(0) + '%'; }
        function fmt(n) { return Number(n || 0).toLocaleString(); }
        function groupColor(g) { return GROUP_COLORS[g.colorIndex % GROUP_COLORS.length]; }
        function shortName(d) { return String(d || '').replace(/^PTC\s+/i, ''); }
        function hexToRgba(hex, a) {
            const h = hex.replace('#', '');
            const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
            return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
        }
        // Solo las líneas que cuentan (plan > 0, o lo que diga Heijunka cuando esté encendido).
        function countedLines(g) { return g.lines.filter(l => l.countsForStats); }

        function linesPage(g) {
            const sorted = [...countedLines(g)].sort((a, b) => a.productOrder - b.productOrder);
            const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
            const idx = (groupPage[g.groupId] || 0) % totalPages;
            return { page: sorted.slice(idx * PAGE_SIZE, idx * PAGE_SIZE + PAGE_SIZE), totalPages, idx };
        }

        // ---------- anillo de página ----------
        function renderPageRing(g) {
            const box = document.getElementById('pagering-' + g.groupId);
            if (!box) return;
            const { totalPages, idx } = linesPage(g);
            if (totalPages <= 1) { box.innerHTML = ''; return; }
            let ring = document.getElementById('ringfill-' + g.groupId);
            if (!ring) {
                box.innerHTML = `<svg class="page-ring-svg" viewBox="0 0 16 16"><circle class="ring-bg" cx="8" cy="8" r="7"></circle><circle class="ring-fill" id="ringfill-${g.groupId}" cx="8" cy="8" r="7"></circle></svg><span class="page-ring-label" id="pagelabel-${g.groupId}"></span>`;
                ring = document.getElementById('ringfill-' + g.groupId);
            }
            document.getElementById('pagelabel-' + g.groupId).textContent = `${idx + 1}/${totalPages}`;
            ring.classList.remove('animating');
            void ring.getBoundingClientRect();
            ring.classList.add('animating');
        }

        // ---------- barras de líneas dentro de la card ----------
        const barLabelsPlugin = {
            id: 'lineBarLabels',
            afterDatasetsDraw(chart) {
                const ds = chart.data.datasets[0];
                const lines = ds && ds.linesRef;
                if (!lines) return;
                const meta = chart.getDatasetMeta(0);
                const ctx = chart.ctx;
                ctx.save();
                meta.data.forEach((bar, i) => {
                    const line = lines[i];
                    if (!line || !bar) return;
                    const left = Math.min(bar.x, bar.base), right = Math.max(bar.x, bar.base), y = bar.y;
                    ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
                    // Barra vacía (0%): no se dibuja el "0%" encima, solo Producción/Esperado.
                    if (Math.round(line.oeeShift * 100) > 0) {
                        const label = Math.round(line.oeeShift * 100) + '%';
                        ctx.font = '800 15px "Segoe UI", sans-serif';
                        ctx.lineWidth = 3.5; ctx.strokeStyle = 'rgba(0,0,0,0.55)';
                        ctx.strokeText(label, left + 8, y);
                        ctx.fillStyle = '#ffffff';
                        ctx.fillText(label, left + 8, y);
                    }
                    ctx.font = '700 13px "Cascadia Mono", Consolas, monospace';
                    ctx.fillStyle = getCss('--text-dim');
                    ctx.fillText(`${line.total}/${line.accumulatedRate}`, right + 8, y);
                });
                ctx.restore();
            }
        };

        function lineBarConfig(g) {
            const top = linesPage(g).page;
            return {
                type: 'bar',
                data: {
                    labels: top.map(l => shortName(l.productDesc)),
                    datasets: [{
                        data: top.map(l => l.oeeShift * 100),
                        backgroundColor: top.map(l => oeeColor(l.oeeShift)),
                        borderRadius: 7, maxBarThickness: 26, linesRef: top
                    }]
                },
                plugins: [barLabelsPlugin],
                options: {
                    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                    animation: { duration: 500 },
                    layout: { padding: { right: 84 } },
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.raw.toFixed(0) + '% OEE de turno' } } },
                    scales: {
                        x: { min: 0, suggestedMax: 100, ticks: { display: false }, grid: { color: getCss('--grid-line') } },
                        y: { ticks: { color: getCss('--text-dim'), font: { size: 14, weight: '600' } }, grid: { display: false } }
                    }
                }
            };
        }

        // ---------- cards ----------
        function buildCard(g) {
            const div = document.createElement('div');
            div.className = 'card clickable';
            div.id = 'card-' + g.groupId;
            div.style.setProperty('--gcolor', groupColor(g));
            div.onclick = () => selectGroup(g.groupId);
            div.innerHTML = `
                <div class="card-top">
                    <h2>
                        <span class="gnum">${g.colorIndex + 1}</span><span class="gname">${g.groupName}</span>
                        <a class="detail-link" href="/Group/${g.groupId}${HIST_QS}" onclick="event.stopPropagation()" title="Ver detalle de ${g.groupName}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
                        </a>
                    </h2>
                    <div class="oee-block">
                        <span class="oee-pill" id="pill-${g.groupId}"></span>
                        <span class="oee-caption">OEE de turno</span>
                    </div>
                </div>
                <div class="numbers">
                    <div class="n"><div class="v" id="prod-${g.groupId}"></div><div class="l">Producción</div></div>
                    <div class="n"><div class="v" id="plan-${g.groupId}"></div><div class="l">Plan turno</div></div>
                    <div class="n"><div class="v" id="sap-${g.groupId}"></div><div class="l">SAP %</div></div>
                </div>
                <div class="chart-wrap" id="chartwrap-${g.groupId}"></div>
                <div class="page-ring-wrap" id="pagering-${g.groupId}"></div>
                <div class="worst-line" id="worst-${g.groupId}"></div>`;
            return div;
        }

        function updateCard(g, isLive) {
            const id = g.groupId;
            const card = document.getElementById('card-' + id);
            if (!card) return;
            const hasCounted = countedLines(g).length > 0;
            const prodEl = document.getElementById('prod-' + id);
            const prodChanged = prodEl.textContent !== '' && prodEl.textContent !== fmt(g.totalProduction);

            const pill = document.getElementById('pill-' + id);
            pill.textContent = hasCounted ? pct(g.oee) : '—';
            pill.style.background = hasCounted ? oeeColor(g.oee) : 'var(--neutral)';
            prodEl.textContent = fmt(g.totalProduction);
            document.getElementById('plan-' + id).textContent = fmt(g.totalPlanned);
            document.getElementById('sap-' + id).textContent = hasCounted ? pct(g.sapPercent) : '—';

            const worst = document.getElementById('worst-' + id);
            worst.innerHTML = g.worstLine && hasCounted
                ? `<span>⚠ Línea más baja: ${shortName(g.worstLine.productDesc)}</span><b>${pct(g.worstLine.oeeShift)}</b>` : '';

            const wrap = document.getElementById('chartwrap-' + id);
            const key = 'g' + id;
            const hasCanvas = !!document.getElementById('chart-' + id);

            if (hasCounted && !hasCanvas) {
                wrap.innerHTML = `<canvas id="chart-${id}"></canvas>`;
                charts[key] = new Chart(document.getElementById('chart-' + id), lineBarConfig(g));
                renderPageRing(g);
            } else if (!hasCounted && (hasCanvas || wrap.innerHTML === '')) {
                if (charts[key]) { charts[key].destroy(); delete charts[key]; }
                wrap.innerHTML = `<div class="no-plan-box">SIN PRODUCCIÓN PLANEADA<br>EN ESTE TURNO</div>`;
                document.getElementById('pagering-' + id).innerHTML = '';
            } else if (hasCounted && hasCanvas && charts[key]) {
                charts[key].data = lineBarConfig(g).data;
                charts[key].update('none');
                const label = document.getElementById('pagelabel-' + id);
                if (label) { const p = linesPage(g); label.textContent = p.totalPages > 1 ? `${p.idx + 1}/${p.totalPages}` : ''; }
            }

            if (isLive && prodChanged) { card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash'); }
            if (selectedGroupId === id) renderDrilldown(g);
        }

        // ---------- tendencias (una por grupo) ----------
        function buildTrendCard(g) {
            const div = document.createElement('div');
            div.className = 'card trend-card';
            div.id = 'trend-' + g.groupId;
            div.style.setProperty('--gcolor', groupColor(g));
            div.innerHTML = `<h2><span style="display:flex;align-items:center;gap:10px"><span class="gnum">${g.colorIndex + 1}</span>${g.groupName}</span>
                <span class="hint">Producción por hora · SAP · acumulado vs. esperado</span></h2>
                <div class="chart-wrap"><canvas id="trendchart-${g.groupId}"></canvas></div>`;
            return div;
        }

        function trendData(g) {
            const t = g.hourlyTrend || [];
            let run = 0;
            const color = groupColor(g);
            return {
                labels: t.map(h => h.hour),
                datasets: [
                    { type: 'bar', label: 'Producción / hora', data: t.map(h => h.production), backgroundColor: hexToRgba(color, .6), borderRadius: 6, maxBarThickness: 38, yAxisID: 'y', order: 4 },
                    { type: 'line', label: 'SAP / hora', data: t.map(h => h.sapProduction), borderColor: getCss('--sap'), backgroundColor: getCss('--sap'), tension: .3, pointRadius: 3, borderWidth: 2, yAxisID: 'y', order: 1 },
                    { type: 'line', label: 'Acumulado', data: t.map(h => (run += h.production)), borderColor: getCss('--good'), backgroundColor: hexToRgba(getCss('--good'), .1), fill: true, tension: .3, pointRadius: 3, borderWidth: 2, yAxisID: 'y1', order: 2 },
                    { type: 'line', label: 'Esperado acumulado', data: t.map(h => h.expectedCumulative), borderColor: getCss('--warn'), borderDash: [6, 5], pointRadius: 0, borderWidth: 2, spanGaps: false, yAxisID: 'y1', order: 3 }
                ]
            };
        }

        function trendConfig(g) {
            const tick = { color: getCss('--text-dim'), font: { size: 12 } };
            return {
                type: 'bar',
                data: trendData(g),
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    animation: { duration: 400 },
                    plugins: { legend: { position: 'bottom', labels: { color: getCss('--text-dim'), font: { size: 12, weight: '600' }, boxWidth: 12 } } },
                    scales: {
                        x: { ticks: tick, grid: { color: getCss('--grid-line') } },
                        y: { position: 'left', beginAtZero: true, ticks: tick, grid: { color: getCss('--grid-line') }, title: { display: true, text: 'Piezas / hora', color: getCss('--text-faint'), font: { size: 12 } } },
                        y1: { position: 'right', beginAtZero: true, ticks: tick, grid: { display: false }, title: { display: true, text: 'Acumulado', color: getCss('--text-faint'), font: { size: 12 } } }
                    }
                }
            };
        }

        // ---------- render ----------
        function render(isLive) {
            const oeeEl = document.getElementById('plantOee');
            oeeEl.textContent = pct(snapshot.plantOee);
            oeeEl.style.color = oeeColor(snapshot.plantOee);
            document.getElementById('plantProd').textContent = fmt(snapshot.totalProduction);
            document.getElementById('plantPlanned').textContent = fmt(snapshot.totalPlanned);
            document.getElementById('shiftLabel').textContent = snapshot.shiftDesc || '—';
            document.getElementById('dateLabel').textContent = new Date(snapshot.eventDate).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
            const lu = document.getElementById('lastUpdate');
            if (lu) lu.textContent = new Date(snapshot.generatedAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

            const grid = document.getElementById('grid');
            const trendGrid = document.getElementById('trendGrid');
            if (grid.children.length === 0) {
                snapshot.groups.forEach(g => {
                    grid.appendChild(buildCard(g));
                    trendGrid.appendChild(buildTrendCard(g));
                });
                snapshot.groups.forEach(g => {
                    updateCard(g, false);
                    trendCharts['g' + g.groupId] = new Chart(document.getElementById('trendchart-' + g.groupId), trendConfig(g));
                });
            } else {
                snapshot.groups.forEach(g => {
                    updateCard(g, isLive);
                    const tc = trendCharts['g' + g.groupId];
                    if (tc) { tc.data = trendData(g); tc.update('none'); }
                });
            }
            applySelection();
        }

        // ---------- clic en un grupo: dimea los demás y abre el modal con TODAS sus líneas ----------
        function selectGroup(id) {
            selectedGroupId = selectedGroupId === id ? null : id;
            applySelection();
            const overlay = document.getElementById('drilldownOverlay');
            if (selectedGroupId) {
                renderDrilldown(snapshot.groups.find(x => x.groupId === selectedGroupId));
                overlay.classList.add('open');
            } else {
                overlay.classList.remove('open');
            }
        }
        function applySelection() {
            snapshot.groups.forEach(g => {
                const card = document.getElementById('card-' + g.groupId);
                if (!card) return;
                card.classList.toggle('selected', selectedGroupId === g.groupId);
                card.classList.toggle('dimmed', selectedGroupId !== null && selectedGroupId !== g.groupId);
            });
        }

        function lineRow(l) {
            const name = l.productListId > 0
                ? `<a class="line-link" href="/Line/${l.productListId}${HIST_QS}" title="Ver TV de esta línea">${l.productDesc}</a>` : l.productDesc;
            const sapCell = l.totalSap > 0 ? `${fmt(l.totalSap)}${l.total > 0 ? ' (' + pct(l.totalSap / l.total) + ')' : ''}` : '0';
            // Producción NO planeada (solo con Heijunka): en rojo, no cuenta para nada.
            if (l.isUnplannedProduction) {
                return `<tr class="unplanned-row"><td>${name}</td><td><span class="tag tag-unplanned">PRODUCCIÓN NO PLANEADA</span></td>
                    <td class="num">${fmt(l.total)}</td><td class="num">—</td><td class="num">—</td><td class="num">${sapCell}</td></tr>`;
            }
            if (!l.countsForStats) {
                return `<tr class="noplan-row"><td>${name}</td><td><span class="tag tag-noplan">SIN PLAN</span></td>
                    <td class="num">0</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>`;
            }
            return `<tr><td>${name}</td>
                <td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${Math.min(100, l.oeeShift * 100)}%;background:${oeeColor(l.oeeShift)}"></div></div>
                <span class="mono">${pct(l.oeeShift)}</span></div></td>
                <td class="num">${fmt(l.total)}</td><td class="num">${fmt(l.accumulatedRate)}</td><td class="num">${fmt(l.plannedShift)}</td><td class="num">${sapCell}</td></tr>`;
        }

        function renderDrilldown(g) {
            if (!g) return;
            document.getElementById('drilldownTitle').innerHTML =
                `<span class="gnum" style="--gcolor:${groupColor(g)}">${g.colorIndex + 1}</span> ${g.groupName}`;
            if (g.lines.length === 0) {
                document.getElementById('drilldownChips').innerHTML = `<span class="chip">Sin líneas en este turno</span>`;
                document.getElementById('drilldownBody').innerHTML = '';
                return;
            }
            document.getElementById('drilldownChips').innerHTML =
                `<span class="chip">Producción: ${fmt(g.totalProduction)}</span><span class="chip">Plan: ${fmt(g.totalPlanned)}</span>
                 <span class="chip">OEE: ${pct(g.oee)}</span><span class="chip">SAP: ${pct(g.sapPercent)}</span><span class="chip">${g.lines.length} líneas</span>`;
            document.getElementById('drilldownBody').innerHTML = [...g.lines].sort((a, b) => a.productOrder - b.productOrder).map(lineRow).join('');
        }

        document.getElementById('closeDrilldown').onclick = () => selectGroup(selectedGroupId);
        document.getElementById('drilldownOverlay').onclick = e => { if (e.target.id === 'drilldownOverlay') selectGroup(selectedGroupId); };

        // ---------- pantallas (solo manual: flechas fantasma o teclado) ----------
        function goScreen(n) {
            currentScreen = n;
            document.getElementById('track').style.transform = `translateX(${n * -50}%)`;
            document.getElementById('goTrends').classList.toggle('show', n === 0);
            document.getElementById('goGrid').classList.toggle('show', n === 1);
            setTimeout(resizeAll, 600);
        }
        function resizeAll() {
            Object.values(charts).forEach(c => c && c.resize());
            Object.values(trendCharts).forEach(c => c && c.resize());
        }
        document.getElementById('goTrends').onclick = () => goScreen(1);
        document.getElementById('goGrid').onclick = () => goScreen(0);
        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowRight') goScreen(1);
            if (e.key === 'ArrowLeft') goScreen(0);
            if (e.key === 'Escape' && selectedGroupId) selectGroup(selectedGroupId);
        });

        // ---------- tema / presentación / histórico ----------
        document.getElementById('toggleTheme').onclick = () => {
            const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('pm-theme', next); } catch (e) { }
            Object.values(charts).forEach(c => c && c.destroy());
            Object.values(trendCharts).forEach(c => c && c.destroy());
            for (const k in charts) delete charts[k];
            for (const k in trendCharts) delete trendCharts[k];
            document.getElementById('grid').innerHTML = '';
            document.getElementById('trendGrid').innerHTML = '';
            render(false);
        };
        document.getElementById('togglePresentation').onclick = () => {
            document.getElementById('app').classList.toggle('presentation');
            if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => { });
            else document.exitFullscreen?.().catch(() => { });
            setTimeout(resizeAll, 300);
        };
        const dateInput = document.getElementById('dateInput');
        const shiftSelect = document.getElementById('shiftSelect');
        if (dateInput) dateInput.onchange = () => { if (dateInput.value) location.href = `/Historical?date=${dateInput.value}`; };
        if (shiftSelect) shiftSelect.onchange = () => { location.href = `/Historical?date=${dateInput.value}&shiftId=${shiftSelect.value}`; };

        // ---------- carrusel de líneas dentro de cada card (cada 15 s, como pantalla de aeropuerto) ----------
        setInterval(() => {
            snapshot.groups.forEach(g => {
                const { totalPages } = linesPage(g);
                if (totalPages <= 1) return;
                groupPage[g.groupId] = ((groupPage[g.groupId] || 0) + 1) % totalPages;
                const chart = charts['g' + g.groupId];
                if (chart) { chart.data = lineBarConfig(g).data; chart.update('none'); }
                renderPageRing(g);
            });
        }, PAGE_ROTATE_MS);

        // ---------- SignalR (solo en vivo) ----------
        if (!IS_HIST) {
            const connection = new signalR.HubConnectionBuilder().withUrl('/hubs/metrics').withAutomaticReconnect().build();
            connection.on('SnapshotUpdated', s => { snapshot = s; render(true); });
            connection.start().catch(err => console.error('SignalR error:', err));
        }

        render(false);
    </script>
</body>
</html>
